    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"# 10.3 Traditional Portfolio Optimization (Max Sharpe & Min Volatility)\\\\n\\\",\\n\",\n",
    "    \"    \\\"print('\\\\\\\\n' + '=' * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"print('10.3 TRADITIONAL PORTFOLIO OPTIMIZATION')\\\\n\\\",\\n\",\n",
    "    \"    \\\"print('=' * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
