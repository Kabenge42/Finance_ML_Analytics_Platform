    "                       labels={'value': 'Residual', 'count': 'Frequency'})\n",
    "    fig.add_vline(x=0, line_dash='dash', line_color='red')\n",
    "    fig.show()\n",
    "\n",
    "    print('✓ Regression model visualizations complete')\n"
