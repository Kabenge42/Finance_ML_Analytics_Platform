    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Add classification probability features if available in all_stocks_phase95\\\\n\\\",\\n\",\n",
    "    \"    \\\"        prob_cols_all = [c for c in all_stocks_phase95.columns if c.startswith('event_prob_')]\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if len(prob_cols_all) >= 5:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Prefer standard names if present\\\\n\\\",\\n\",\n",
    "    \"    \\\"            std_cols = [\\\\\\\"event_prob_strong_negative\\\\\\\", \\\\\\\"event_prob_negative\\\\\\\", \\\\\\\"event_prob_neutral\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        \\\\\\\"event_prob_positive\\\\\\\", \\\\\\\"event_prob_strong_positive\\\\\\\"]\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if all(c in all_stocks_phase95.columns for c in std_cols):\\\\n\\\",\\n\",\n",
    "    \"    \\\"                prob_cols_all = std_cols\\\\n\\\",\\n\",\n",
    "    \"    \\\"            else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                prob_cols_all = sorted(prob_cols_all)[:5]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            all_probs = all_stocks_phase95[prob_cols_all].values\\\\n\\\",\\n\",\n",
    "    \"    \\\"            X_all_stocks_for_prediction = integrate_classification_features(X_all_stocks_for_prediction, all_probs)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"  ✓ Added classification probability features\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Identify classification probability columns currently in X_all_stocks\\\\n\\\",\\n\",\n",
    "    \"    \\\"        cls_cols_all = [c for c in X_all_stocks_for_prediction.columns if\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        c.startswith('event_prob_') or c == 'event_confidence']\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
