    "    \"   \\\"cell_type\\\": \\\"code\\\",\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"# Extract schema-based column lists for preprocessing\\\\n\\\",\\n\",\n",
    "    \"    \\\"from finance_ml.ml_workflow.data.schema import list_categorical_cols, list_date_cols\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"categorical_columns_from_schema = list_categorical_cols()\\\\n\\\",\\n\",\n",
