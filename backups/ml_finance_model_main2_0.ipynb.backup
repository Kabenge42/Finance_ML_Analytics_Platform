    "print(\n",
    "        f\"    Strong Negative (0): {(event_labels == 0).sum()} ({(event_labels == 0).sum() / len(event_labels) * 100:.1f}%)\")\n",
    "print(f\"    Negative (1): {(event_labels == 1).sum()} ({(event_labels == 1).sum() / len(event_labels) * 100:.1f}%)\")\n",
