    "# 2. Prepare All Data for Prediction\n",
    "print(\"\\n[INFO] Preprocessing all_stocks_features for prediction...\")\n",
    "prep_params = {\n",
    "    'cat_cols': categorical_columns_from_schema,\n",
    "    'date_cols': datetime_cols_from_schema,\n",
