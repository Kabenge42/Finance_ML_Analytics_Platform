    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Load synthetic historical data\\\\n\\\",\\n\",\n",
    "    \"    \\\"historical_prices = load_historical_prices(n_obs=756, n_assets=4, seed=123)\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Convert to DataFrame with column names for compatibility with backtest_and_attribution\\\\n\\\",\\n\",\n",
    "    \"    \\\"historical_prices = pd.DataFrame(\\\\n\\\",\\n\",\n",
    "    \"    \\\"        historical_prices,\\\\n\\\",\\n\",\n",
