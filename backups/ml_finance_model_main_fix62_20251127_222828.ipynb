    "    \"    \\\"            mc_min = mc.min()\\\\n\\\",\\n\",\n",
    "    \"    \\\"            mc_max = mc.max()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Detect scale based on data characteristics\\\\n\\\",\\n\",\n",
