    "print(\"  Creating valuation scatter plot...\")\n",
    "if all(col in all_stocks_phase95.columns for col in ['last_price', 'price_target', 'predicted_price_target', 'sector']):\n",
    "    plot_data = all_stocks_phase95[\n",
