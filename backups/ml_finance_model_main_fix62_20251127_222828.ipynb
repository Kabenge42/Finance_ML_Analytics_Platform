    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Monte Carlo Simulation\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f'\\\\\\\\n📊 Monte Carlo Simulation (2000 paths, 252 days):')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    mc_results = run_monte_carlo_simulation(\\\\n\\\",\\n\",\n",
