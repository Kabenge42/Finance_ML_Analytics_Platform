    "    \"   \\\"cell_type\\\": \\\"markdown\\\",\\n\",\n",
    "    \"   \\\"source\\\": \\\"### 6.5.1 Time-Series Cross-Validation (Priority 4.1)\\\\n\\\",\\n\",\n",
    "    \"   \\\"id\\\": \\\"41fd509aec3b4611\\\"\\n\",\n",
    "    \"  },\\n\",\n",
    "    \"  {\\n\",\n",
    "    \"   \\\"metadata\\\": {\\n\",\n",
    "    \"    \\\"ExecuteTime\\\": {\\n\",\n",
    "    \"     \\\"end_time\\\": \\\"2025-11-27T20:56:22.268460Z\\\",\\n\",\n",
    "    \"     \\\"start_time\\\": \\\"2025-11-27T20:56:22.219737Z\\\"\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"   },\\n\",\n",
    "    \"   \\\"cell_type\\\": \\\"code\\\",\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"# 6.5.1 — Time-Series Cross-Validation (5 folds)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"DATE_COLUMN_CANDIDATES = [\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"date\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"as_of_date\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"last_updated\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"income_statement_report_date\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    ]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"def find_date_column(df: pd.DataFrame, candidates: list[str]) -> str | None:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\"\\\\\\\"Return the first existing date-like column from the given candidates, or None.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for candidate in candidates:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if candidate in df.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            return candidate\\\\n\\\",\\n\",\n",
    "    \"    \\\"    return None\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"def run_time_series_cv(\\\\n\\\",\\n\",\n",
    "    \"    \\\"        df: pd.DataFrame,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        target_col: str,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        feature_cols: list[str],\\\\n\\\",\\n\",\n",
    "    \"    \\\"        output_dir: Path,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        cv_folds: int,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        ) -> None:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\"\\\\\\\"Run time-series cross-validation and persist fold-level metrics.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    date_col = find_date_column(df, DATE_COLUMN_CANDIDATES)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if date_col is None:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(\\\\\\\"[WARN] No date column found; skipping Time-Series CV\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        return\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Ensure datetime type and sort chronologically\\\\n\\\",\\n\",\n",
    "    \"    \\\"    df_cv = df.copy()\\\\n\\\",\\n\",\n",
    "    \"    \\\"    df_cv[date_col] = pd.to_datetime(df_cv[date_col], errors=\\\\\\\"coerce\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    df_cv = df_cv.sort_values(date_col).dropna(subset=[target_col])\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    X_cv = df_cv[feature_cols].fillna(0)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    y_cv = df_cv[target_col]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    tscv = TimeSeriesSplit(n_splits=cv_folds)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    metrics_rows: list[dict[str, float]] = []\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fold_index = 0\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for train_idx, test_idx in tscv.split(X_cv):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        fold_index += 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        X_tr, X_te = X_cv.iloc[train_idx], X_cv.iloc[test_idx]\\\\n\\\",\\n\",\n",
    "    \"    \\\"        y_tr, y_te = y_cv.iloc[train_idx], y_cv.iloc[test_idx]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Train a lightweight stacking model per fold (reuse robust settings)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        fold_result = regression_train_stacking(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                X_tr,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                winsorize_target(y_tr, 0.01, 0.99),\\\\n\\\",\\n\",\n",
    "    \"    \\\"                cv=3,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                ensure_nonnegative=False,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                loss=\\\\\\\"huber\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"                )\\\\n\\\",\\n\",\n",
    "    \"    \\\"        fold_model = fold_result[\\\\\\\"model\\\\\\\"]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Apply adaptive clipping with percentile-based bounds\\\\n\\\",\\n\",\n",
    "    \"    \\\"        fold_pred = fold_model.predict(X_te)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        clip_result_fold = adaptive_clip_predictions(fold_pred, y_tr)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        y_hat = clip_result_fold[\\\\\\\"clipped_predictions\\\\\\\"]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Optional: log clipping stats for first fold\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if fold_index == 1:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    \\\\\\\"  Fold 1 clipping bounds: \\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f\\\\\\\"lower=${clip_result_fold['lower_bound']:.2f}, \\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f\\\\\\\"upper=${clip_result_fold['upper_bound']:.2f}\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        mae = mean_absolute_error(y_te, y_hat)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        rmse = np.sqrt(mean_squared_error(y_te, y_hat))\\\\n\\\",\\n\",\n",
    "    \"    \\\"        r2 = r2_score(y_te, y_hat)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        metrics_rows.append(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                {\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    \\\\\\\"fold\\\\\\\": fold_index,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    \\\\\\\"mae\\\\\\\": mae,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    \\\\\\\"rmse\\\\\\\": rmse,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    \\\\\\\"r2\\\\\\\": r2,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    \\\\\\\"n_test\\\\\\\": len(y_te),\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    }\\\\n\\\",\\n\",\n",
    "    \"    \\\"                )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    tscv_df = pd.DataFrame(metrics_rows)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    eval_dir = output_dir / \\\\\\\"evaluation\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    eval_dir.mkdir(parents=True, exist_ok=True)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    tscv_path = eval_dir / \\\\\\\"tscv_metrics.csv\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    tscv_df.to_csv(tscv_path, index=False)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"[OK] Saved Time-Series CV metrics to {tscv_path}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(tscv_df.describe().loc[[\\\\\\\"mean\\\\\\\", \\\\\\\"std\\\\\\\"]])\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"\\\\\\\\n\\\\\\\" + \\\\\\\"=\\\\\\\" * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"6.5.1 — Time-Series Cross-Validation (5 folds)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"=\\\\\\\" * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"try:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    run_time_series_cv(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            df=all_stocks_enhanced,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            target_col=target_col,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            feature_cols=list(X_train.columns),\\\\n\\\",\\n\",\n",
    "    \"    \\\"            output_dir=OUTPUT_DIR,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            cv_folds=CV_FOLDS,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
