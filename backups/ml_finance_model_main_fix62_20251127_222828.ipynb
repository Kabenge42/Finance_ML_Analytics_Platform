    "    \"    \\\"            print(f\\\\\\\"  ✓ Added interaction features\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Final alignment: Ensure exact column order and fill any remaining gaps with 0\\\\n\\\",\\n\",\n",
