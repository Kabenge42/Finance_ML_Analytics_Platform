    {
      "title": "Configuration & Setup (Validation-friendly)",
      "text": "%python\n# ============================================================================\n# SECTION: Configuration & Setup\n# ============================================================================\n\nimport os\nimport warnings\nfrom datetime import date\nfrom pathlib import Path\n\nwarnings.filterwarnings('ignore')\n\n# ---------------------------------------------------------------------------\n# Configuration constants (align with docs/code_guidelines.md Section 8.1)\n# ---------------------------------------------------------------------------\nTARGET_COL = 'price_target'\nTARGET_COL_FALLBACK = 'last_price'\nTEST_SIZE = 0.2\nTRAIN_SIZE = 1 - TEST_SIZE\nCV_FOLDS = 5\n\nRANDOM_SEED = int(os.getenv('RANDOM_SEED', '42'))\nMODEL_VERSION = os.getenv('MODEL_VERSION', 'v9_10')\nDATE_DISPLAY_FORMAT = '%Y-%m-%d'\n\nPROJECT_ROOT = Path.cwd()\nOUTPUT_DIR = PROJECT_ROOT / 'outputs'\nOUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n\n# Canonical schema utilities (single source of truth)\nfrom finance_ml.core.schema import normalize_column_name\n\nprint('ETL Data Explorer - Configuration')\nprint(f'Model Version: {MODEL_VERSION}')\nprint(f'Reference Date: {date.today().strftime(DATE_DISPLAY_FORMAT)}')\n",
      "user": "anonymous",
      "dateCreated": "2026-01-10T17:00:10.000Z",
      "dateUpdated": "2026-01-10T17:00:10.000Z",
      "config": {
        "colWidth": 12,
        "enabled": true,
        "results": {},
        "editorMode": "ace/mode/python"
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "apps": [],
      "status": "READY"
    },
    {
      "title": "Data Loading & Validation",
      "text": "%python\n# ============================================================================\n# SECTION: Data Loading & Validation\n# ============================================================================\n\nimport pandas as pd\n\n# Prefer the unified ETL entry point. If you want to only load (no transform),\n# use run_etl_pipeline with an appropriate config.\nfrom finance_ml.etl import run_etl_pipeline, ETLConfig\n\n# A minimal, notebook-friendly config. Adjust source/table as needed.\netl_config = ETLConfig()\n\n# Example:\n# df_raw, metrics = run_etl_pipeline(source='database', config=etl_config)\n\n# Validation helpers (kept lightweight; heavy validation lives in finance_ml)\ndef validate_non_empty(df: pd.DataFrame) -> None:\n    assert df is not None, 'DataFrame must not be None'\n    assert len(df) > 0, 'DataFrame must not be empty'\n\nprint('Ready for data loading. Configure DB_URL env var if using database source.')\n",
      "user": "anonymous",
      "dateCreated": "2026-01-10T17:00:20.000Z",
      "dateUpdated": "2026-01-10T17:00:20.000Z",
      "config": {
