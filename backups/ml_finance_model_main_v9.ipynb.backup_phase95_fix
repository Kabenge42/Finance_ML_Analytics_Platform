    "        plt.gca().invert_yaxis()  # Highest importance at top\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "        # Summary statistics\n",
    "        print(f\"\\n📊 Feature Importance Statistics:\")\n",
    "        print(f\"   Mean importance: {importance_df['importance'].mean():.4f}\")\n",
