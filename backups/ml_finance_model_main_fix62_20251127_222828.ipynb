    "    \"    \\\"    logger.info(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            f'Starting advanced portfolio optimization with '\\\\n\\\",\\n\",\n",
    "    \"    \\\"            f'{len(portfolio_candidates)} candidates'\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Use top 50 for optimization to keep it manageable\\\\n\\\",\\n\",\n",
    "    \"    \\\"    opt_universe = portfolio_candidates.head(50)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    logger.info(f'Selected top {len(opt_universe)} stocks for advanced optimization')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Prepare returns and covariance\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if 'expected_return' in opt_universe.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        mean_returns_raw = (\\\\n\\\",\\n\",\n",
    "    \"    \\\"            opt_universe\\\\n\\\",\\n\",\n",
    "    \"    \\\"            .set_index('ticker')['expected_return']\\\\n\\\",\\n\",\n",
    "    \"    \\\"            .fillna(DEFAULT_EXPECTED_RETURN)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"        logger.info('Using expected_return column for advanced optimization')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        mean_returns_raw = pd.Series(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                DEFAULT_EXPECTED_RETURN,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                index=opt_universe['ticker'],\\\\n\\\",\\n\",\n",
    "    \"    \\\"                name='expected_return',\\\\n\\\",\\n\",\n",
    "    \"    \\\"                )\\\\n\\\",\\n\",\n",
    "    \"    \\\"        logger.warning(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                f'No expected_return column, using default '\\\\n\\\",\\n\",\n",
    "    \"    \\\"                f'{DEFAULT_EXPECTED_RETURN:.1%}'\\\\n\\\",\\n\",\n",
    "    \"    \\\"                )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # ========== Phase 7.1: Clip Returns for Advanced Optimization ==========\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print('\\\\\\\\n📊 Phase 7.1: Return Clipping for Advanced Optimization')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    mean_returns_clipped = clip_expected_returns(mean_returns_raw.values)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    mean_returns = pd.Series(mean_returns_clipped, index=mean_returns_raw.index, name='expected_return')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f'  Clipped {len(mean_returns)} returns to [{MIN_EXPECTED_RETURN:.0%}, {MAX_EXPECTED_RETURN:.0%}]')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f'  Mean after clipping: {mean_returns.mean():.2%}')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    logger.info(f'Phase 7.1: Advanced optimization returns clipped')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # ========== Phase 7.7: Shrinkage Covariance for Advanced Optimization ==========\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print('\\\\\\\\n📊 Phase 7.7: Shrinkage Covariance for Advanced Optimization')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    np.random.seed(42)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    n_adv_stocks = len(opt_universe)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Generate synthetic daily returns for covariance estimation\\\\n\\\",\\n\",\n",
    "    \"    \\\"    synthetic_adv_returns = pd.DataFrame(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            np.random.randn(252, n_adv_stocks) * 0.02 + mean_returns.values / 252,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            columns=opt_universe['ticker'].values\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Use Ledoit-Wolf shrinkage covariance\\\\n\\\",\\n\",\n",
    "    \"    \\\"    cov_matrix = estimate_covariance_shrinkage(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            returns=synthetic_adv_returns,\\\\n\\\",\\n\",\n",
