   "source": [
    "### 6.3.1 Linear Models Comparison\n",
    "Compare linear regression models for baseline performance and interpretability."
   ],
   "id": "3055a5992a153e91"
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-12-07T16:53:44.158410Z",
     "start_time": "2025-12-07T03:09:06.568462Z"
    }
   },
   "cell_type": "code",
   "source": [
    "# ============================================================================\n",
    "# PHASE 9.5: Linear Models Comparison\n",
    "# ============================================================================\n",
    "print(\"=\" * 80)\n",
    "print(\"PHASE 9.5: LINEAR MODELS COMPARISON\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Ensure we have the regression-ready data\n",
    "if 'X_train' not in dir() or 'y_train' not in dir():\n",
    "    print(\"⚠️  Training data not prepared. Run Section 6.2 first.\")\n",
    "else:\n",
    "    from finance_ml.ml_workflow.regression.models import (\n",
    "        train_ridge_regressor,\n",
    "        train_lasso_regressor,\n",
    "        train_elastic_net_regressor,\n",
    "        train_bayesian_ridge_regressor,\n",
    "        )\n",
    "\n",
    "    linear_results = {}\n",
    "\n",
    "\n",
    "    def get_metric(result, metric_name='r2_score', default=0.0):\n",
    "        \"\"\"Safely extract a metric from model results.\n",
    "\n",
    "        Handles results as:\n",
    "        - tuple: (model, metrics_dict)\n",
    "        - dict: metrics dict\n",
    "        - other: returns default\n",
    "\n",
    "        Maps common metric aliases so callers can always request 'r2_score'.\n",
    "        \"\"\"\n",
    "        # If result is a (model, metrics) tuple\n",
    "        if isinstance(result, (tuple, list)):\n",
    "            if len(result) == 2:\n",
    "                model, metrics = result\n",
    "                if isinstance(metrics, dict):\n",
    "                    key_mapping = {\n",
    "                        'r2_score': ['r2_score', 'train_score', 'test_score'],\n",
    "                        'mae': ['mae', 'mean_absolute_error'],\n",
    "                        'rmse': ['rmse', 'root_mean_squared_error'],\n",
    "                        }\n",
    "                    for key in key_mapping.get(metric_name, [metric_name]):\n",
    "                        if key in metrics and isinstance(metrics[key], (int, float)):\n",
    "                            return float(metrics[key])\n",
    "                    # If key exists but not numeric, fallback\n",
    "                    for key in key_mapping.get(metric_name, [metric_name]):\n",
    "                        if key in metrics:\n",
    "                            try:\n",
    "                                return float(metrics[key])\n",
    "                            except Exception:\n",
    "                                return default\n",
    "                return default\n",
    "            # Unexpected tuple/list length, fallback\n",
    "            return default\n",
    "\n",
    "        # If result is a plain dict of metrics\n",
    "        if isinstance(result, dict):\n",
    "            # Try mapped keys\n",
    "            key_mapping = {\n",
    "                'r2_score': ['r2_score', 'train_score', 'test_score'],\n",
    "                'mae': ['mae', 'mean_absolute_error'],\n",
    "                'rmse': ['rmse', 'root_mean_squared_error'],\n",
    "                }\n",
    "            for key in key_mapping.get(metric_name, [metric_name]):\n",
    "                if key in result and isinstance(result[key], (int, float)):\n",
    "                    return float(result[key])\n",
    "            for key in key_mapping.get(metric_name, [metric_name]):\n",
    "                if key in result:\n",
    "                    try:\n",
    "                        return float(result[key])\n",
    "                    except Exception:\n",
    "                        return default\n",
    "            return default\n",
    "\n",
    "        # Any other type (e.g., model object) → use default\n",
    "        return default\n",
    "\n",
    "\n",
    "    # 1. Ridge Regression\n",
    "    print(\"\\n📊 Training Ridge Regressor...\")\n",
    "    try:\n",
    "        ridge_result = train_ridge_regressor(X_train, y_train, alpha=1.0, cv=CV_FOLDS)\n",
    "        linear_results['Ridge'] = ridge_result\n",
    "        score = get_metric(ridge_result, 'r2_score')\n",
    "        print(f\"   R² Score: {score:.4f}\")\n",
    "    except Exception as e:\n",
    "        print(f\"   ⚠️ Ridge failed: {e}\")\n",
    "\n",
    "    # 2. Lasso Regression\n",
    "    print(\"\\n📊 Training Lasso Regressor...\")\n",
    "    try:\n",
    "        lasso_result = train_lasso_regressor(X_train, y_train, alpha=0.1, cv=CV_FOLDS)\n",
    "        linear_results['Lasso'] = lasso_result\n",
    "        score = get_metric(lasso_result, 'r2_score')\n",
    "        print(f\"   R² Score: {score:.4f}\")\n",
    "    except Exception as e:\n",
    "        print(f\"   ⚠️ Lasso failed: {e}\")\n",
    "\n",
    "    # 3. ElasticNet Regression\n",
    "    print(\"\\n📊 Training ElasticNet Regressor...\")\n",
    "    try:\n",
    "        elastic_result = train_elastic_net_regressor(X_train, y_train, alpha=0.1, l1_ratio=0.5, cv=CV_FOLDS)\n",
    "        linear_results['ElasticNet'] = elastic_result\n",
    "        score = get_metric(elastic_result, 'r2_score')\n",
    "        print(f\"   R² Score: {score:.4f}\")\n",
    "    except Exception as e:\n",
    "        print(f\"   ⚠️ ElasticNet failed: {e}\")\n",
    "\n",
    "    # 4. Bayesian Ridge\n",
    "    print(\"\\n📊 Training Bayesian Ridge Regressor...\")\n",
    "    try:\n",
    "        bayesian_result = train_bayesian_ridge_regressor(X_train, y_train)\n",
    "        linear_results['BayesianRidge'] = bayesian_result\n",
    "        score = get_metric(bayesian_result, 'r2_score')\n",
    "        print(f\"   R² Score: {score:.4f}\")\n",
    "    except Exception as e:\n",
    "        print(f\"   ⚠️ BayesianRidge failed: {e}\")\n",
    "\n",
    "    # Summary\n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(\"LINEAR MODELS SUMMARY\")\n",
    "    print(\"=\" * 60)\n",
    "    for name, result in linear_results.items():\n",
    "        score = get_metric(result, 'r2_score')\n",
    "        try:\n",
    "            print(f\"  {name:15s}: R² = {score:.4f}\")\n",
    "        except Exception:\n",
    "            # Fallback without formatting in case of non-numeric types slipping through\n",
    "            print(f\"  {name:15s}: R² = {score}\")\n",
    "\n",
    "    print(\"\\n✓ Linear models comparison complete\")\n"
   ],
   "id": "76104ff6ea23c09f",
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "================================================================================\n",
      "PHASE 9.5: GRADIENT BOOSTING MODELS COMPARISON\n",
      "================================================================================\n",
      "\n",
      "🚀 Training XGBoost Regressor...\n",
      "   R² Score: 1.0000\n",
      "\n",
      "🚀 Training LightGBM Regressor...\n",
      "   R² Score: 0.9767\n",
