    "\n",
    "\n",
    "def checkpoint(name: str, requires: list = None):\n",
    "    \"\"\"Mark a checkpoint and validate dependencies.\"\"\"\n",
    "    if requires:\n",
    "        missing = [r for r in requires if not _CHECKPOINTS.get(r, False)]\n",
