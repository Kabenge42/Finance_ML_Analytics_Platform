[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# ============================================================================
# Core Dependencies (aligned with pyproject.toml v0.9.5)
# Updated: 2026-01-12
# ============================================================================

# --- Numerical Computing & Data Structures ---
numpy = { version = ">=1.26.0,<2.0.0", markers = "python_version < '3.14'" }
pandas = ">=2.2.0,<3.0.0"
scipy = ">=1.14.0,<2.0.0"
statsmodels = ">=0.14.0,<1.0.0"

# --- Machine Learning: Core Frameworks ---
scikit-learn = ">=1.6.0,<2.0.0"
imbalanced-learn = ">=0.12.0,<1.0.0"

# --- Machine Learning: Gradient Boosting ---
xgboost = ">=2.1.0,<4.0.0"
lightgbm = ">=4.5.0,<5.0.0"
catboost = { version = ">=1.2.5,<2.0.0", markers = "python_version < '3.14'" }

# --- Model Interpretability ---
shap = { version = ">=0.50.0,<1.0.0", markers = "python_version < '3.14'" }

# --- Data Visualization ---
matplotlib = ">=3.9.0,<4.0.0"
seaborn = ">=0.13.0,<1.0.0"
plotly = ">=5.18.0,<7.0.0"

# --- Utilities & Performance ---
tqdm = ">=4.66.0,<5.0.0"
joblib = ">=1.4.0,<2.0.0"
xlsxwriter = ">=3.2.0,<4.0.0"
psutil = ">=6.0.0,<7.0.0"

# --- Hyperparameter Optimization ---
optuna = ">=4.1.0,<5.0.0"

# ============================================================================
# Optional: Database Connectivity
# ============================================================================
psycopg2-binary = ">=2.9.9,<3.0.0"
SQLAlchemy = ">=2.0.25,<3.0.0"
openpyxl = ">=3.1.0,<4.0.0"

# ============================================================================
# Optional: Advanced Feature Selection
# ============================================================================
boruta = ">=0.3.0,<1.0.0"

# ============================================================================
# Optional: Interactive Dashboards
# ============================================================================
streamlit = { version = ">=1.40.0,<2.0.0", markers = "python_version < '3.14'" }
dash = ">=2.18.0,<3.0.0"

# ============================================================================
# Optional: Jupyter Notebook Support
# ============================================================================
jupyter = ">=1.0.0,<2.0.0"
notebook = ">=7.2.0,<8.0.0"
ipykernel = ">=6.29.0,<7.0.0"

# ============================================================================
# Optional: Deep Learning (Python <3.14 only)
# ============================================================================
tensorflow = { version = ">=2.15.0,<3.0.0", markers = "python_version < '3.14'" }
scikeras = { version = ">=0.13.0,<1.0.0", markers = "python_version < '3.14'" }

# ============================================================================
# Project-Specific Extras
# ============================================================================
numba = { version = ">=0.60.0,<1.0.0", markers = "python_version < '3.14'" }
Pillow = ">=10.4.0,<12.0.0"

[dev-packages]
pytest = ">=8.3.0,<9.0.0"
pytest-cov = ">=5.0.0,<6.0.0"
black = ">=24.0.0,<26.0.0"
flake8 = ">=7.1.0,<8.0.0"
mypy = ">=1.11.0,<2.0.0"
isort = ">=5.13.0,<6.0.0"
pip-tools = ">=7.4.0,<8.0.0"

[requires]
python_version = "3.14"