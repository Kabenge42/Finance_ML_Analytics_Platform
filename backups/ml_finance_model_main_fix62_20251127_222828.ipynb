    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Compute correlation matrix between category scores\\\\n\\\",\\n\",\n",
    "    \"    \\\"if category_sector_scores:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Create category score matrix (stocks × categories)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    category_score_matrix = pd.DataFrame()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for category_name, category_metrics in category_mapping.items():\\\\n\\\",\\n\",\n",
    "    \"    \\\"        available_in_category = [m for m in category_metrics if m in all_stocks_scaled.columns]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if len(available_in_category) == 0:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            continue\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Compute z-scores for available metrics and average to get category score\\\\n\\\",\\n\",\n",
    "    \"    \\\"        category_data = all_stocks_scaled[available_in_category].copy()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Convert to numeric\\\\n\\\",\\n\",\n",
    "    \"    \\\"        for col in available_in_category:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            category_data[col] = pd.to_numeric(category_data[col], errors='coerce')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Compute z-scores and average\\\\n\\\",\\n\",\n",
    "    \"    \\\"        z_scored_data = category_data.apply(lambda x: zscore(x, nan_policy='omit'))\\\\n\\\",\\n\",\n",
    "    \"    \\\"        category_score_matrix[category_name] = z_scored_data.mean(axis=1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Compute correlation matrix\\\\n\\\",\\n\",\n",
    "    \"    \\\"    category_corr = category_score_matrix.corr()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Create interactive heatmap for category correlations with value annotations\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Following code_guidelines.md Section 17.1: Heatmaps and Conditional Formatting\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_corr_network = px.imshow(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            category_corr,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            labels=dict(x=\\\\\\\"Category\\\\\\\", y=\\\\\\\"Category\\\\\\\", color=\\\\\\\"Correlation\\\\\\\"),\\\\n\\\",\\n\",\n",
    "    \"    \\\"            title=\\\\\\\"Inter-Category Correlation Matrix (Phase 9.3)\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"            color_continuous_scale=\\\\\\\"RdBu_r\\\\\\\",  # Diverging scale for correlation (-1 to +1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            aspect=\\\\\\\"auto\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"            zmin=-1,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            zmax=1,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            text_auto=\\\\\\\".3f\\\\\\\"  # ✅ Display correlation values formatted to 3 decimals (Section 17.1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Enhanced styling per Section 17.1 style guidelines\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_corr_network.update_traces(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            textfont=dict(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    size=10,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    color='white',  # High contrast on diverging color scale\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    family='Arial'  # Standard sans-serif font (Section 17.4)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_corr_network.update_layout(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            height=700,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            xaxis_tickangle=-45,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            font=dict(size=9, family=\\\\\\\"Arial\\\\\\\"),\\\\n\\\",\\n\",\n",
    "    \"    \\\"            template=\\\\\\\"plotly_dark\\\\\\\"  # ✅ Dark mode compatible theme (Section 17.1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_corr_network.show()\\\\n\\\",\\n\",\n",
    "    \"    \\\"    output_path = eda_output_dir / \\\\\\\"phase93_category_correlation_network.html\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_corr_network.write_html(output_path)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"\\\\\\\\n✓ Category correlation network complete\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  Categories analyzed: {len(category_corr)}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  Output: {output_path}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Find strongest positive and negative correlations\\\\n\\\",\\n\",\n",
    "    \"    \\\"    corr_pairs = []\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for i in range(len(category_corr.columns)):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        for j in range(i + 1, len(category_corr.columns)):\\\\n\\\",\\n\",\n",
    "    \"    \\\"            cat1 = category_corr.columns[i]\\\\n\\\",\\n\",\n",
    "    \"    \\\"            cat2 = category_corr.columns[j]\\\\n\\\",\\n\",\n",
    "    \"    \\\"            corr_val = category_corr.iloc[i, j]\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if not np.isnan(corr_val):\\\\n\\\",\\n\",\n",
    "    \"    \\\"                corr_pairs.append((cat1, cat2, corr_val))\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Sort by absolute correlation\\\\n\\\",\\n\",\n",
    "    \"    \\\"    corr_pairs.sort(key=lambda x: abs(x[2]), reverse=True)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"\\\\\\\\n  🔗 Strongest Category Relationships:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for cat1, cat2, corr in corr_pairs[:5]:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"    {cat1} ↔ {cat2}: {corr:.2f}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(\\\\\\\"  ⚠️ No category data available for correlation analysis\\\\\\\")\\\\n\\\"\\n\",\n",
    "    \"   ],\\n\",\n",
