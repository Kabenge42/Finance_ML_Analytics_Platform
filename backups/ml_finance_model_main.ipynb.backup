    "except Exception as e:\n",
    "    print(f\"❌ Model comparison failed: {str(e)}\")\n",
    "    print(f\"   Using optimized model from hyperparameter search instead\")\n",
    "    models_results = {}\n",
    "    # ALWAYS define cls_model even on failure\n",
    "    cls_model = result['model']\n",
