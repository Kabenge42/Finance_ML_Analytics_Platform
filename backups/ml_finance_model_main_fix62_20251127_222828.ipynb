    "    \"    \\\"    print(f\\\\\\\"  Output: {output_path}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Display top performing sector per category\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"\\\\\\\\n  🏆 Top Performing Sectors by Category:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for category, scores in list(category_sector_scores.items())[:5]:\\\\n\\\",\\n\",\n",
