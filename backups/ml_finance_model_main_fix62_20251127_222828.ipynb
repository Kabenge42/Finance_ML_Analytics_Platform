    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"# 6.4.1 — Export Enhanced Predictions and Sector Metrics (Priority 1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Using build_predictions_frame from finance_ml.ml_workflow.regression.io for standardized schema\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"from finance_ml.ml_workflow.regression.io import build_predictions_frame\\\\n\\\",\\n\",\n",
    "    \"    \\\"from finance_ml.ml_workflow.regression.quantile import enforce_monotonic_quantiles\\\\n\\\",\\n\",\n",
    "    \"    \\\"import os\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Build detailed predictions DataFrame for diagnostics and export\\\\n\\\",\\n\",\n",
    "    \"    \\\"try:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Use build_predictions_frame for standardized schema (Priority 1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    source_df = all_stocks_enhanced if 'all_stocks_enhanced' in globals() else None\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Call build_predictions_frame - it safely handles metadata columns using .loc[] alignment\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # No need to drop 'sector' - the function doesn't use DataFrame.insert()\\\\n\\\",\\n\",\n",
    "    \"    \\\"    results_df = build_predictions_frame(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            y_true=y_test,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            y_pred=y_pred_stacking,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            df_source=source_df if source_df is not None else pd.DataFrame(index=y_test.index),\\\\n\\\",\\n\",\n",
    "    \"    \\\"            extra_cols={}\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    out_models_dir = OUTPUT_DIR / 'regression'\\\\n\\\",\\n\",\n",
    "    \"    \\\"    out_models_dir.mkdir(parents=True, exist_ok=True)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Priority 3: Apply isotonic calibration by sector (monotonic, no fixed bias)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Requires calibration dataset with y_true values for fitting isotonic regression\\\\n\\\",\\n\",\n",
    "    \"    \\\"    try:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Step 1: Create calibration DataFrame from training data\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(\\\\\\\"\\\\\\\\n\\\\\\\" + \\\\\\\"=\\\\\\\" * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(\\\\\\\"ISOTONIC CALIBRATION BY SECTOR\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(\\\\\\\"=\\\\\\\" * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # === FIX START: Align X_train features with Model features for calibration ===\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Same logic as in Section 6.4: ensure X_train has all features the model expects\\\\n\\\",\\n\",\n",
    "    \"    \\\"        X_train_for_calibration = X_train.copy()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Get model's expected feature names\\\\n\\\",\\n\",\n",
    "    \"    \\\"        model_features_cal = getattr(stacking_model, \\\\\\\"feature_names_in_\\\\\\\", None)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if model_features_cal is None and hasattr(stacking_model, \\\\\\\"estimators_\\\\\\\"):\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Try getting features from the first base estimator if wrapper hides them\\\\n\\\",\\n\",\n",
    "    \"    \\\"            model_features_cal = getattr(stacking_model.estimators_[0], \\\\\\\"feature_names_in_\\\\\\\", None)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if model_features_cal is not None:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            missing_cols_cal = set(model_features_cal) - set(X_train_for_calibration.columns)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if missing_cols_cal:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(f\\\\\\\"⚠ Detected {len(missing_cols_cal)} missing interaction features in X_train. Regenerating...\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                # Import helpers if not available\\\\n\\\",\\n\",\n",
    "    \"    \\\"                from finance_ml.ml_workflow.regression.dataset import (\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    integrate_classification_features,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    create_classification_interactions\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                # Add classification probability features if available\\\\n\\\",\\n\",\n",
    "    \"    \\\"                if train_probs is not None:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    X_train_for_calibration = integrate_classification_features(X_train_for_calibration, train_probs)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                # Identify classification probability columns currently in X_train\\\\n\\\",\\n\",\n",
    "    \"    \\\"                cls_cols_cal = [c for c in X_train_for_calibration.columns if\\\\n\\\",\\n\",\n",
    "    \"    \\\"                                c.startswith('event_prob_') or c == 'event_confidence']\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                # Identify valuation columns (fallback to default if method-aware list not found)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                val_cols_cal = globals().get('valuation_cols_method_aware', [\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    'market_cap', 'enterprise_value', 'ebitda', 'p_e', 'p_b',\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    'gross_margin', 'revenue', 'net_income'\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    ])\\\\n\\\",\\n\",\n",
    "    \"    \\\"                val_cols_cal = [c for c in val_cols_cal if c in X_train_for_calibration.columns]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                # Regenerate interactions on Training Data\\\\n\\\",\\n\",\n",
    "    \"    \\\"                if cls_cols_cal and val_cols_cal:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    X_train_for_calibration = create_classification_interactions(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                            X_train_for_calibration,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                            classification_cols=cls_cols_cal,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                            valuation_cols=val_cols_cal\\\\n\\\",\\n\",\n",
    "    \"    \\\"                            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                # Final alignment: Ensure exact column order and fill any remaining gaps with 0\\\\n\\\",\\n\",\n",
    "    \"    \\\"                X_train_for_calibration = X_train_for_calibration.reindex(columns=model_features_cal, fill_value=0)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(f\\\\\\\"✓ X_train aligned for calibration. New shape: {X_train_for_calibration.shape}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # === FIX END ===\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        y_pred_train = stacking_model.predict(X_train_for_calibration)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Build calibration df with required columns\\\\n\\\",\\n\",\n",
    "    \"    \\\"        cal_df = pd.DataFrame({\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\\\\"y_true\\\\\\\": y_train.values,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\\\\"y_pred\\\\\\\": y_pred_train,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\\\\"sector\\\\\\\": source_df.loc[y_train.index, \\\\\\\"sector\\\\\\\"].values\\\\n\\\",\\n\",\n",
    "    \"    \\\"            })\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"\\\\\\\\n✓ Calibration set: {len(cal_df):,} samples\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"  Sectors: {cal_df['sector'].nunique()}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Step 2: Apply isotonic calibration (learns monotonic transformation per sector)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        results_df = calibrate_predictions_by_sector(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                preds_df=results_df,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                cal_df=cal_df,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                method=\\\\\\\"isotonic\\\\\\\",  # CHANGED from \\\\\\\"additive\\\\\\\" - no fixed bias subtraction\\\\n\\\",\\n\",\n",
    "    \"    \\\"                sector_col=\\\\\\\"sector\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"                pred_col=\\\\\\\"y_pred\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"                true_col=\\\\\\\"y_true\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"                output_col=\\\\\\\"y_pred_calibrated\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"                min_samples=5\\\\n\\\",\\n\",\n",
    "    \"    \\\"                )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Step 3: Apply final non-negative constraint + outlier clipping (single enforcement point)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if \\\\\\\"y_pred_calibrated\\\\\\\" in results_df.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            y_pred_calib = results_df[\\\\\\\"y_pred_calibrated\\\\\\\"].to_numpy()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Diagnostic: Check calibrated predictions before final clipping\\\\n\\\",\\n\",\n",
    "    \"    \\\"            n_neg_before = (y_pred_calib < 0).sum()\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"\\\\\\\\n📊 Calibrated predictions (before final clipping):\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"  Negative predictions: {n_neg_before} ({n_neg_before / len(y_pred_calib) * 100:.1f}%)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"  Range: ${y_pred_calib.min():.2f} to ${y_pred_calib.max():.2f}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Apply adaptive clipping: non-negative + outlier bounds\\\\n\\\",\\n\",\n",
    "    \"    \\\"            clip_result = adaptive_clip_predictions(y_pred_calib, y_train)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            y_pred_final = clip_result[\\\\\\\"clipped_predictions\\\\\\\"]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Update results_df with final clipped predictions\\\\n\\\",\\n\",\n",
    "    \"    \\\"            results_df[\\\\\\\"y_pred_calibrated\\\\\\\"] = y_pred_final\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Recompute errors with final predictions\\\\n\\\",\\n\",\n",
    "    \"    \\\"            yt = results_df[\\\\\\\"y_true\\\\\\\"].to_numpy()\\\\n\\\",\\n\",\n",
    "    \"    \\\"            results_df[\\\\\\\"abs_error_calibrated\\\\\\\"] = np.abs(yt - y_pred_final)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            results_df[\\\\\\\"pct_error_calibrated\\\\\\\"] = np.where(yt != 0, ((y_pred_final - yt) / yt) * 100.0, np.nan)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Final diagnostic\\\\n\\\",\\n\",\n",
    "    \"    \\\"            n_zeros = (y_pred_final == 0).sum()\\\\n\\\",\\n\",\n",
    "    \"    \\\"            n_neg = (y_pred_final < 0).sum()\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"\\\\\\\\n✅ Final predictions (after adaptive clipping):\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"  Lower bound: ${clip_result['lower_bound']:.2f}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"  Upper bound: ${clip_result['upper_bound']:.2f}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"  Clipped to lower: {clip_result['n_clipped_lower']} ({clip_result['pct_clipped_lower']:.1f}%)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"  Clipped to upper: {clip_result['n_clipped_upper']} ({clip_result['pct_clipped_upper']:.1f}%)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"  Zero predictions: {n_zeros} ({n_zeros / len(y_pred_final) * 100:.1f}%) - TARGET: <1%\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"  Negative predictions: {n_neg} (should be 0)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"  Range: ${y_pred_final.min():.2f} to ${y_pred_final.max():.2f}\\\\\\\")\\\\n\\\",\\n\",\n",
