    "                path=['region', 'sector'],\n",
    "                values='count',\n",
    "                title='Stock Distribution: Region → Sector Hierarchy',\n",
    "                height=700\n",
    "                )\n",
    "        fig.update_traces(textinfo='label+percent parent')\n",
    "        fig.show()\n"
