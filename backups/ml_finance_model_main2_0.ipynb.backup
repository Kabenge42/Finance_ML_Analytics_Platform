    "\n",
    "# Summary\n",
    "total_expected = (\n",
    "        len(EXPECTED_VALUATION_METRICS) +\n",
    "        len(EXPECTED_PROFITABILITY_METRICS) +\n",
    "        len(EXPECTED_GROWTH_METRICS) +\n",
