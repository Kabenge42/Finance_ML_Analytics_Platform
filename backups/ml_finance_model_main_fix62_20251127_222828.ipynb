    "    \"    \\\"    }\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"X_cls_all_processed = _prepare_inference_data(\\\\n\\\",\\n\",\n",
    "    \"    \\\"        all_stocks_features,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        X_train_cls.columns,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        model_feature_names,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        prep_params\\\\n\\\",\\n\",\n",
    "    \"    \\\"        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"  [OK] Final shape aligned to model: {X_cls_all_processed.shape}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# 3. Generate Probabilities\\\\n\\\",\\n\",\n",
    "    \"    \\\"y_proba_all = cls_model.predict_proba(X_cls_all_processed)\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"\\\\\\\\n[OK] Classification Model Trained with Optimized Hyperparameters\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# 4. Evaluate Accuracy (Aligning train/test data first)\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Align both train and test data to model features before prediction\\\\n\\\",\\n\",\n",
    "    \"    \\\"X_train_aligned = X_train_processed.reindex(columns=model_feature_names, fill_value=0)\\\\n\\\",\\n\",\n",
    "    \"    \\\"X_test_aligned = X_test_processed.reindex(columns=model_feature_names, fill_value=0)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Generate predictions and metrics\\\\n\\\",\\n\",\n",
    "    \"    \\\"y_train_pred = cls_model.predict(X_train_aligned)\\\\n\\\",\\n\",\n",
    "    \"    \\\"y_test_pred = cls_model.predict(X_test_aligned)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"train_accuracy = accuracy_score(y_train_cls, y_train_pred)\\\\n\\\",\\n\",\n",
    "    \"    \\\"test_accuracy = accuracy_score(y_test_cls, y_test_pred)\\\\n\\\",\\n\",\n",
