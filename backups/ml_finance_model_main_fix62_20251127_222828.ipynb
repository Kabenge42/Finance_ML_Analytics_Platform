    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print('  ⚠️  WARNING: \\\\\\\"market_cap\\\\\\\" column not found!')\\\\n\\\",\\n\",\n",
    "    \"    \\\"        min_mc_threshold = 0.0\\\\n\\\",\\n\",\n",
    "    \"    \\\"        cap_unit = ''\\\\n\\\",\\n\",\n",
