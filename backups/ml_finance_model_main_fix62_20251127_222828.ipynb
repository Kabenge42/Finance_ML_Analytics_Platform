    "    \"    \\\"                      if c in all_stocks_with_classification.columns]\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"\\\\\\\\n⚠️  Using default valuation columns (method-aware columns not found)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"if classification_cols and valuation_cols:\\\\n\\\",\\n\",\n",
