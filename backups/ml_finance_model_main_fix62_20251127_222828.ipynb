    "    \"   \\\"cell_type\\\": \\\"code\\\",\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"from finance_ml.ml_workflow.features import preprocess_for_lightgbm\\\\n\\\",\\n\",\n",
    "    \"    \\\"from finance_ml.ml_workflow.data.schema import list_categorical_cols, list_date_cols\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Get categorical and datetime columns from schema (Section 2.2)\\\\n\\\",\\n\",\n",
    "    \"    \\\"categorical_cols_from_schema = list_categorical_cols()\\\\n\\\",\\n\",\n",
    "    \"    \\\"datetime_cols_from_schema = list_date_cols()\\\\n\\\",\\n\",\n",
    "    \"    \\\"auxiliary_cols_to_drop = ['unit', 'dividend_record_frequency', 'dividend_record_currency']\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Preprocess training data (returns both processed data and encoders)\\\\n\\\",\\n\",\n",
    "    \"    \\\"X_train_processed, encoders = preprocess_for_lightgbm(\\\\n\\\",\\n\",\n",
    "    \"    \\\"        X_train_cls.copy(),\\\\n\\\",\\n\",\n",
    "    \"    \\\"        categorical_columns=categorical_cols_from_schema,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        datetime_columns=datetime_cols_from_schema,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        drop_columns=auxiliary_cols_to_drop,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        return_encoders=True\\\\n\\\",\\n\",\n",
    "    \"    \\\"        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Extract reference date for consistent datetime transformations\\\\n\\\",\\n\",\n",
    "    \"    \\\"reference_date = encoders.get('_reference_date')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Preprocess test data using training encoders (inference mode)\\\\n\\\",\\n\",\n",
    "    \"    \\\"X_test_processed, _ = preprocess_for_lightgbm(\\\\n\\\",\\n\",\n",
    "    \"    \\\"        X_test_cls.copy(),\\\\n\\\",\\n\",\n",
    "    \"    \\\"        categorical_columns=categorical_cols_from_schema,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        datetime_columns=datetime_cols_from_schema,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        drop_columns=auxiliary_cols_to_drop,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        encoders=encoders,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        reference_date=reference_date\\\\n\\\",\\n\",\n",
    "    \"    \\\"        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Store training feature columns for prediction alignment\\\\n\\\",\\n\",\n",
    "    \"    \\\"training_feature_cols = X_train_processed.columns.tolist()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Align test data columns to match training features\\\\n\\\",\\n\",\n",
    "    \"    \\\"X_test_processed = X_test_processed.reindex(\\\\n\\\",\\n\",\n",
    "    \"    \\\"        columns=training_feature_cols,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        fill_value=0  # Fill missing columns with zero (new categorical levels in test)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Update column lists for downstream usage (all columns now numeric after label encoding)\\\\n\\\",\\n\",\n",
    "    \"    \\\"numeric_cols_processed = X_train_processed.select_dtypes(include=[np.number]).columns.tolist()\\\\n\\\",\\n\",\n",
    "    \"    \\\"categorical_cols_processed = []  # All categoricals converted to numeric\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"✓ Preprocessing complete: {X_train_processed.shape[0]} train samples, {X_test_processed.shape[0]} test samples\\\\\\\")\\\\n\\\",\\n\",\n",
