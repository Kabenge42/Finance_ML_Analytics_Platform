    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Generate efficient frontier and constraint sensitivity artifacts\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print('\\\\\\\\n📊 Generating efficient frontier and constraint scenarios...')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    constraints_dict = {'max_weight': [0.1, 0.15, 0.2, 0.25, 0.3]}\\\\n\\\",\\n\",\n",
