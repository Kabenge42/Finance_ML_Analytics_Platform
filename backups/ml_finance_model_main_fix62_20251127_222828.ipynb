    "    \"   \\\"cell_type\\\": \\\"markdown\\\",\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"## Phase 9.4: Multi-Class Event Classification of Financial Events\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Business Goal\\\\n\\\",\\n\",\n",
    "    \"    \\\"Classify stocks into financial event categories (Strong Negative, Negative, Neutral, Positive, Strong Positive) to provide granular sentiment signals that enhance regression model accuracy and enable better risk management.\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Key Objectives\\\\n\\\",\\n\",\n",
    "    \"    \\\"1. Create enhanced event labels using multiple methods\\\\n\\\",\\n\",\n",
    "    \"    \\\"2. Prepare classification data with Phase 9.3 features\\\\n\\\",\\n\",\n",
    "    \"    \\\"3. Train and optimize classifiers (XGBoost, LightGBM, CatBoost)\\\\n\\\",\\n\",\n",
    "    \"    \\\"4. Evaluate classification performance\\\\n\\\",\\n\",\n",
    "    \"    \\\"5. Extract classification probabilities as meta-features\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Inputs\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `all_stocks_features`: Feature-engineered data from Phase 9.3\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Outputs\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `clf_result`: Classification model result dict with probabilities\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `outputs/classification/`: Model artifacts, evaluation metrics, confusion matrices\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Event probability features for Phase 9.5\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Standardized Return Format (v1.2)\\\\n\\\",\\n\",\n",
    "    \"    \\\"```python\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Example return structure (not executable code):\\\\n\\\",\\n\",\n",
    "    \"    \\\"# clf_result = {\\\\n\\\",\\n\",\n",
    "    \"    \\\"#     'model': fitted_classifier,\\\\n\\\",\\n\",\n",
    "    \"    \\\"#     'metrics': {'accuracy': 0.85, 'f1_macro': 0.82, ...},\\\\n\\\",\\n\",\n",
    "    \"    \\\"#     'y_pred': np.ndarray,  # array of predicted classes (0-4 for 5-class)\\\\n\\\",\\n\",\n",
    "    \"    \\\"#     'y_proba': np.ndarray,  # (n_samples, 5) probabilities for 5 classes\\\\n\\\",\\n\",\n",
    "    \"    \\\"#     'artifacts': {'feature_importance': pd.DataFrame, ...}\\\\n\\\",\\n\",\n",
    "    \"    \\\"# }\\\\n\\\",\\n\",\n",
    "    \"    \\\"```\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Validation Checkpoint\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Classification accuracy > 60%\\\\n\\\",\\n\",\n",
    "    \"    \\\"- All 5 classes represented in predictions (0-4: Strong Negative to Strong Positive)\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Probabilities sum to 1.0\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Feature importance extracted\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"Train sophisticated classification models to predict financial events:\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Event labeling: 5-class system (0=Strong Negative, 1=Negative, 2=Neutral, 3=Positive, 4=Strong Positive)\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Multiple event detection methods: price_momentum, valuation, fundamental, volatility, analyst_rating, profitability, leverage, liquidity, efficiency, growth, quality, composite\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Multiple classifiers: XGBoost, LightGBM, CatBoost, Neural Networks, Ensembles\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Export classification probabilities as meta-features for regression\\\\n\\\"\\n\",\n",
    "    \"   ],\\n\",\n",
    "    \"   \\\"id\\\": \\\"dcda192dbd1eb5bc\\\"\\n\",\n",
    "    \"  },\\n\",\n",
    "    \"  {\\n\",\n",
    "    \"   \\\"metadata\\\": {\\n\",\n",
    "    \"    \\\"ExecuteTime\\\": {\\n\",\n",
    "    \"     \\\"end_time\\\": \\\"2025-11-27T20:12:06.556860Z\\\",\\n\",\n",
    "    \"     \\\"start_time\\\": \\\"2025-11-27T20:12:06.297074Z\\\"\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"   },\\n\",\n",
    "    \"   \\\"cell_type\\\": \\\"code\\\",\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"# Prepare classification data with Phase 9.3 feature groups\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"\\\\\\\\n\\\\\\\" + \\\\\\\"=\\\\\\\" * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"CLASSIFICATION DATA PREPARATION\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"=\\\\\\\" * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Step 1: Create event labels FIRST (required parameter for prepare_classification_data)\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"\\\\\\\\n🏷️  Creating Event Labels for Classification...\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"  Method: composite_event (canonical for Phase 9.3)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Create labels using classification_create_enhanced_event_labels\\\\n\\\",\\n\",\n",
    "    \"    \\\"# This generates the required 'labels' numpy array\\\\n\\\",\\n\",\n",
    "    \"    \\\"event_labels = classification_create_enhanced_event_labels(\\\\n\\\",\\n\",\n",
    "    \"    \\\"        all_stocks_features,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        method='profitability_event',  # Use price_momentum method for reliable class distribution\\\\n\\\",\\n\",\n",
    "    \"    \\\"        use_sector_adjustment=True\\\\n\\\",\\n\",\n",
    "    \"    \\\"        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Validate label distribution\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"\\\\\\\\n✓ Event Labels Created:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"  Total samples: {len(event_labels)}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"  Class distribution:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\n\\\",\\n\",\n",
    "    \"    \\\"        f\\\\\\\"    Strong Negative (0): {(event_labels == 0).sum()} ({(event_labels == 0).sum() / len(event_labels) * 100:.1f}%)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"    Negative (1): {(event_labels == 1).sum()} ({(event_labels == 1).sum() / len(event_labels) * 100:.1f}%)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"    Neutral (2): {(event_labels == 2).sum()} ({(event_labels == 2).sum() / len(event_labels) * 100:.1f}%)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"    Positive (3): {(event_labels == 3).sum()} ({(event_labels == 3).sum() / len(event_labels) * 100:.1f}%)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\n\\\",\\n\",\n",
    "    \"    \\\"        f\\\\\\\"    Strong Positive (4): {(event_labels == 4).sum()} ({(event_labels == 4).sum() / len(event_labels) * 100:.1f}%)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Step 1.5: Define method-aware valuation columns for interaction features\\\\n\\\",\\n\",\n",
    "    \"    \\\"# This ensures valuation columns match the semantics of the chosen event labeling method\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"\\\\\\\\n📊 Defining Method-Aware Valuation Columns...\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Extract the label method used above (must match the method argument in classification_create_enhanced_event_labels)\\\\n\\\",\\n\",\n",
    "    \"    \\\"label_method = 'profitability_event'  # Must match method parameter above (line 1510)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Define valuation column candidates grouped by event labeling method semantics\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Each group contains columns relevant to that method's economic logic\\\\n\\\",\\n\",\n",
    "    \"    \\\"# \\\\n\\\",\\n\",\n",
    "    \"    \\\"# PHASE 9.3 ALIGNMENT (Updated 2025-11-24):\\\\n\\\",\\n\",\n",
    "    \"    \\\"# This dictionary now includes Phase 9.3 engineered features alongside raw data columns.\\\\n\\\",\\n\",\n",
    "    \"    \\\"# All 19 event classification methods from labels.py are covered, mapping to the 196 \\\\n\\\",\\n\",\n",
    "    \"    \\\"# engineered features across 16 Phase 9.3 categories from phase93_categories.py.\\\\n\\\",\\n\",\n",
    "    \"    \\\"#\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Structure:\\\\n\\\",\\n\",\n",
    "    \"    \\\"# - Original methods (7): price_momentum, valuation, fundamental, volatility, analyst_rating, market_events, combined_signals\\\\n\\\",\\n\",\n",
    "    \"    \\\"# - Phase 9.4 specialized (6): profitability_event, leverage_event, liquidity_event, efficiency_event, growth_event, quality_event, composite_event\\\\n\\\",\\n\",\n",
    "    \"    \\\"# - Phase 9.3 new methods (5): cashflow_event, capital_allocation_event, employee_productivity_event, balance_sheet_event, revenue_forecast_event\\\\n\\\",\\n\",\n",
    "    \"    \\\"#\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Each method includes:\\\\n\\\",\\n\",\n",
    "    \"    \\\"# 1. Raw data columns (for backward compatibility and label creation)\\\\n\\\",\\n\",\n",
    "    \"    \\\"# 2. Phase 9.3 engineered features (196 total across 16 categories)\\\\n\\\",\\n\",\n",
    "    \"    \\\"# 3. Schema 1.3 time-series columns (_fq, _5yavgfq, _5yavgltm, _previous_year)\\\\n\\\",\\n\",\n",
    "    \"    \\\"#\\\\n\\\",\\n\",\n",
    "    \"    \\\"valuation_candidates_by_method = {\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"price_momentum\\\\\\\": [\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"last_price\\\\\\\", \\\\\\\"price_target\\\\\\\", \\\\\\\"price_target_median\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"price_target_high\\\\\\\", \\\\\\\"price_target_low\\\\\\\", \\\\\\\"price_target_ytd_ago\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"market_cap\\\\\\\", \\\\\\\"enterprise_value\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"p_e\\\\\\\", \\\\\\\"p_e_ltm\\\\\\\", \\\\\\\"p_e_ntm\\\\\\\", \\\\\\\"p_e_1fyltm\\\\\\\", \\\\\\\"p_e_5yavgltm\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"p_b\\\\\\\", \\\\\\\"p_b_ltm\\\\\\\", \\\\\\\"p_b_1fy\\\\\\\", \\\\\\\"p_b_5yavg\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Price momentum metrics\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"price_chg_pct_1m\\\\\\\", \\\\\\\"price_chg_pct_3m\\\\\\\", \\\\\\\"one_day_pct\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"price_5d_ago\\\\\\\", \\\\\\\"price_1w_ago\\\\\\\", \\\\\\\"price_1m_ago\\\\\\\", \\\\\\\"price_3m_ago\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"total_return_ytd\\\\\\\", \\\\\\\"total_return_5y\\\\\\\", \\\\\\\"total_return_10y\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"tot_return_pct_cagr_3y\\\\\\\", \\\\\\\"tot_return_pct_cagr_10y\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Phase 9.3 Schema 1.3: Technical indicators\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"ema_20d\\\\\\\", \\\\\\\"ema_50d\\\\\\\", \\\\\\\"ema_100d\\\\\\\", \\\\\\\"ema_250d\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"52w_high_adj\\\\\\\", \\\\\\\"52w_low_adj\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"rel_volume\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"        ],\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"valuation\\\\\\\": [\\\\n\\\",\\n\",\n",
