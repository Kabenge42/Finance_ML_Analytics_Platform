    "    \"    \\\"    print('\\\\\\\\n📊 Generating universe summary...')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    universe_manifest = universe_summary(portfolio_candidates, portfolio_out_dir)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f'✓ Created universe summary artifacts: {\\\\\\\", \\\\\\\".join(universe_manifest[\\\\\\\"files\\\\\\\"])}')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Display summary statistics\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print('\\\\\\\\n📈 Portfolio Universe Summary:')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f'  Total candidates: {len(portfolio_candidates)}')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if 'sector' in portfolio_candidates.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f'  Sectors: {portfolio_candidates[\\\\\\\"sector\\\\\\\"].nunique()}')\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f'  Sector distribution:')\\\\n\\\",\\n\",\n",
    "    \"    \\\"        for sector, count in portfolio_candidates['sector'].value_counts().head(5).items():\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f'    {sector}: {count} ({count / len(portfolio_candidates) * 100:.1f}%)')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if 'region' in portfolio_candidates.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f'  Regions: {portfolio_candidates[\\\\\\\"region\\\\\\\"].nunique()}')\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f'  Region distribution: {dict(portfolio_candidates[\\\\\\\"region\\\\\\\"].value_counts())}')\\\\n\\\",\\n\",\n",
    "    \"    \\\"else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print('\\\\\\\\n⚠️  No portfolio candidates available for diagnostics')\\\\n\\\"\\n\",\n",
    "    \"   ],\\n\",\n",
    "    \"   \\\"id\\\": \\\"94b186977399ab76\\\",\\n\",\n",
    "    \"   \\\"outputs\\\": [],\\n\",\n",
    "    \"   \\\"execution_count\\\": null\\n\",\n",
    "    \"  },\\n\",\n",
    "    \"  {\\n\",\n",
    "    \"   \\\"metadata\\\": {},\\n\",\n",
    "    \"   \\\"cell_type\\\": \\\"code\\\",\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"# Interactive filter explorer placeholder\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Note: The universe_summary function creates portfolio_filter_explorer.html\\\\n\\\",\\n\",\n",
    "    \"    \\\"# This cell documents the available interactive visualization\\\\n\\\",\\n\",\n",
    "    \"    \\\"if portfolio_candidates is not None and len(portfolio_candidates) > 0:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    filter_explorer_path = portfolio_out_dir / 'portfolio_filter_explorer.html'\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if filter_explorer_path.exists():\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f'\\\\\\\\n✓ Interactive filter explorer available at: {filter_explorer_path}')\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print('  Open this file in a browser to explore filtering scenarios')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print('\\\\\\\\n⚠️  Filter explorer not created')\\\\n\\\"\\n\",\n",
    "    \"   ],\\n\",\n",
    "    \"   \\\"id\\\": \\\"b7489b8f1bc3acbc\\\",\\n\",\n",
    "    \"   \\\"outputs\\\": [],\\n\",\n",
    "    \"   \\\"execution_count\\\": null\\n\",\n",
    "    \"  },\\n\",\n",
    "    \"  {\\n\",\n",
    "    \"   \\\"metadata\\\": {},\\n\",\n",
    "    \"   \\\"cell_type\\\": \\\"code\\\",\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"# 10.3 ML-Based Return Prediction\\\\n\\\",\\n\",\n",
    "    \"    \\\"print('\\\\\\\\n' + '=' * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"print('10.3 ML-BASED RETURN PREDICTION')\\\\n\\\",\\n\",\n",
    "    \"    \\\"print('=' * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"if (portfolio_candidates is not None and\\\\n\\\",\\n\",\n",
    "    \"    \\\"        len(portfolio_candidates) >= MIN_PORTFOLIO_CANDIDATES):\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Configure logging\\\\n\\\",\\n\",\n",
    "    \"    \\\"    from finance_ml.logging_config import configure_logging, get_logger\\\\n\\\",\\n\",\n",
    "    \"    \\\"    import logging\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    configure_logging(level=logging.INFO, console=True)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    logger = get_logger(__name__)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    from finance_ml.ml_workflow.analytics.ml_returns import (\\\\n\\\",\\n\",\n",
    "    \"    \\\"        create_ml_return_features,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        train_linear_return_predictor,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        create_ensemble_return_predictions\\\\n\\\",\\n\",\n",
    "    \"    \\\"        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    logger.info(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            f'Generating ML-based return predictions for '\\\\n\\\",\\n\",\n",
    "    \"    \\\"            f'{len(portfolio_candidates)} candidates'\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            f'\\\\\\\\n✓ Generating ML-based return predictions for '\\\\n\\\",\\n\",\n",
    "    \"    \\\"            f'{len(portfolio_candidates)} candidates'\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Stage 1: Ensure return_1y exists\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # (calculate from price history or use YTD return)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if 'return_1y' not in portfolio_candidates.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if ('last_price' in portfolio_candidates.columns and\\\\n\\\",\\n\",\n",
    "    \"    \\\"                'price_1y_ago' in portfolio_candidates.columns):\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Calculate 1-year return from price history\\\\n\\\",\\n\",\n",
    "    \"    \\\"            portfolio_candidates['return_1y'] = (\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    (portfolio_candidates[TARGET_COL_FALLBACK] -\\\\n\\\",\\n\",\n",
    "    \"    \\\"                     portfolio_candidates['price_1y_ago']) /\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    portfolio_candidates['price_1y_ago']\\\\n\\\",\\n\",\n",
    "    \"    \\\"            ).fillna(0.0)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            logger.info('Calculated return_1y from price history')\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print('  ✓ Calculated return_1y from last_price and price_1y_ago')\\\\n\\\",\\n\",\n",
    "    \"    \\\"        elif 'total_return_ytd' in portfolio_candidates.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Use YTD return as proxy\\\\n\\\",\\n\",\n",
    "    \"    \\\"            portfolio_candidates['return_1y'] = (\\\\n\\\",\\n\",\n",
    "    \"    \\\"                portfolio_candidates['total_return_ytd']\\\\n\\\",\\n\",\n",
    "    \"    \\\"                .fillna(DEFAULT_EXPECTED_RETURN)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"            logger.info('Using total_return_ytd as proxy for return_1y')\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print('  ✓ Using total_return_ytd as proxy for return_1y')\\\\n\\\",\\n\",\n",
    "    \"    \\\"        else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Default to configured expected return\\\\n\\\",\\n\",\n",
    "    \"    \\\"            portfolio_candidates['return_1y'] = DEFAULT_EXPECTED_RETURN\\\\n\\\",\\n\",\n",
    "    \"    \\\"            logger.warning(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'No return data available, using default '\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'{DEFAULT_EXPECTED_RETURN:.1%} for return_1y'\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'  ⚠️  No return data available, using default '\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'{DEFAULT_EXPECTED_RETURN:.1%} for return_1y'\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Stage 2: Create ML features for return prediction\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print('\\\\\\\\n📊 Creating ML Features...')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    logger.info('Starting ML feature creation')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Step 1: Validate data structure\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Schema v1.3 uses 'last_updated' as canonical date column\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # (code_guidelines.md Section 2.2)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    required_cols = ['ticker', 'last_updated', 'last_price']\\\\n\\\",\\n\",\n",
    "    \"    \\\"    missing_cols = [\\\\n\\\",\\n\",\n",
    "    \"    \\\"        col for col in required_cols\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if col not in portfolio_candidates.columns\\\\n\\\",\\n\",\n",
    "    \"    \\\"        ]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if missing_cols:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        logger.error(f'Missing required columns: {missing_cols}')\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f'  ⚠️  Missing required columns: {missing_cols}')\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print('  ⚠️  Skipping ML feature creation')\\\\n\\\",\\n\",\n",
    "    \"    \\\"        ml_features_df = None\\\\n\\\",\\n\",\n",
    "    \"    \\\"    else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Step 2: Check data structure (cross-sectional vs time-series)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        dates_per_ticker = (\\\\n\\\",\\n\",\n",
    "    \"    \\\"            portfolio_candidates\\\\n\\\",\\n\",\n",
    "    \"    \\\"            .groupby('ticker')['last_updated']\\\\n\\\",\\n\",\n",
    "    \"    \\\"            .nunique()\\\\n\\\",\\n\",\n",
    "    \"    \\\"        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"        avg_dates_per_ticker = dates_per_ticker.mean()\\\\n\\\",\\n\",\n",
    "    \"    \\\"        is_cross_sectional = avg_dates_per_ticker < MIN_DATES_FOR_TIMESERIES\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if is_cross_sectional:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            logger.info(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'Detected cross-sectional data '\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'(avg {avg_dates_per_ticker:.1f} dates/ticker)'\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'  ✓ Detected cross-sectional data '\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'(avg {avg_dates_per_ticker:.1f} dates/ticker)'\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    '  → Skipping time-series ML features '\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    '(requires historical data)'\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print('  → Will use existing expected_return for optimization')\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Set ml_features_df to None to signal no ML features available\\\\n\\\",\\n\",\n",
    "    \"    \\\"            ml_features_df = None\\\\n\\\",\\n\",\n",
    "    \"    \\\"        else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Time-series data available - proceed with ML feature creation\\\\n\\\",\\n\",\n",
    "    \"    \\\"            logger.info(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'Detected time-series data '\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'(avg {avg_dates_per_ticker:.1f} dates/ticker)'\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'  ✓ Detected time-series data '\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'(avg {avg_dates_per_ticker:.1f} dates/ticker)'\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Step 2a: Calculate daily returns if not present\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if 'return_1d' not in portfolio_candidates.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                logger.info('Calculating daily returns')\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print('  Calculating daily returns...')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                # Sort by ticker and date\\\\n\\\",\\n\",\n",
    "    \"    \\\"                portfolio_candidates = portfolio_candidates.sort_values(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        ['ticker', 'last_updated']\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                # Calculate returns grouped by ticker\\\\n\\\",\\n\",\n",
    "    \"    \\\"                portfolio_candidates['return_1d'] = (\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    portfolio_candidates\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    .groupby('ticker')['last_price']\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    .pct_change()\\\\n\\\",\\n\",\n",
    "    \"    \\\"                )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                # Drop NaN returns (first observation per ticker)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                initial_count = len(portfolio_candidates)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                portfolio_candidates = portfolio_candidates.dropna(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        subset=['return_1d']\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"                rows_dropped = initial_count - len(portfolio_candidates)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                logger.info(f'Calculated returns ({rows_dropped} rows dropped)')\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(f'  ✓ Calculated returns ({rows_dropped} rows dropped)')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Step 3: Verify sufficient time series data\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if dates_per_ticker.mean() < MIN_DATES_FOR_RELIABLE_ML:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                logger.warning(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        f'Limited time series data '\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        f'(avg {dates_per_ticker.mean():.1f} dates/ticker)'\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        f'  ⚠️  Warning: Limited time series data '\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        f'(avg {dates_per_ticker.mean():.1f} dates/ticker)'\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print('     ML features may be less reliable')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Step 4: Create ML features\\\\n\\\",\\n\",\n",
    "    \"    \\\"            logger.info(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'Creating ML features with lags={LAG_PERIODS}, '\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'indicators={TECHNICAL_INDICATORS}'\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"            ml_features_df = create_ml_return_features(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    portfolio_candidates,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    lags=LAG_PERIODS,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    technical_indicators=TECHNICAL_INDICATORS\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"            logger.info(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'Created {ml_features_df.shape[1]} ML features, '\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'{len(ml_features_df)} rows'\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f'  ✓ Created {ml_features_df.shape[1]} ML features')\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f'  ✓ Final dataset: {len(ml_features_df)} rows')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Stage 3: Train linear return predictor (if we have historical returns)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if (ml_features_df is not None and\\\\n\\\",\\n\",\n",
    "    \"    \\\"            'return_1y' in portfolio_candidates.columns):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print('\\\\\\\\n📊 Training Linear Return Predictor...')\\\\n\\\",\\n\",\n",
    "    \"    \\\"        logger.info('Training linear return predictor')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        feature_cols = [\\\\n\\\",\\n\",\n",
    "    \"    \\\"            col for col in ml_features_df.columns\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if col.startswith('lag_') or col.startswith('tech_')\\\\n\\\",\\n\",\n",
    "    \"    \\\"            ]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if len(feature_cols) > 0:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            X = ml_features_df[feature_cols].fillna(0)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            y = portfolio_candidates['return_1y'].fillna(DEFAULT_EXPECTED_RETURN)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Split for training (use configured train size)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            split_idx = int(len(X) * TRAIN_SIZE)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            X_train, y_train = X.iloc[:split_idx], y.iloc[:split_idx]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            logger.info(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'Training with {len(feature_cols)} features, '\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'{len(X_train)} training samples'\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"            linear_model = train_linear_return_predictor(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    X_train.values,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    y_train.values\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f'  ✓ Linear model trained with {len(feature_cols)} features')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Generate predictions\\\\n\\\",\\n\",\n",
    "    \"    \\\"            ml_predicted_returns = pd.Series(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    linear_model.predict(X.values),\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    index=portfolio_candidates.index\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Stage-based naming: add ML predictions\\\\n\\\",\\n\",\n",
    "    \"    \\\"            portfolio_candidates_with_ml = portfolio_candidates.copy()\\\\n\\\",\\n\",\n",
    "    \"    \\\"            portfolio_candidates_with_ml['ml_predicted_return'] = (\\\\n\\\",\\n\",\n",
    "    \"    \\\"                ml_predicted_returns\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"            portfolio_candidates = portfolio_candidates_with_ml\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            logger.info(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'ML predictions: mean={ml_predicted_returns.mean():.3f}, '\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'std={ml_predicted_returns.std():.3f}'\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'  ✓ ML predictions: mean={ml_predicted_returns.mean():.3f}, '\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f'std={ml_predicted_returns.std():.3f}'\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Stage 4: Create ensemble return predictions\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print('\\\\\\\\n📊 Creating Ensemble Return Predictions...')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    logger.info('Creating ensemble return predictions')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    available_models = []\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if 'expected_return' in portfolio_candidates.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        available_models.append('expected_return')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if 'return_1y' in portfolio_candidates.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        available_models.append('return_1y')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if 'ml_predicted_return' in portfolio_candidates.columns:\\\\n\\\",\\n\",\n",
