   "cell_type": "code",
   "source": [
    "# Phase 9.1: Consolidated ETL Pipeline with Financial Metrics (code_guidelines.md Section 8.2)\n",
    "# Unified data loading using etl_with_financial_metrics() - RECOMMENDED approach\n",
    "# Replaces: load_from_db/csv → normalize_columns → validate_schema → imputation → financial_metrics\n",
    "# Note: Winsorization and scaling are done in downstream cells per code_guidelines.md\n",
    "# Reference: code_guidelines.md Section 8.2, finance_ml/ml_workflow/preprocessing/etl.py\n",
    "\n",
    "# IMPORTANT: ETL Data Explorer execution shows CSV as reliable source\n",
    "# Database connection fails consistently - prioritize CSV fallback\n",
    "\n",
    "DB_URL = os.getenv('DB_URL', 'postgresql+psycopg2://postgres:@localhost:5432/postgres')\n",
    "FINANCIAL_METRICS_OUTPUT_DIR = Path(\"outputs/eda/financial_metrics\")\n",
    "FINANCIAL_METRICS_OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Expected output from ETL Data Explorer execution:\n",
    "# - Stocks: 6,957\n",
    "# - Preprocessed columns: 363 (from ETL pipeline)\n",
    "# - Feature engineered columns: 582 (after build_features)\n",
    "# - Enhanced columns: 585 (with additional financial metrics)\n",
    "# - Phase 9.3 coverage: 182/196 features (92.9%)\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"ETL PIPELINE EXECUTION (Phase 9.1)\")\n",
    "print(\"=\" * 70)\n",
    "print(f\"Expected imputation: 6-step strategy, 0 missing values\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "try:\n",
    "    # Primary: Load from CSV (reliable per ETL Data Explorer)\n",
    "    print(\"\\n📂 Loading from CSV (primary source)...\")\n",
    "    all_stocks_preprocessed, etl_metrics = etl_with_features(\n",
    "            source='csv',\n",
    "            data_dir=Path(\"data\"),\n",
    "            feature_preset='comprehensive',  # Phase 9.3 features (196 features)\n",
    "            return_metrics=True\n",
    "            )\n",
    "    print(f\"✓ Loaded from CSV: {len(all_stocks_preprocessed):,} stocks\")\n",
    "\n",
    "except Exception as csv_error:\n",
    "    print(f\"⚠ CSV load failed: {csv_error}\")\n",
    "    print(\"\\nAttempting database fallback...\")\n",
    "\n",
    "    try:\n",
    "        # Fallback: Try database\n",
    "        all_stocks_preprocessed, etl_metrics = etl_with_features(\n",
    "                source='all_stocks',\n",
    "                db_url=DB_URL,\n",
    "                feature_preset='comprehensive',  # Phase 9.3 features (196 features)\n",
    "                return_metrics=True\n",
    "                )\n",
    "        print(f\"✓ Loaded from database: {len(all_stocks_preprocessed):,} stocks\")\n",
    "\n",
    "    except Exception as db_error:\n",
    "        print(f\"✗ Both CSV and database loading failed!\")\n",
    "        print(f\"   CSV error: {csv_error}\")\n",
    "        print(f\"   DB error: {db_error}\")\n",
    "        raise RuntimeError(\"ETL pipeline failed on all data sources\")\n",
    "\n",
    "# Display comprehensive ETL metrics\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"ETL PIPELINE METRICS\")\n",
    "print(\"=\" * 70)\n",
    "print(etl_metrics.summary())\n",
    "print(\"=\" * 70)\n",
    "\n",
    "# Critical validation: Imputation completeness (code_guidelines.md Section 8.5.2)\n",
    "assert etl_metrics.imputation_completeness, \"✗ Imputation incomplete!\"\n",
    "\n",
    "# Post-ETL Validation Checkpoint (code_guidelines.md Section 19.1)\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"POST-ETL VALIDATION CHECKPOINT (Section 19.1)\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "# Required assertions per code_guidelines.md Section 19.1\n",
    "assert not all_stocks_preprocessed.empty, \"✗ DataFrame must not be empty after ETL\"\n",
    "print(\"✓ DataFrame non-empty check passed\")\n",
    "\n",
    "# Critical columns presence check\n",
    "required_columns = ['ticker', 'sector', 'last_price']\n",
    "missing_required = [col for col in required_columns if col not in all_stocks_preprocessed.columns]\n",
    "assert len(missing_required) == 0, f\"✗ Missing critical columns: {missing_required}\"\n",
    "print(f\"✓ Critical columns present: {required_columns}\")\n",
    "\n",
    "# Target column check (price_target or fallback)\n",
    "has_target = TARGET_COL in all_stocks_preprocessed.columns\n",
    "has_fallback = TARGET_COL_FALLBACK in all_stocks_preprocessed.columns\n",
    "assert has_target or has_fallback, f\"✗ Missing target column: {TARGET_COL} (and fallback {TARGET_COL_FALLBACK})\"\n",
    "target_used = TARGET_COL if has_target else TARGET_COL_FALLBACK\n",
    "print(f\"✓ Target column available: {target_used}\")\n",
    "\n",
    "# No missing values after imputation (critical requirement)\n",
    "missing_after_etl = all_stocks_preprocessed.isna().sum().sum()\n",
    "assert missing_after_etl == 0, f\"✗ {missing_after_etl} missing values remain after 6-step imputation\"\n",
    "print(\"✓ Zero missing values confirmed (6-step imputation complete)\")\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"✓ All Post-ETL validations passed (Section 19.1 compliant)\")\n",
    "print(\"=\" * 70)"
   ],
