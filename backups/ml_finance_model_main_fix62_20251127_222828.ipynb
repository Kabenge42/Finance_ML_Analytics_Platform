    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"# Stage 4: Semantic-aware preprocessing with log-transforms and selective winsorization\\\\n\\\",\\n\",\n",
    "    \"    \\\"# NEW v1.7: Implements code_guidelines.md Section 8.5 (Preprocessing Stage Naming)\\\\n\\\",\\n\",\n",
    "    \"    \\\"# - Step 1: Log-transform skewed market value columns (market_cap, revenue, total_assets)\\\\n\\\",\\n\",\n",
    "    \"    \\\"# - Step 2: Selective winsorization (excludes price, ratio, percentage columns)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"from finance_ml.ml_workflow.preprocessing.transforms import apply_log_transforms\\\\n\\\",\\n\",\n",
    "    \"    \\\"from finance_ml.ml_workflow.preprocessing.column_semantics import get_winsorizable_columns, PRICE_COLUMNS\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"\\\\\\\\n  Step 2: Applying semantic-aware winsorization...\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# FIX: Use 'all_stocks_typed' (the standard output from Step 1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"# instead of the undefined 'all_stocks_log_transformed'.\\\\n\\\",\\n\",\n",
    "    \"    \\\"winsorizable_cols = get_winsorizable_columns(all_stocks_typed.columns.tolist())\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Safety Rail: Filter to ensure only numeric columns are winsorized\\\\n\\\",\\n\",\n",
    "    \"    \\\"# This prevents the TypeError when attempting to clip categorical columns like 'sector'\\\\n\\\",\\n\",\n",
    "    \"    \\\"winsorizable_cols = [\\\\n\\\",\\n\",\n",
    "    \"    \\\"    c for c in winsorizable_cols\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if pd.api.types.is_numeric_dtype(all_stocks_typed[c])\\\\n\\\",\\n\",\n",
    "    \"    \\\"    ]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"all_stocks_winsorized = winsorize_by_sector(\\\\n\\\",\\n\",\n",
    "    \"    \\\"        all_stocks_typed,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        columns=winsorizable_cols,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        lower_percentile=WINSORIZE_LOWER,  # From configuration constants\\\\n\\\",\\n\",\n",
    "    \"    \\\"        upper_percentile=WINSORIZE_UPPER,  # From configuration constants\\\\n\\\",\\n\",\n",
    "    \"    \\\"        by_sector=True,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        exclude_price_columns=True,  # CRITICAL: Preserve price interpretability\\\\n\\\",\\n\",\n",
    "    \"    \\\"        exclude_ratio_columns=True  # Pre-normalized ratios don't need winsorization\\\\n\\\",\\n\",\n",
    "    \"    \\\"        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"  ✓ Winsorized {len(winsorizable_cols)} columns (sector-specific)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Verify ALL 21 price columns unchanged (code_guidelines.md Section 8.5.2)\\\\n\\\",\\n\",\n",
    "    \"    \\\"# PRICE_COLUMNS includes: current (6), historical (9), 52w bounds (2), EMAs (4)\\\\n\\\",\\n\",\n",
    "    \"    \\\"price_cols_present = [c for c in PRICE_COLUMNS if c in all_stocks_winsorized.columns]\\\\n\\\",\\n\",\n",
    "    \"    \\\"for col in price_cols_present:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if col in all_stocks_typed.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        assert all_stocks_winsorized[col].equals(all_stocks_typed[col]), f\\\\\\\"{col} was incorrectly modified!\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"  ✓ Verified {len(price_cols_present)}/21 price columns preserved (business metric protection)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Verify integer columns were converted to float64 (Int64 TypeError fix)\\\\n\\\",\\n\",\n",
    "    \"    \\\"int_cols_before = [c for c in winsorizable_cols if pd.api.types.is_integer_dtype(all_stocks_typed[c])]\\\\n\\\",\\n\",\n",
    "    \"    \\\"if int_cols_before:\\\\n\\\",\\n\",\n",
