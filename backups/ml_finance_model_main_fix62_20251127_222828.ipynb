    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# 2. Prepare All Data for Prediction\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"\\\\\\\\n[INFO] Preprocessing all_stocks_features for prediction...\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"prep_params = {\\\\n\\\",\\n\",\n",
    "    \"    \\\"    'cat_cols': categorical_columns_from_schema,\\\\n\\\",\\n\",\n",
    "    \"    \\\"    'date_cols': datetime_cols_from_schema,\\\\n\\\",\\n\",\n",
