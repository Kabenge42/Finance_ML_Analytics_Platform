    "valuation_present = [c for c in EXPECTED_VALUATION_METRICS if c in available_cols]\n",
    "valuation_missing = [c for c in EXPECTED_VALUATION_METRICS if c not in available_cols]\n",
    "print(f\"  Valuation:     {len(valuation_present)}/{len(EXPECTED_VALUATION_METRICS)} available\")\n",
    "if valuation_missing:\n",
    "    print(f\"    Missing: {valuation_missing}\")\n",
