    "print(f'  Total Turnover: {backtest_results[\"turnover\"]:.2f}')\n",
    "\n",
    "# Walk-Forward Optimization\n",
    "print('\\n📊 Walk-Forward Optimization (Black-Litterman):')\n",
    "wfo_results = run_walk_forward_optimization(\n",
