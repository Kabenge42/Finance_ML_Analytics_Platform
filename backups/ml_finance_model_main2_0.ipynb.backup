    "# Per-Class Feature Importance Analysis (Optional Advanced Evaluation)\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"PER-CLASS FEATURE IMPORTANCE ANALYSIS\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\"\\n🔍 Analyzing feature importance by class...\")\n",
    "try:\n",
    "    class_importance = analyze_per_class_feature_importance(\n",
    "            cls_model, X_train_processed, y_train_cls,\n",
    "            feature_names=list(X_train_processed.columns),\n",
    "            top_n=15\n",
    "            )\n",
    "\n",
    "    # Handle both DataFrame (current API) and dict (legacy) return types\n",
    "    import pandas as _pd  # local alias to avoid shadowing\n",
    "\n",
    "    if isinstance(class_importance, dict):\n",
    "        if len(class_importance) == 0:\n",
    "            print(\"⚠️  Per-class feature importance returned empty\")\n",
    "        else:\n",
    "            print(f\"\\n✓ Per-class feature importance computed:\")\n",
    "            class_names = ['Strong Negative', 'Negative', 'Neutral', 'Positive', 'Strong Positive']\n",
    "            for class_idx, importance_dict in class_importance.items():\n",
    "                class_name = class_names[class_idx] if class_idx < len(class_names) else f\"Class {class_idx}\"\n",
    "                print(f\"\\n  {class_name} (Class {class_idx}):\")\n",
    "                if isinstance(importance_dict, dict):\n",
    "                    top_features = sorted(importance_dict.items(), key=lambda x: x[1], reverse=True)[:5]\n",
    "                    for feat, imp in top_features:\n",
    "                        print(f\"    {feat}: {imp:.4f}\")\n",
    "\n",
    "            # Save per-class importance\n",
    "            class_imp_path = OUTPUT_DIR / \"classification\" / \"per_class_feature_importance.json\"\n",
    "            with open(class_imp_path, 'w') as f:\n",
    "                json.dump({str(k): v for k, v in class_importance.items()}, f, indent=2, default=str)\n",
    "            print(f\"\\n💾 Per-class importance saved to: {class_imp_path}\")\n",
    "\n",
    "    elif isinstance(class_importance, _pd.DataFrame):\n",
    "        if class_importance.empty:\n",
    "            print(\"⚠️  Per-class feature importance returned empty\")\n",
    "        else:\n",
    "            print(f\"\\n✓ Per-class feature importance computed:\")\n",
    "            # Pretty print top features per class (up to 5)\n",
    "            class_names = ['Strong Negative', 'Negative', 'Neutral', 'Positive', 'Strong Positive']\n",
    "            # Determine how many to show (min of 5 and requested top_n)\n",
    "            _top_show = min(5, 15)\n",
    "            for class_label in sorted(class_importance['Class'].unique()):\n",
    "                # Try to map integer class labels to human-readable names if in range\n",
    "                try:\n",
    "                    idx = int(class_label)\n",
    "                except Exception:\n",
    "                    idx = None\n",
    "                class_name = (\n",
    "                    class_names[idx] if isinstance(idx, int) and 0 <= idx < len(class_names) else f\"Class {class_label}\"\n",
    "                )\n",
    "                print(f\"\\n  {class_name} (Class {class_label}):\")\n",
    "                _subset = class_importance[class_importance['Class'] == class_label]\n",
    "                _top = _subset.sort_values('Importance', ascending=False).head(_top_show)\n",
    "                for _, row in _top.iterrows():\n",
    "                    try:\n",
    "                        _imp = float(row['Importance'])\n",
    "                    except Exception:\n",
    "                        _imp = row['Importance']\n",
    "                    print(f\"    {row['Feature']}: {_imp:.4f}\" if isinstance(_imp,\n",
    "                                                                            float) else f\"    {row['Feature']}: {_imp}\")\n",
    "\n",
    "            # Save per-class importance as a dict of top-N per class\n",
    "            class_imp_path = OUTPUT_DIR / \"classification\" / \"per_class_feature_importance.json\"\n",
    "            save_dict = {}\n",
    "            for cl, grp in class_importance.groupby('Class'):\n",
    "                grp_sorted = grp.sort_values('Importance', ascending=False).head(15)\n",
    "                save_dict[str(cl)] = {str(r['Feature']): float(r['Importance']) for _, r in grp_sorted.iterrows()}\n",
    "            with open(class_imp_path, 'w') as f:\n",
    "                json.dump(save_dict, f, indent=2, default=str)\n",
    "            print(f\"\\n💾 Per-class importance saved to: {class_imp_path}\")\n",
    "    else:\n",
    "        print(\"⚠️  Per-class feature importance returned in an unexpected format; skipping display/save\")\n",
    "\n",
    "except Exception as e:\n",
    "    print(f\"⚠️  Per-class feature importance analysis failed: {str(e)}\")\n",
    "    print(\"  Continuing without per-class analysis\")\n"
   ],
