    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"from sklearn.metrics import accuracy_score\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"def _extract_model_feature_names(model, fallback_columns):\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\"\\\\\\\"Extract feature names from various model types (CatBoost, XGBoost, LightGBM).\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    feature_names = None\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if hasattr(model, 'feature_names_'):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        feature_names = model.feature_names_\\\\n\\\",\\n\",\n",
    "    \"    \\\"    elif hasattr(model, 'get_booster') and hasattr(model.get_booster(), 'feature_names'):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        feature_names = model.get_booster().feature_names\\\\n\\\",\\n\",\n",
    "    \"    \\\"    elif hasattr(model, 'feature_name_'):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        feature_names = model.feature_name_\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if feature_names is None:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(\\\\\\\"  [WARN] Model doesn't expose feature_names_, using fallback columns\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        feature_names = list(fallback_columns)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if not feature_names:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        raise ValueError(\\\\\\\"[ERROR] CRITICAL: Could not extract feature names from cls_model\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  [OK] Extracted {len(feature_names)} features from model\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    return feature_names\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"def _prepare_inference_data(df_raw, raw_train_columns, model_feature_names, prep_params):\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    Preprocess raw data and align exactly to model features for inference.\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    Args:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        df_raw: DataFrame containing all raw features\\\\n\\\",\\n\",\n",
    "    \"    \\\"        raw_train_columns: List of columns expected by the preprocessing pipeline (from training)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        model_feature_names: List of features expected by the trained model\\\\n\\\",\\n\",\n",
    "    \"    \\\"        prep_params: Dictionary containing encoders, reference_date, etc.\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # 1. Align raw columns to match training input structure\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # CRITICAL: Use .reindex() to ensure EXACT column match and order from X_train_cls\\\\n\\\",\\n\",\n",
    "    \"    \\\"    X_raw = df_raw.reindex(columns=raw_train_columns)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if X_raw.shape[1] != len(raw_train_columns):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        raise ValueError(\\\\\\\"Column count mismatch during raw alignment\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # 2. Apply preprocessing using training encoders (Inference Mode)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    X_processed, _ = preprocess_for_lightgbm(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            X_raw.copy(),\\\\n\\\",\\n\",\n",
    "    \"    \\\"            categorical_columns=prep_params['cat_cols'],\\\\n\\\",\\n\",\n",
    "    \"    \\\"            datetime_columns=prep_params['date_cols'],\\\\n\\\",\\n\",\n",
    "    \"    \\\"            drop_columns=prep_params['drop_cols'],\\\\n\\\",\\n\",\n",
    "    \"    \\\"            encoders=prep_params['encoders'],\\\\n\\\",\\n\",\n",
    "    \"    \\\"            reference_date=prep_params['ref_date']\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # 3. Align processed data to model schema (Handle missing/extra columns generated by OHE)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    missing_cols = set(model_feature_names) - set(X_processed.columns)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    extra_cols = set(X_processed.columns) - set(model_feature_names)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if missing_cols:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"  [WARN] Filling {len(missing_cols)} missing columns with 0\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        for col in missing_cols:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            X_processed[col] = 0\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if extra_cols:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"  [WARN] Dropping {len(extra_cols)} extra columns\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        X_processed = X_processed.drop(columns=list(extra_cols))\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # 4. Final reorder to match model expectation\\\\n\\\",\\n\",\n",
    "    \"    \\\"    return X_processed[model_feature_names]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# --- Main Execution ---\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Use optimized model from hyperparameter search\\\\n\\\",\\n\",\n",
    "    \"    \\\"cls_model = result['model']\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# 1. Get Model Feature Names\\\\n\\\",\\n\",\n",
