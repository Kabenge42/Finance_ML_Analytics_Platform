    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Vectorized Backtest\\\\n\\\",\\n\",\n",
    "    \"    \\\"print('\\\\\\\\n📊 Vectorized Backtest (Max Sharpe, Monthly Rebalance):')\\\\n\\\",\\n\",\n",
    "    \"    \\\"backtest_results = run_vectorized_backtest(\\\\n\\\",\\n\",\n",
