                        ))

        fig_sector_dist.update_layout(
                title='Phase 9.2: Market Cap Distribution by Sector',
                yaxis_title='Market Cap',
                yaxis_type='log',
                height=600,
                showlegend=True
                )
        fig_sector_dist.show()
        fig_sector_dist.write_html(eda_output_dir / "phase92_sector_marketcap_dist.html")
