    "    \"    \\\"# This ensures interaction features align with the semantics of the chosen event labeling method\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Fallback to default list if valuation_cols_method_aware is not defined\\\\n\\\",\\n\",\n",
