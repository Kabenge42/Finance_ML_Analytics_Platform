    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                # Billions scale (absolute currency amounts)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                is_normalized = False\\\\n\\\",\\n\",\n",
    "    \"    \\\"                min_mc_threshold = 0.5  # $0.5B = $500M minimum\\\\n\\\",\\n\",\n",
    "    \"    \\\"                cap_unit = 'B'\\\\n\\\",\\n\",\n",
    "    \"    \\\"                display_scale = 1e9\\\\n\\\",\\n\",\n",
    "    \"    \\\"                display_unit = 'B'\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(f'    ✓ Market cap is in BILLIONS (B) - raw values')\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(f'    Range: ${mc_min / display_scale:.2f}B to ${mc_max / display_scale:.2f}B')\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(f'    Median: ${mc_p50 / display_scale:.2f}B')\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(f'    95th percentile: ${mc_p95 / display_scale:.2f}B')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Validation checkpoint (code_guidelines.md Section 8.2 & 8.5)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Only validate raw values; scaled data can be negative (centered around mean)\\\\n\\\",\\n\",\n",
