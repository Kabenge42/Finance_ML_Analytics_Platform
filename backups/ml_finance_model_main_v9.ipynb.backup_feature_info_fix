    "def train_ensemble_models(X_train: pd.DataFrame, X_test: pd.DataFrame,\n",
    "                          y_train: pd.Series, y_test: pd.Series,\n",
    "                          feature_cols: List[str], target_col: str,\n",
    "                          cv_folds: int, random_state: int,\n",
    "                          out_dir: Path) -> Tuple[Optional[object], Optional[np.ndarray]]:\n",
    "    \"\"\"Step 5: Build stacking ensemble.\"\"\"\n",
    "    print(\"\\n\ud83c\udfd7 Step 5: Building stacking ensemble...\")\n",
    "\n",
    "    stacking_model, stacking_results = train_stacking_regressor(            X=X_train,            y=y_train,            cv=cv_folds,            random_state=random_state,            ensure_nonnegative=True,            loss=\"huber\"            )\n",
    "    if stacking_model is None:\n",
    "        print(\"\u26a0 Stacking ensemble training failed\")\n",
    "        return None, None\n",
    "\n",
    "    y_pred_stacking = np.maximum(stacking_model.predict(X_test), 0)\n",
    "\n",
    "    # Evaluate\n",
    "    mae = mean_absolute_error(y_test, y_pred_stacking)\n",
    "    rmse = np.sqrt(mean_squared_error(y_test, y_pred_stacking))\n",
    "    r2 = r2_score(y_test, y_pred_stacking)\n",
    "\n",
    "    print(f\"\u2713 Stacking Ensemble Performance:\")\n",
    "    print(f\"  Train Score: {stacking_results.get('train_score', 0):.4f}\")\n",
    "    print(f\"  CV Score: {stacking_results.get('cv_score', 0):.4f}\")\n",
    "    print(f\"  Test MAE: {mae:.2f}\")\n",
    "    print(f\"  Test RMSE: {rmse:.2f}\")\n",
    "    print(f\"  Test R\u00b2: {r2:.4f}\")\n",
    "\n",
    "    # Save model\n",
    "    metadata = {\n",
    "        'model_type': 'stacking_ensemble',\n",
    "        'features': feature_cols,\n",
    "        'target': target_col,\n",
    "        'date_trained': datetime.now().strftime('%Y-%m-%d'),\n",
    "        'phase': '9.5',\n",
    "        'train_score': stacking_results.get('train_score', 0),\n",
    "        'cv_score': stacking_results.get('cv_score', 0),\n",
    "        'test_score': r2,\n",
    "        'test_mae': mae,\n",
    "        'test_rmse': rmse\n",
    "        }\n",
    "\n",
    "    model_path = out_dir / 'stacking_ensemble_phase95.joblib'\n",
    "    save_model(stacking_model, str(model_path), metadata=metadata)\n",
    "    print(f\"\u2713 Stacking model saved: {model_path}\")\n",
    "\n",
    "    return stacking_model, y_pred_stacking\n",
    "\n",
