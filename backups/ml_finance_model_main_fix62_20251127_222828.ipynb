    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"## Workflow Overview (10 Steps)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"1. **Configuration and Setup** — Initialize environment and configuration\\\\n\\\",\\n\",\n",
