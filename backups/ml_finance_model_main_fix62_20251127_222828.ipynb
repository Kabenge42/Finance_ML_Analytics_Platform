    "    \"   \\\"cell_type\\\": \\\"code\\\",\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"# Visualization 4: Category Distribution Box Plots\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"\\\\\\\\n📊 Category Distribution Box Plots:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Create box plots for each category showing distribution across sectors\\\\n\\\",\\n\",\n",
    "    \"    \\\"if 'category_score_matrix' in locals() and not category_score_matrix.empty:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Add sector information to category scores\\\\n\\\",\\n\",\n",
    "    \"    \\\"    category_scores_with_sector = category_score_matrix.copy()\\\\n\\\",\\n\",\n",
    "    \"    \\\"    category_scores_with_sector['sector'] = all_stocks_scaled['sector'].values\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Create subplot grid for all categories\\\\n\\\",\\n\",\n",
    "    \"    \\\"    from plotly.subplots import make_subplots\\\\n\\\",\\n\",\n",
    "    \"    \\\"    import math\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    categories = [col for col in category_score_matrix.columns]\\\\n\\\",\\n\",\n",
    "    \"    \\\"    n_categories = len(categories)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    n_cols = 2\\\\n\\\",\\n\",\n",
    "    \"    \\\"    n_rows = math.ceil(n_categories / n_cols)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_box = make_subplots(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            rows=n_rows,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            cols=n_cols,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            subplot_titles=categories,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            vertical_spacing=0.2,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            horizontal_spacing=0.1\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for idx, category in enumerate(categories):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        row = idx // n_cols + 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"        col = idx % n_cols + 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Create box plot data for this category\\\\n\\\",\\n\",\n",
    "    \"    \\\"        for sector in category_scores_with_sector['sector'].unique():\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if pd.notna(sector):\\\\n\\\",\\n\",\n",
    "    \"    \\\"                sector_data = category_scores_with_sector[\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    category_scores_with_sector['sector'] == sector\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    ][category].dropna()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                fig_box.add_trace(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        go.Box(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                                y=sector_data,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                                name=sector,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                                showlegend=(idx == 0),  # Only show legend for first subplot\\\\n\\\",\\n\",\n",
    "    \"    \\\"                                marker_color=px.colors.qualitative.Plotly[\\\\n\\\",\\n\",\n",
    "    \"    \\\"                                    list(category_scores_with_sector['sector'].unique()).index(sector) % 10\\\\n\\\",\\n\",\n",
    "    \"    \\\"                                    ]\\\\n\\\",\\n\",\n",
    "    \"    \\\"                                ),\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        row=row,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        col=col\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_box.update_layout(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            title_text=\\\\\\\"Category Score Distributions by Sector (Phase 9.3)\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"            height=300 * n_rows,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            showlegend=True\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_box.update_yaxes(title_text=\\\\\\\"Z-Score\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_box.show()\\\\n\\\",\\n\",\n",
    "    \"    \\\"    output_path = eda_output_dir / \\\\\\\"phase93_category_distributions_boxplots.html\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_box.write_html(output_path)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"\\\\\\\\n✓ Category distribution box plots complete\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  Categories visualized: {n_categories}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  Grid layout: {n_rows}×{n_cols}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  Output: {output_path}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Identify categories with highest variance\\\\n\\\",\\n\",\n",
    "    \"    \\\"    category_variances = category_score_matrix.var().sort_values(ascending=False)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"\\\\\\\\n  📊 Categories with Highest Variance:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for category, variance in category_variances.head(5).items():\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"    {category}: {variance:.2f}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(\\\\\\\"  ⚠️ No category score data available for box plots\\\\\\\")\\\\n\\\"\\n\",\n",
    "    \"   ],\\n\",\n",
