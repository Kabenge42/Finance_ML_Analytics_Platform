    "        present_features = [f for f in PHASE93_FEATURE_CATEGORIES[category] if f in all_stocks_features.columns]\n",
    "\n",
    "        # Take first 4 features for visualization\n",
    "        viz_features = present_features[:4]\n",
    "\n",
    "        if viz_features:\n",
