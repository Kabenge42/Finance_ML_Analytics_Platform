    "# ============================================================================\n",
    "\n",
    "from finance_ml.ml_workflow.preprocessing.column_semantics import classify_columns\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"SEMANTIC TRANSFORMATION VALIDATION\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "# Classify columns by semantic category\n",
    "semantic_classification = classify_columns(all_stocks_preprocessed.columns.tolist())\n",
    "\n",
    "print(\"\\nColumn Classification by Semantic Category:\")\n",
    "for category, columns in semantic_classification.items():\n",
    "    if columns:\n",
    "        print(f\"\\n{category.upper()} ({len(columns)} columns):\")\n",
    "        for col in columns[:5]:  # Show first 5 of each category\n",
    "            print(f\"  - {col}\")\n",
    "        if len(columns) > 5:\n",
    "            print(f\"  ... and {len(columns) - 5} more\")\n",
    "\n",
    "# Verify log-transformed market value columns\n",
    "log_transformed = [c for c in all_stocks_preprocessed.columns if c.startswith('log_')]\n",
    "print(f\"\\n\\nLog-Transformed Columns: {len(log_transformed)}\")\n",
    "for col in log_transformed[:10]:  # Show first 10\n",
    "    non_null = all_stocks_preprocessed[col].notna().sum()\n",
    "    print(f\"  - {col}: {non_null:,} non-null values\")\n",
    "\n",
    "print(\"\\n✓ Semantic transformation validation complete\")\n",
    "print(\"=\" * 70)"
