    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Final check after fallback\\\\n\\\",\\n\",\n",
    "    \"    \\\"        nan_final = all_stocks_enhanced.isna().sum().sum()\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"\\\\\\\\n  Remaining NaN after fallback: {nan_final:,}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if nan_final > 0:\\\\n\\\",\\n\",\n",
