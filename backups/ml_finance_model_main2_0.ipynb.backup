    "### 6.3.3 Gradient Boosting Models Comparison\n",
    "Compare gradient boosting models (XGBoost, LightGBM, CatBoost, HistGradientBoosting)."
   ],
   "id": "6d9638e26cb60fbd"
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-12-07T16:53:44.158410Z",
     "start_time": "2025-12-07T03:09:14.048176Z"
    }
   },
   "cell_type": "code",
   "source": [
    "# ============================================================================\n",
    "# PHASE 9.5: Gradient Boosting Models Comparison\n",
    "# ============================================================================\n",
    "print(\"=\" * 80)\n",
    "print(\"PHASE 9.5: GRADIENT BOOSTING MODELS COMPARISON\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "if 'X_train' not in dir() or 'y_train' not in dir():\n",
    "    print(\"⚠️  Training data not prepared. Run Section 6.2 first.\")\n",
    "else:\n",
    "    from finance_ml.ml_workflow.regression.models import (\n",
    "        train_xgboost_regressor,\n",
    "        train_lightgbm_regressor,\n",
    "        train_catboost_regressor,\n",
    "        train_histgb_regressor,\n",
    "        )\n",
    "\n",
    "    gb_results = {}\n",
    "\n",
    "\n",
    "    def get_metric(result, metric_name='r2_score', default=0.0):\n",
    "        \"\"\"Safely extract a metric (e.g., r2_score, mae) from varied return types.\n",
    "\n",
    "        Supports:\n",
    "        - (model, metrics_dict)\n",
    "        - (metrics_dict, model)\n",
    "        - metrics dict\n",
    "        - raw numeric\n",
    "        Any other type returns default.\n",
    "        \"\"\"\n",
    "        # Numeric straight away\n",
    "        if isinstance(result, (int, float)):\n",
    "            return float(result)\n",
    "\n",
    "        # Tuple/list returns from trainers\n",
    "        if isinstance(result, (tuple, list)):\n",
    "            if len(result) == 2:\n",
    "                a, b = result\n",
    "                metrics = a if isinstance(a, dict) else (b if isinstance(b, dict) else None)\n",
    "                if isinstance(metrics, dict):\n",
    "                    key_mapping = {\n",
    "                        'r2_score': ['r2_score', 'train_score', 'test_score'],\n",
    "                        'mae': ['mae', 'mean_absolute_error'],\n",
    "                        'rmse': ['rmse', 'root_mean_squared_error'],\n",
    "                        }\n",
    "                    for key in key_mapping.get(metric_name, [metric_name]):\n",
    "                        if key in metrics and isinstance(metrics[key], (int, float)):\n",
    "                            return float(metrics[key])\n",
    "                    # Attempt coercion if present but not numeric\n",
    "                    for key in key_mapping.get(metric_name, [metric_name]):\n",
    "                        if key in metrics:\n",
    "                            try:\n",
    "                                return float(metrics[key])\n",
    "                            except Exception:\n",
    "                                return default\n",
    "                return default\n",
    "            return default\n",
    "\n",
    "        # Dict of metrics\n",
    "        if isinstance(result, dict):\n",
    "            key_mapping = {\n",
    "                'r2_score': ['r2_score', 'train_score', 'test_score'],\n",
    "                'mae': ['mae', 'mean_absolute_error'],\n",
    "                'rmse': ['rmse', 'root_mean_squared_error'],\n",
    "                }\n",
    "            for key in key_mapping.get(metric_name, [metric_name]):\n",
    "                if key in result and isinstance(result[key], (int, float)):\n",
    "                    return float(result[key])\n",
    "            for key in key_mapping.get(metric_name, [metric_name]):\n",
    "                if key in result:\n",
    "                    try:\n",
    "                        return float(result[key])\n",
    "                    except Exception:\n",
    "                        return default\n",
    "            return default\n",
    "\n",
    "        # Fallback\n",
    "        return default\n",
    "\n",
    "\n",
    "    # 1. XGBoost\n",
    "    print(\"\\n🚀 Training XGBoost Regressor...\")\n",
    "    try:\n",
    "        xgb_result = train_xgboost_regressor(\n",
    "                X_train, y_train,\n",
    "                params={'n_estimators': 100, 'max_depth': 6, 'learning_rate': 0.1},\n",
    "                random_state=RANDOM_SEED\n",
    "                )\n",
    "        gb_results['XGBoost'] = xgb_result\n",
    "        score = get_metric(xgb_result, 'r2_score')\n",
    "        try:\n",
    "            print(f\"   R² Score: {score:.4f}\")\n",
    "        except Exception:\n",
    "            print(f\"   R² Score: {score}\")\n",
    "    except Exception as e:\n",
    "        print(f\"   ⚠️ XGBoost failed: {e}\")\n",
    "\n",
    "    # 2. LightGBM\n",
    "    print(\"\\n🚀 Training LightGBM Regressor...\")\n",
    "    try:\n",
    "        lgb_result = train_lightgbm_regressor(\n",
    "                X_train, y_train,\n",
    "                params={'n_estimators': 100, 'max_depth': 6, 'learning_rate': 0.1},\n",
    "                random_state=RANDOM_SEED\n",
    "                )\n",
    "        gb_results['LightGBM'] = lgb_result\n",
    "        score = get_metric(lgb_result, 'r2_score')\n",
    "        try:\n",
    "            print(f\"   R² Score: {score:.4f}\")\n",
    "        except Exception:\n",
    "            print(f\"   R² Score: {score}\")\n",
    "    except Exception as e:\n",
    "        print(f\"   ⚠️ LightGBM failed: {e}\")\n",
    "\n",
    "    # 3. CatBoost\n",
    "    print(\"\\n🚀 Training CatBoost Regressor...\")\n",
    "    try:\n",
    "        cb_result = train_catboost_regressor(\n",
    "                X_train, y_train,\n",
    "                params={'iterations': 100, 'depth': 6, 'learning_rate': 0.1},\n",
    "                random_state=RANDOM_SEED\n",
    "                )\n",
    "        gb_results['CatBoost'] = cb_result\n",
    "        score = get_metric(cb_result, 'r2_score')\n",
    "        try:\n",
    "            print(f\"   R² Score: {score:.4f}\")\n",
    "        except Exception:\n",
    "            print(f\"   R² Score: {score}\")\n",
    "    except Exception as e:\n",
    "        print(f\"   ⚠️ CatBoost failed: {e}\")\n",
    "\n",
    "    # 4. HistGradientBoosting\n",
    "    print(\"\\n🚀 Training HistGradientBoosting Regressor...\")\n",
    "    try:\n",
    "        hgb_result = train_histgb_regressor(\n",
    "                X_train, y_train,\n",
    "                max_iter=100,\n",
    "                max_depth=6,\n",
    "                random_state=RANDOM_SEED\n",
    "                )\n",
    "        gb_results['HistGradientBoosting'] = hgb_result\n",
    "        score = get_metric(hgb_result, 'r2_score')\n",
    "        try:\n",
    "            print(f\"   R² Score: {score:.4f}\")\n",
    "        except Exception:\n",
    "            print(f\"   R² Score: {score}\")\n",
    "    except Exception as e:\n",
    "        print(f\"   ⚠️ HistGradientBoosting failed: {e}\")\n",
    "\n",
    "    # Summary comparison\n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(\"GRADIENT BOOSTING MODELS SUMMARY\")\n",
    "    print(\"=\" * 60)\n",
    "    for name, result in gb_results.items():\n",
    "        score = get_metric(result, 'r2_score')\n",
    "        mae = get_metric(result, 'mae', default=float('nan'))\n",
    "        # Prefer printing MAE only if we have a valid numeric value\n",
    "        try:\n",
    "            if mae == mae:  # check for not-NaN\n",
    "                print(f\"  {name:20s}: R² = {score:.4f}, MAE = {mae:.4f}\")\n",
    "            else:\n",
    "                print(f\"  {name:20s}: R² = {score:.4f}\")\n",
    "        except Exception:\n",
    "            # Fallback without format specifiers\n",
    "            if mae == mae:\n",
    "                print(f\"  {name:20s}: R² = {score}, MAE = {mae}\")\n",
    "            else:\n",
    "                print(f\"  {name:20s}: R² = {score}\")\n",
    "\n",
    "    if gb_results:\n",
    "        best_gb = max(gb_results.items(), key=lambda kv: get_metric(kv[1], 'r2_score'))\n",
    "        print(f\"\\n🏆 Best Gradient Boosting Model: {best_gb[0]}\")\n",
    "\n",
    "    print(\"\\n✓ Gradient boosting models comparison complete\")\n"
   ],
