    "    \"   \\\"cell_type\\\": \\\"code\\\",\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"# 📄 Comprehensive Report Generation - Excel, PDF, HTML\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"\\\\\\\\n📄 Generating Comprehensive Reports...\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Import eval functions for reporting\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Updated path: eval.py moved to analytics/eval.py (Phase 9.7)\\\\n\\\",\\n\",\n",
    "    \"    \\\"from finance_ml.ml_workflow.analytics.eval import generate_enhanced_pdf_report\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# 1. Excel Report with Multiple Sheets - Enhanced with comprehensive formatting\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"  Creating Excel report with multiple sheets...\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"excel_path = reports_dir / \\\\\\\"comprehensive_analysis_report.xlsx\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"with pd.ExcelWriter(excel_path, engine='xlsxwriter') as writer:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    workbook = writer.book\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Define formats for comprehensive number formatting (2 decimal places)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    number_format = workbook.add_format({'num_format': '0.00'})\\\\n\\\",\\n\",\n",
    "    \"    \\\"    percent_format = workbook.add_format({'num_format': '0.00%'})\\\\n\\\",\\n\",\n",
    "    \"    \\\"    integer_format = workbook.add_format({'num_format': '#,##0'})\\\\n\\\",\\n\",\n",
    "    \"    \\\"    large_number_format = workbook.add_format({'num_format': '#,##0.00'})\\\\n\\\",\\n\",\n",
    "    \"    \\\"    header_format = workbook.add_format({\\\\n\\\",\\n\",\n",
    "    \"    \\\"        'bold': True,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        'bg_color': '#4472C4',\\\\n\\\",\\n\",\n",
    "    \"    \\\"        'font_color': 'white',\\\\n\\\",\\n\",\n",
    "    \"    \\\"        'border': 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"        })\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Helper function to apply comprehensive number formatting\\\\n\\\",\\n\",\n",
    "    \"    \\\"    def apply_number_formatting(worksheet, df):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"\\\\\\\"\\\\\\\"Apply 2-decimal formatting to all numerical columns\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        for col_idx, col in enumerate(df.columns):\\\\n\\\",\\n\",\n",
    "    \"    \\\"            col_lower = col.lower()\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Set column width for readability\\\\n\\\",\\n\",\n",
    "    \"    \\\"            worksheet.set_column(col_idx, col_idx, 15)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if df[col].dtype in ['float64', 'float32', 'int64', 'int32']:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                # Apply appropriate format based on column type\\\\n\\\",\\n\",\n",
    "    \"    \\\"                if 'pct' in col_lower or 'percent' in col_lower or 'mispricing_pct' == col:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    worksheet.set_column(col_idx, col_idx, 12, percent_format)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                elif 'market_cap' in col_lower or 'total_' in col_lower:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    worksheet.set_column(col_idx, col_idx, 15, large_number_format)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                elif 'count' in col_lower or 'num_' in col_lower:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    worksheet.set_column(col_idx, col_idx, 12, integer_format)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    worksheet.set_column(col_idx, col_idx, 12, number_format)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Helper function to add conditional formatting for key metrics\\\\n\\\",\\n\",\n",
    "    \"    \\\"    def add_conditional_formatting(worksheet, df, column_name):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"\\\\\\\"\\\\\\\"Add 3-color scale conditional formatting to specified column\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if column_name in df.columns and len(df) > 0:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            col_idx = df.columns.get_loc(column_name)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            worksheet.conditional_format(1, col_idx, len(df), col_idx, {\\\\n\\\",\\n\",\n",
    "    \"    \\\"                'type': '3_color_scale',\\\\n\\\",\\n\",\n",
    "    \"    \\\"                'min_color': '#F8696B',  # Red for negative/low\\\\n\\\",\\n\",\n",
    "    \"    \\\"                'mid_color': '#FFEB84',  # Yellow for neutral\\\\n\\\",\\n\",\n",
    "    \"    \\\"                'max_color': '#63BE7B'  # Green for positive/high\\\\n\\\",\\n\",\n",
    "    \"    \\\"                })\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Sheet 1: Top Undervalued Stocks\\\\n\\\",\\n\",\n",
    "    \"    \\\"    top_undervalued.to_excel(writer, sheet_name='Top_Undervalued', index=False)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    worksheet_under = writer.sheets['Top_Undervalued']\\\\n\\\",\\n\",\n",
    "    \"    \\\"    apply_number_formatting(worksheet_under, top_undervalued)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    add_conditional_formatting(worksheet_under, top_undervalued, 'mispricing_score')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Add conditional formatting for additional key columns\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for col in ['last_price', 'price_target', 'predicted_price_target']:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if col in top_undervalued.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            add_conditional_formatting(worksheet_under, top_undervalued, col)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Sheet 2: Top Overvalued Stocks\\\\n\\\",\\n\",\n",
    "    \"    \\\"    top_overvalued.to_excel(writer, sheet_name='Top_Overvalued', index=False)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    worksheet_over = writer.sheets['Top_Overvalued']\\\\n\\\",\\n\",\n",
    "    \"    \\\"    apply_number_formatting(worksheet_over, top_overvalued)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    add_conditional_formatting(worksheet_over, top_overvalued, 'mispricing_score')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Add conditional formatting for additional key columns\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for col in ['last_price', 'price_target', 'predicted_price_target']:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if col in top_overvalued.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            add_conditional_formatting(worksheet_over, top_overvalued, col)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Sheet 3: All Predictions\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Export ALL columns from all_stocks_phase95 for comprehensive dashboard usage\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # This includes all analytical columns from Sections 7-9:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # - prediction_error, prediction_error_pct (Section 7)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # - mispricing_pct, mispricing_score (Section 8)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # - model_analyst_diff_pct (Section 9)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # - Plus all original financial metrics (p_e, p_b, roe, etc.)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    predictions_export = all_stocks_phase95.copy()\\\\n\\\",\\n\",\n",
    "    \"    \\\"    predictions_export.to_excel(writer, sheet_name='All_Predictions', index=False)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    worksheet_pred = writer.sheets['All_Predictions']\\\\n\\\",\\n\",\n",
    "    \"    \\\"    apply_number_formatting(worksheet_pred, predictions_export)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    add_conditional_formatting(worksheet_pred, predictions_export, 'mispricing_score')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Add conditional formatting for price columns\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for col in ['last_price', 'price_target', 'predicted_price_target', 'market_cap']:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if col in predictions_export.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            add_conditional_formatting(worksheet_pred, predictions_export, col)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Sheet 4: Sector Summary\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if sector_summary is not None:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        sector_summary.to_excel(writer, sheet_name='Sector_Summary', index=False)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        worksheet_sector = writer.sheets['Sector_Summary']\\\\n\\\",\\n\",\n",
    "    \"    \\\"        apply_number_formatting(worksheet_sector, sector_summary)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Add conditional formatting for sector performance metrics\\\\n\\\",\\n\",\n",
    "    \"    \\\"        for col in ['avg_mispricing', 'total_market_cap']:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            add_conditional_formatting(worksheet_sector, sector_summary, col)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Sheet 5: Model Metrics (if available)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if 'test_metrics' in locals() and test_metrics:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        metrics_df = pd.DataFrame([test_metrics])\\\\n\\\",\\n\",\n",
    "    \"    \\\"        metrics_df.to_excel(writer, sheet_name='Model_Metrics', index=False)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        worksheet_metrics = writer.sheets['Model_Metrics']\\\\n\\\",\\n\",\n",
    "    \"    \\\"        apply_number_formatting(worksheet_metrics, metrics_df)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Add conditional formatting for R² and MAE\\\\n\\\",\\n\",\n",
    "    \"    \\\"        for col in ['r2', 'mae', 'rmse', 'mape']:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            add_conditional_formatting(worksheet_metrics, metrics_df, col)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Sheet 6: Visualizations - Insert PNG images\\\\n\\\",\\n\",\n",
    "    \"    \\\"    worksheet_viz = workbook.add_worksheet('Visualizations')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    row_offset = 0\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # List of PNG files to insert with corresponding sections\\\\n\\\",\\n\",\n",
    "    \"    \\\"    png_files = [\\\\n\\\",\\n\",\n",
    "    \"    \\\"        ('prediction_scatter_interactive.png', 'Predicted vs Actual Price Targets'),\\\\n\\\",\\n\",\n",
    "    \"    \\\"        ('residual_analysis_interactive.png', 'Residual Analysis'),\\\\n\\\",\\n\",\n",
    "    \"    \\\"        ('mispricing_heatmap_interactive.png', 'Mispricing Heatmap (Sector vs Region)'),\\\\n\\\",\\n\",\n",
    "    \"    \\\"        ('stock_rankings_interactive.png', 'Stock Rankings - Top Under/Overvalued'),\\\\n\\\",\\n\",\n",
    "    \"    \\\"        ('sector_performance_bubble.png', 'Sector Performance Summary')\\\\n\\\",\\n\",\n",
    "    \"    \\\"        ]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"    Embedding PNG visualizations into Excel...\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for png_file, title in png_files:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        png_path = plots_dir / png_file\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if png_path.exists():\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Add section title with header formatting\\\\n\\\",\\n\",\n",
    "    \"    \\\"            worksheet_viz.write(row_offset, 0, title, header_format)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            worksheet_viz.set_row(row_offset, 20)  # Set row height for title\\\\n\\\",\\n\",\n",
    "    \"    \\\"            row_offset += 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Insert image with appropriate scaling\\\\n\\\",\\n\",\n",
    "    \"    \\\"            try:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                worksheet_viz.insert_image(row_offset, 0, str(png_path), {\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    'x_scale': 0.6,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    'y_scale': 0.6,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    'x_offset': 10,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    'y_offset': 10\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    })\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(f\\\\\\\"      ✓ Embedded: {png_file}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"                # Approximate row height for image (adjust based on image size)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                row_offset += 30  # Space for image + gap\\\\n\\\",\\n\",\n",
    "    \"    \\\"            except Exception as e:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                worksheet_viz.write(row_offset, 0, f\\\\\\\"Error inserting {png_file}: {e}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(f\\\\\\\"      ⚠️ Failed to embed {png_file}: {e}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"                row_offset += 2\\\\n\\\",\\n\",\n",
    "    \"    \\\"        else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            worksheet_viz.write(row_offset, 0, f\\\\\\\"{title}: PNG not found ({png_file})\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"      ⚠️ PNG not found: {png_file}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            row_offset += 2\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"  ✓ Excel report saved with enhanced formatting: {excel_path}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"    - All numerical columns formatted to 2 decimal places\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"    - Conditional formatting applied to key metrics\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"    - PNG visualizations embedded in 'Visualizations' sheet\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
