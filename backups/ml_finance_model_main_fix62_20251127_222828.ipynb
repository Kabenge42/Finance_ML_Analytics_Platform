    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"## Phase 9.7: Stock Ranking, Analytics, and Analyst Comparison Stocks with Visualization\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Business Goal\\\\n\\\",\\n\",\n",
    "    \"    \\\"Identify investment opportunities through mispricing scores, stock rankings, analyst comparison, and portfolio optimization.\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Key Objectives\\\\n\\\",\\n\",\n",
    "    \"    \\\"1. Calculate mispricing scores: (predicted_target - last_price) / last_price\\\\n\\\",\\n\",\n",
    "    \"    \\\"2. Rank stocks by sector and region\\\\n\\\",\\n\",\n",
    "    \"    \\\"3. Compare predictions vs analyst targets\\\\n\\\",\\n\",\n",
    "    \"    \\\"4. Perform portfolio optimization (max Sharpe, min volatility)\\\\n\\\",\\n\",\n",
    "    \"    \\\"5. Calculate risk metrics (VaR, CVaR, drawdown)\\\\n\\\",\\n\",\n",
    "    \"    \\\"6. Generate investment recommendations\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Inputs\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `all_stocks_features`: Full dataset with predictions from Phase 9.5\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Analyst price targets\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Outputs\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `outputs/analytics/`: Mispricing rankings, analyst comparison reports\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `outputs/analytics/portfolio_optimization.csv`: Optimal portfolios\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `outputs/analytics/risk_metrics.csv`: Risk analysis\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Top undervalued/overvalued stocks by sector\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Key Functions\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `calculate_mispricing_score()` - Identify mispricing\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `rank_undervalued_stocks()` - Top opportunities\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `compare_prediction_vs_analyst_targets()` - Analyst agreement analysis\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `optimize_max_sharpe_portfolio()` - Portfolio optimization\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `calculate_portfolio_risk_metrics()` - Risk quantification\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Validation Checkpoint\\\\n\\\",\\n\",\n",
