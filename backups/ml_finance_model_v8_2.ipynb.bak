    "    HAVE_BORUTA = True\n",
    "except ImportError as e:\n",
    "    HAVE_BORUTA = False\n",
    "    handle_optional_dependency(\"Boruta\", \"Boruta feature selection\", e)\n",
    "\n",
    "# LASSO and Elastic Net for feature selection\n",
    "from sklearn.linear_model import Lasso, ElasticNet\n",
