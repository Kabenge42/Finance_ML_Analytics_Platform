    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"# 10.1 Stock Selection – Advanced multi-criteria filtering and ML ranking\\\\n\\\",\\n\",\n",
    "    \"    \\\"print('\\\\\\\\n' + '=' * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"print('10.1 STOCK SELECTION - Advanced Filtering & Ranking')\\\\n\\\",\\n\",\n",
    "    \"    \\\"print('=' * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"if 'all_stocks_phase95' in dir() and not all_stocks_phase95.empty:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f'\\\\\\\\n✓ Using all_stocks_phase95 dataframe: {len(all_stocks_phase95)} stocks')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Pre-filter diagnostics to detect normalized vs absolute market cap\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print('\\\\\\\\n📊 Pre-filter diagnostics:')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f'  Total stocks: {len(all_stocks_phase95):,}')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if 'market_cap' in all_stocks_phase95.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        mc = all_stocks_phase95['market_cap'].dropna()\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f'  Market cap available: {len(mc):,} stocks')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if len(mc) > 0:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Smart scale detection based on median and percentiles\\\\n\\\",\\n\",\n",
    "    \"    \\\"            mc_p50 = mc.median()\\\\n\\\",\\n\",\n",
