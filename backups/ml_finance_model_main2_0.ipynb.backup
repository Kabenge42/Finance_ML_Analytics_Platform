    "EXPECTED_PROFITABILITY_METRICS = ['gross_margin', 'operating_margin', 'net_margin', 'roe', 'roa']\n",
    "EXPECTED_GROWTH_METRICS = ['revenue_growth_yoy', 'ebitda_growth_yoy', 'earnings_growth_yoy']\n",
    "EXPECTED_LEVERAGE_METRICS = ['debt_to_equity', 'debt_to_assets']\n",
