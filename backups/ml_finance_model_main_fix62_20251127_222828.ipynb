    "    \"    \\\"    model_features_all = getattr(stacking_model.estimators_[0], \\\\\\\"feature_names_in_\\\\\\\", None)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"if model_features_all is not None:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    missing_cols_all = set(model_features_all) - set(X_all_stocks_for_prediction.columns)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if missing_cols_all:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"⚠ Detected {len(missing_cols_all)} missing interaction features. Regenerating...\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Import helpers if not available\\\\n\\\",\\n\",\n",
