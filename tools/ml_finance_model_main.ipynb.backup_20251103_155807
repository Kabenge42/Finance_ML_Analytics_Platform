    "# Example 3: Peer Group Analysis\n",
    "from finance_ml import find_peer_group, compare_to_peers\n",
    "\n",
    "\n",
    "class PeerAnalyzer:\n",
    "    \"\"\"Handles peer group analysis for a specific ticker.\"\"\"\n",
    "\n",
    "    def __init__(self, all_stocks, ticker):\n",
    "        \"\"\"\n",
    "        Initialize peer analyzer.\n",
