    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Hierarchical Risk Parity\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print('\\\\\\\\n📊 Hierarchical Risk Parity (HRP):')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Calculate standard deviations from historical volatility columns\\\\n\\\",\\n\",\n",
    "    \"    \\\"    volatility_cols = ['volatility_1m', 'volatility_3m', 'volatility_6m', 'volatility_1y']\\\\n\\\",\\n\",\n",
    "    \"    \\\"    available_vol_cols = [col for col in volatility_cols if col in opt_universe.columns]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if available_vol_cols:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Use mean of available volatility columns as annualized std dev\\\\n\\\",\\n\",\n",
    "    \"    \\\"        std_devs = opt_universe[available_vol_cols].mean(axis=1).fillna(0.20).values\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f'  Calculated std_devs from {len(available_vol_cols)} volatility columns')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Fallback: Use default 20% annualized volatility for equities\\\\n\\\",\\n\",\n",
    "    \"    \\\"        std_devs = np.full(len(opt_universe), 0.20)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print('  Using default std_devs (20% annualized volatility)')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Ensure std_devs are positive (fix for ValueError: scale < 0)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    std_devs = np.where(std_devs <= 0, 0.20, std_devs)  # Replace non-positive with 20% default\\\\n\\\",\\n\",\n",
    "    \"    \\\"    std_devs = np.nan_to_num(std_devs, nan=0.20)  # Replace NaN with 20% default\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    synthetic_returns = np.random.RandomState(RANDOM_SEED).normal(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            mean_returns / 252, std_devs / np.sqrt(252), size=(252, len(opt_universe))\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"    returns_df = pd.DataFrame(synthetic_returns, columns=[f'Asset_{i}' for i in range(len(opt_universe))])\\\\n\\\",\\n\",\n",
    "    \"    \\\"    hrp_weights = optimize_hrp(returns_df)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f'  Top 3 positions: {hrp_weights[:3]}')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f'  Weights sum: {hrp_weights.sum():.4f}')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print('\\\\\\\\n✓ Advanced optimization complete')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
