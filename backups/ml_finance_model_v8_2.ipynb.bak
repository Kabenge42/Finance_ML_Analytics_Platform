    "except ImportError as e:\n",
    "    HAVE_TENSORFLOW = False\n",
    "    handle_optional_dependency(\"TensorFlow/Keras\", \"deep learning models\", e)\n",
    "\n",
    "# To make this notebook's output stable across runs\n",
    "np.random.seed(42)\n",
    "if HAVE_TENSORFLOW:\n",
