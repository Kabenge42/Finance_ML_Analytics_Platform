    "            raise RuntimeError(\n",
    "                    f\"Cannot execute {name}: missing prerequisites {missing}. \"\n",
    "                    \"Run earlier cells first.\"\n",
    "                    )\n",
    "    _CHECKPOINTS[name] = True\n",
    "    print(f\"✓ Checkpoint: {name}\")\n",
