    "    \"   \\\"cell_type\\\": \\\"code\\\",\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"# Visualization 2: Regional Performance Radar Charts\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"\\\\\\\\n📊 Regional Performance Radar Charts:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Compute category scores by region\\\\n\\\",\\n\",\n",
    "    \"    \\\"category_region_scores = {}\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"for category_name, category_metrics in category_mapping.items():\\\\n\\\",\\n\",\n",
    "    \"    \\\"    available_in_category = [m for m in category_metrics if m in all_stocks_scaled.columns]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if len(available_in_category) == 0:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        continue\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Compute z-scores for available metrics and average by region\\\\n\\\",\\n\",\n",
    "    \"    \\\"    category_data = all_stocks_scaled[available_in_category + ['region']].copy()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Convert to numeric and compute z-scores\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for col in available_in_category:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        category_data[col] = pd.to_numeric(category_data[col], errors='coerce')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Compute z-scores (handle NaNs)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    z_scored_data = category_data[available_in_category].apply(lambda x: zscore(x, nan_policy='omit'))\\\\n\\\",\\n\",\n",
    "    \"    \\\"    category_data['category_score'] = z_scored_data.mean(axis=1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Aggregate by region\\\\n\\\",\\n\",\n",
    "    \"    \\\"    region_scores = category_data.groupby('region')['category_score'].mean()\\\\n\\\",\\n\",\n",
    "    \"    \\\"    category_region_scores[category_name] = region_scores\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"if category_region_scores:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Create radar chart for each region\\\\n\\\",\\n\",\n",
    "    \"    \\\"    radar_df = pd.DataFrame(category_region_scores)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Create subplot radar charts\\\\n\\\",\\n\",\n",
    "    \"    \\\"    from plotly.subplots import make_subplots\\\\n\\\",\\n\",\n",
    "    \"    \\\"    import plotly.graph_objects as go\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    regions = radar_df.index.tolist()\\\\n\\\",\\n\",\n",
    "    \"    \\\"    categories = radar_df.columns.tolist()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Create single figure with all regions\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_radar = go.Figure()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for region in regions:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        values = radar_df.loc[region].tolist()\\\\n\\\",\\n\",\n",
    "    \"    \\\"        values.append(values[0])  # Close the radar chart\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        fig_radar.add_trace(go.Scatterpolar(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                r=values,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                theta=categories + [categories[0]],\\\\n\\\",\\n\",\n",
    "    \"    \\\"                fill='toself',\\\\n\\\",\\n\",\n",
    "    \"    \\\"                name=region,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                opacity=0.6\\\\n\\\",\\n\",\n",
    "    \"    \\\"                ))\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_radar.update_layout(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            polar=dict(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    radialaxis=dict(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                            visible=True,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                            range=[-1, 1]\\\\n\\\",\\n\",\n",
    "    \"    \\\"                            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    ),\\\\n\\\",\\n\",\n",
    "    \"    \\\"            showlegend=True,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            title=\\\\\\\"Regional Performance Across 11 Feature Categories (Phase 9.3)\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"            height=700\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_radar.show()\\\\n\\\",\\n\",\n",
    "    \"    \\\"    output_path = eda_output_dir / \\\\\\\"phase93_regional_radar_charts.html\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_radar.write_html(output_path)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"\\\\\\\\n✓ Regional radar charts complete\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  Regions visualized: {len(regions)}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  Categories analyzed: {len(categories)}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  Output: {output_path}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Display top category per region\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"\\\\\\\\n  🌍 Strongest Category by Region:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for region in regions[:5]:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        top_category = radar_df.loc[region].idxmax()\\\\n\\\",\\n\",\n",
    "    \"    \\\"        top_score = radar_df.loc[region].max()\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"    {region}: {top_category} (z-score: {top_score:.2f})\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(\\\\\\\"  ⚠️ No regional category data available\\\\\\\")\\\\n\\\"\\n\",\n",
    "    \"   ],\\n\",\n",
