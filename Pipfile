[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# Core Data Science Libraries
numpy = ">=1.26.0,<3.0.0"  # allows NumPy 2.x on Python 3.14+
pandas = ">=2.0.0,<3.0.0"
scipy = ">=1.11.0,<2.0.0"
statsmodels = ">=0.14.0,<1.0.0"

# Machine Learning - Scikit-learn Ecosystem
scikit-learn = ">=1.4.0,<2.0.0"
imbalanced-learn = ">=0.11.0,<1.0.0"

# Deep Learning Frameworks
# Gate TensorFlow/Keras on <3.14 to avoid build issues on Python 3.14 (Windows)
tensorflow = { version = ">=2.13.0,<3.0.0", markers = "python_version < '3.14'" }
scikeras = { version = ">=0.12.0,<1.0.0", markers = "python_version < '3.14'" }

# Gradient Boosting Libraries
xgboost = ">=2.0.3,<3.0.0"
lightgbm = ">=4.0.0,<5.0.0"
# Gate CatBoost on <3.14 due to missing cp314 wheels as of 2025-11
catboost = { version = ">=1.2.0,<2.0.0", markers = "python_version < '3.14'" }

# Feature Engineering & Selection
boruta = ">=0.3.0,<1.0.0"

# Model Interpretation & Explainability
# SHAP 0.50.0 provides enhanced explainability features with improved performance.
# SHAP depends on numba which does not (yet) support Python 3.14.
# Gate it on <3.14 to avoid installation failure; install later when available.
shap = { version = "==0.50.0", markers = "python_version < '3.14'" }

# Visualization Libraries
matplotlib = ">=3.7.0,<4.0.0"
seaborn = ">=0.12.0,<1.0.0"
plotly = ">=5.14.0,<6.0.0"

# Development & Utility Tools
tqdm = ">=4.65.0,<5.0.0"
joblib = ">=1.3.0,<2.0.0"
#numba = ">=0.57.0,<1.0.0"

# Image & File Processing
Pillow = ">=10.0.0,<12.0.0"
xlsxwriter = ">=3.1.0,<4.0.0"

# System Monitoring
psutil = ">=5.9.0,<6.0.0"

# Optional Database Access (install separately if needed)
# psycopg2-binary = ">=2.9.0,<3.0.0"
# SQLAlchemy = ">=2.0.0,<3.0.0"

[dev-packages]

[requires]
# Project supports Python 3.12, 3.13, or 3.14 (>=3.12,<3.15)
# Pipfile requires exact version - set to 3.12, 3.13, or 3.14 based on your environment
python_version = "3.14"
