   "source": [
    "### 6.3.5 Ensemble Methods Summary\n",
    "Summary of voting and stacking ensemble performance."
   ],
   "id": "640e437dea459247"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "# ============================================================================\n",
    "# PHASE 9.5: Ensemble Methods Summary\n",
    "# ============================================================================\n",
    "print(\"=\" * 80)\n",
    "print(\"PHASE 9.5: ENSEMBLE METHODS SUMMARY\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "if 'X_train' not in dir() or 'y_train' not in dir():\n",
    "    print(\"⚠️  Training data not prepared. Run Section 6.2 first.\")\n",
    "else:\n",
    "    from finance_ml.ml_workflow.regression.models import (\n",
    "        train_voting_regressor,\n",
    "        )\n",
    "\n",
    "    ensemble_results = {}\n",
    "\n",
    "\n",
    "    def get_metric(result, metric_name='r2_score', default=0.0):\n",
    "        \"\"\"Safely extract a metric (e.g., r2_score, mae, rmse) from varied return types.\n",
    "\n",
    "        Supports common trainer return shapes:\n",
    "        - (model, metrics_dict)\n",
    "        - (metrics_dict, model)\n",
    "        - plain metrics dict\n",
    "        - raw numeric\n",
    "        Any other type returns default.\n",
    "        \"\"\"\n",
    "        # Numeric straight away\n",
    "        if isinstance(result, (int, float)):\n",
    "            try:\n",
    "                return float(result)\n",
    "            except Exception:\n",
    "                return default\n",
    "\n",
    "        # Tuple/list returns from trainers\n",
    "        if isinstance(result, (tuple, list)):\n",
    "            if len(result) == 2:\n",
    "                a, b = result\n",
    "                metrics = a if isinstance(a, dict) else (b if isinstance(b, dict) else None)\n",
    "                if isinstance(metrics, dict):\n",
    "                    key_mapping = {\n",
    "                        'r2_score': ['r2_score', 'r2', 'train_score', 'test_score'],\n",
    "                        'mae': ['mae', 'mean_absolute_error'],\n",
    "                        'rmse': ['rmse', 'root_mean_squared_error'],\n",
    "                        }\n",
    "                    for key in key_mapping.get(metric_name, [metric_name]):\n",
    "                        val = metrics.get(key)\n",
    "                        if isinstance(val, (int, float)):\n",
    "                            return float(val)\n",
    "                    # Attempt coercion if present but not numeric\n",
    "                    for key in key_mapping.get(metric_name, [metric_name]):\n",
    "                        if key in metrics:\n",
    "                            try:\n",
    "                                return float(metrics[key])\n",
    "                            except Exception:\n",
    "                                return default\n",
    "                return default\n",
    "            return default\n",
    "\n",
    "        # Dict of metrics\n",
    "        if isinstance(result, dict):\n",
    "            key_mapping = {\n",
    "                'r2_score': ['r2_score', 'r2', 'train_score', 'test_score'],\n",
    "                'mae': ['mae', 'mean_absolute_error'],\n",
    "                'rmse': ['rmse', 'root_mean_squared_error'],\n",
    "                }\n",
    "            for key in key_mapping.get(metric_name, [metric_name]):\n",
    "                val = result.get(key)\n",
    "                if isinstance(val, (int, float)):\n",
    "                    return float(val)\n",
    "            for key in key_mapping.get(metric_name, [metric_name]):\n",
    "                if key in result:\n",
    "                    try:\n",
    "                        return float(result[key])\n",
    "                    except Exception:\n",
    "                        return default\n",
    "            return default\n",
    "\n",
    "        # Fallback\n",
    "        return default\n",
    "\n",
    "\n",
    "    # Voting Regressor\n",
    "    print(\"\\n🗳️ Training Voting Regressor (XGBoost + LightGBM + Ridge)...\")\n",
    "    try:\n",
    "        voting_result = train_voting_regressor(\n",
    "                X_train, y_train,\n",
    "                weights=[0.4, 0.4, 0.2],  # XGB, LGB, Ridge\n",
    "                random_state=RANDOM_SEED\n",
    "                )\n",
    "        ensemble_results['Voting'] = voting_result\n",
    "        score = get_metric(voting_result, 'r2_score')\n",
    "        try:\n",
    "            print(f\"   R² Score: {score:.4f}\")\n",
    "        except Exception:\n",
    "            print(f\"   R² Score: {score}\")\n",
    "    except Exception as e:\n",
    "        print(f\"   ⚠️ Voting ensemble failed: {e}\")\n",
    "\n",
    "    # Summary of all model types\n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(\"ALL MODELS SUMMARY (Phase 9.5)\")\n",
    "    print(\"=\" * 60)\n",
    "\n",
    "    all_results = {}\n",
    "\n",
    "    # Collect results from previous cells if available\n",
    "    if 'linear_results' in dir():\n",
    "        all_results.update(linear_results)\n",
    "    if 'tree_results' in dir():\n",
    "        all_results.update(tree_results)\n",
    "    if 'gb_results' in dir():\n",
    "        all_results.update(gb_results)\n",
    "    if 'nn_result' in dir() and isinstance(nn_result, dict):\n",
    "        all_results['NeuralNetwork'] = nn_result\n",
    "    all_results.update(ensemble_results)\n",
    "\n",
    "    # Display full comparison\n",
    "    results_df = pd.DataFrame()\n",
    "    if all_results:\n",
    "        print(f\"Comparing {len(all_results)} models:\")\n",
    "        # Sort by R2 score safely\n",
    "        sorted_models = sorted(\n",
    "                all_results.items(),\n",
    "                key=lambda x: get_metric(x[1], 'r2_score'),\n",
    "                reverse=True\n",
    "                )\n",
    "\n",
    "        results_data = []\n",
    "        for name, res in sorted_models:\n",
    "            r2 = get_metric(res, 'r2_score')\n",
    "            mae = get_metric(res, 'mae', default=float('nan'))\n",
    "            rmse = get_metric(res, 'rmse', default=float('nan'))\n",
    "\n",
    "            try:\n",
    "                if mae == mae:  # not NaN\n",
    "                    print(f\"  {name:20s}: R² = {r2:.4f}, MAE = {mae:.4f}\")\n",
    "                else:\n",
    "                    print(f\"  {name:20s}: R² = {r2:.4f}\")\n",
    "            except Exception:\n",
    "                if mae == mae:\n",
    "                    print(f\"  {name:20s}: R² = {r2}, MAE = {mae}\")\n",
    "                else:\n",
    "                    print(f\"  {name:20s}: R² = {r2}\")\n",
    "            results_data.append({'Model': name, 'R2': r2, 'MAE': mae, 'RMSE': rmse})\n",
    "\n",
    "        results_df = pd.DataFrame(results_data).set_index('Model')\n",
    "\n",
    "    if not results_df.empty:\n",
    "        best_model_name = results_df.index[0]\n",
    "        print(f\"\\n🏆 Best Model: {best_model_name}\")\n",
    "        print(f\"   R²: {results_df.loc[best_model_name, 'R2']:.4f}\")\n",
    "        print(f\"   MAE: {results_df.loc[best_model_name, 'MAE']:.2f}\")\n",
    "    else:\n",
    "        best_model_name = \"None\"\n",
    "        print(\"  ⚠ No regression successfully trained\")\n",
    "if 'best_model_name' not in dir():\n",
    "    best_model_name = \"None\"\n"
