    "    \"    \\\"# === FIX END ===\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"raw_predictions = stacking_model.predict(X_all_stocks_for_prediction)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"\\\\\\\\n Raw predictions generated:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"  Total stocks: {len(raw_predictions):,}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"  Range: ${raw_predictions.min():.2f} to ${raw_predictions.max():.2f}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"  Negative: {(raw_predictions < 0).sum()} ({(raw_predictions < 0).sum() / len(raw_predictions) * 100:.1f}%)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Step 2: Apply final adaptive clipping (non-negative + outlier bounds)\\\\n\\\",\\n\",\n",
    "    \"    \\\"# This is the SINGLE point of non-negative enforcement for all predictions\\\\n\\\",\\n\",\n",
    "    \"    \\\"clip_result = adaptive_clip_predictions(raw_predictions, y_train)\\\\n\\\",\\n\",\n",
