    "    \"   \\\"cell_type\\\": \\\"code\\\",\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"# 📊 Section 5 Enhanced Visualizations - Classification Models\\\\n\\\",\\n\",\n",
    "    \"    \\\"print('\\\\\\\\n' + '=' * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"print('📊 INTERACTIVE CLASSIFICATION VISUALIZATIONS')\\\\n\\\",\\n\",\n",
    "    \"    \\\"print('=' * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Confusion matrix and classification metrics\\\\n\\\",\\n\",\n",
    "    \"    \\\"if 'y_test_cls' in dir() and 'y_pred_cls' in dir():\\\\n\\\",\\n\",\n",
    "    \"    \\\"    from finance_ml.ml_workflow.classification.evaluation import (\\\\n\\\",\\n\",\n",
    "    \"    \\\"        plot_confusion_matrices,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        analyze_calibration\\\\n\\\",\\n\",\n",
    "    \"    \\\"        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"    import plotly.figure_factory as ff\\\\n\\\",\\n\",\n",
    "    \"    \\\"    from sklearn.metrics import confusion_matrix, classification_report\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print('\\\\\\\\n📈 Confusion Matrix Visualization...')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Create confusion matrix with explicit labels when possible\\\\n\\\",\\n\",\n",
    "    \"    \\\"    class_names_5 = ['Strong Negative', 'Negative', 'Neutral', 'Positive', 'Strong Positive']\\\\n\\\",\\n\",\n",
    "    \"    \\\"    class_names_3 = ['Negative', 'Neutral', 'Positive']\\\\n\\\",\\n\",\n",
    "    \"    \\\"    labels = None\\\\n\\\",\\n\",\n",
    "    \"    \\\"    try:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if 'y_proba_test' in dir() and hasattr(y_proba_test, 'shape') and len(y_proba_test.shape) == 2 and \\\\\\\\\\\\n\\\",\\n\",\n",
    "    \"    \\\"                y_proba_test.shape[1] == 5:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            labels = list(range(5))\\\\n\\\",\\n\",\n",
    "    \"    \\\"            class_names = class_names_5\\\\n\\\",\\n\",\n",
    "    \"    \\\"        elif 'y_proba_test' in dir() and hasattr(y_proba_test, 'shape') and len(y_proba_test.shape) == 2 and \\\\\\\\\\\\n\\\",\\n\",\n",
    "    \"    \\\"                y_proba_test.shape[1] == 3:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            labels = list(range(3))\\\\n\\\",\\n\",\n",
    "    \"    \\\"            class_names = class_names_3\\\\n\\\",\\n\",\n",
    "    \"    \\\"        else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Fallback: infer from data\\\\n\\\",\\n\",\n",
    "    \"    \\\"            unique_labels = sorted(list(set(pd.Series(y_test_cls).unique()).union(pd.Series(y_pred_cls).unique())))\\\\n\\\",\\n\",\n",
    "    \"    \\\"            labels = [int(x) for x in unique_labels]\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if len(labels) == 5:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                class_names = class_names_5\\\\n\\\",\\n\",\n",
    "    \"    \\\"            elif len(labels) == 3:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                class_names = class_names_3\\\\n\\\",\\n\",\n",
    "    \"    \\\"            else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                class_names = [f'Class {i}' for i in range(len(labels))]\\\\n\\\",\\n\",\n",
    "    \"    \\\"    except Exception:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Last resort\\\\n\\\",\\n\",\n",
    "    \"    \\\"        labels = None\\\\n\\\",\\n\",\n",
    "    \"    \\\"        class_names = class_names_5\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    cm = confusion_matrix(y_test_cls, y_pred_cls, labels=labels) if labels is not None else confusion_matrix(y_test_cls,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                                                                                                             y_pred_cls)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Interactive confusion matrix heatmap\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig = ff.create_annotated_heatmap(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            z=cm,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            x=class_names,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            y=class_names,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            colorscale='Blues',\\\\n\\\",\\n\",\n",
    "    \"    \\\"            showscale=True\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig.update_layout(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            title='Classification Confusion Matrix',\\\\n\\\",\\n\",\n",
    "    \"    \\\"            xaxis_title='Predicted',\\\\n\\\",\\n\",\n",
    "    \"    \\\"            yaxis_title='Actual',\\\\n\\\",\\n\",\n",
    "    \"    \\\"            width=900,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            height=900\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig.show()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Classification report\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print('\\\\\\\\n📊 Classification Report:')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if labels is not None:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(classification_report(y_test_cls, y_pred_cls, labels=labels, target_names=class_names))\\\\n\\\",\\n\",\n",
    "    \"    \\\"    else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(classification_report(y_test_cls, y_pred_cls, target_names=class_names))\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Class distribution\\\\n\\\",\\n\",\n",
    "    \"    \\\"    import pandas as pd\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Ensure class_dist has entries for all classes (0, 1, 2), filling missing with 0\\\\n\\\",\\n\",\n",
    "    \"    \\\"    class_dist = pd.Series(y_pred_cls).value_counts().sort_index()\\\\n\\\",\\n\",\n",
    "    \"    \\\"    num_classes = len(class_names)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    class_dist = class_dist.reindex(range(num_classes), fill_value=0)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig = px.bar(x=class_names, y=class_dist.values,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                 title='Predicted Class Distribution',\\\\n\\\",\\n\",\n",
    "    \"    \\\"                 labels={'x': 'Class', 'y': 'Count'},\\\\n\\\",\\n\",\n",
    "    \"    \\\"                 color=class_names)\\\\n\\\",\\n\",\n",
