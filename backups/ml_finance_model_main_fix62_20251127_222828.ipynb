    "    \"   \\\"cell_type\\\": \\\"markdown\\\",\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"### 6.4 Train Stacking Ensemble\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"**⚠️ Important Fix: Prediction Clipping Strategy**\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"**Issue Identified**: Previous implementation used statistical clipping (`mean ± 3*std`) which capped predictions at ~35k despite actual price targets reaching 180k+. This caused severe under-prediction for high-value stocks.\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"**Root Cause**: \\\\n\\\",\\n\",\n",
    "    \"    \\\"- Statistical clipping assumes normal distribution: `[max(0, mean-3*std), mean+3*std]`\\\\n\\\",\\n\",\n",
    "    \"    \\\"- With training data mean ≈ 15k and std ≈ 6.5k, upper bound = 15k + 3*6.5k ≈ **34.5k**\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Test set contains high-value stocks (>50k) that were capped at this artificial limit\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"**Solution Implemented**:\\\\n\\\",\\n\",\n",
    "    \"    \\\"- **Percentile-based clipping**: Uses `1.5 × 99.5th percentile` as upper bound\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Adapts to data distribution (handles heavy-tailed price distributions)\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Allows extrapolation beyond training max while preventing extreme outliers\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Maintains non-negativity constraint (prices cannot be negative)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"**Expected Impact**:\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Predictions can now reach high values (>50k) matching actual price targets\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Improved metrics for high-value stocks (reduced MAPE, better R²)\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Better residual distribution (reduced systematic under-prediction bias)\\\\n\\\"\\n\",\n",
    "    \"   ],\\n\",\n",
    "    \"   \\\"id\\\": \\\"963140a9c0730e26\\\"\\n\",\n",
    "    \"  },\\n\",\n",
    "    \"  {\\n\",\n",
    "    \"   \\\"metadata\\\": {\\n\",\n",
    "    \"    \\\"ExecuteTime\\\": {\\n\",\n",
    "    \"     \\\"end_time\\\": \\\"2025-11-27T20:45:11.062332Z\\\",\\n\",\n",
    "    \"     \\\"start_time\\\": \\\"2025-11-27T20:44:52.448245Z\\\"\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"   },\\n\",\n",
    "    \"   \\\"cell_type\\\": \\\"code\\\",\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"print(\\\\\\\"=\\\\\\\" * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"6.4 — Training Stacking Ensemble (Phase 9.9 Default)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"=\\\\\\\" * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Phase 9.9: Stacking ensemble is now the default regression approach (Task 9.9.8)\\\\n\\\",\\n\",\n",
    "    \"    \\\"# - Integrates classification meta-features from Phase 9.4 via integrate_classification_features()\\\\n\\\",\\n\",\n",
    "    \"    \\\"# - Uses robust Huber loss for base models (outlier safety rails)\\\\n\\\",\\n\",\n",
    "    \"    \\\"# - Non-negative constraints applied AFTER calibration (single point of enforcement)\\\\n\\\",\\n\",\n",
    "    \"    \\\"# - Standardized predictions schema via build_predictions_frame()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Prepare classification probabilities for meta-features (Phase 9.5)\\\\n\\\",\\n\",\n",
    "    \"    \\\"prob_cols = [\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"event_prob_strong_negative\\\\\\\", \\\\\\\"event_prob_negative\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"event_prob_neutral\\\\\\\", \\\\\\\"event_prob_positive\\\\\\\", \\\\\\\"event_prob_strong_positive\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    ]\\\\n\\\",\\n\",\n",
    "    \"    \\\"train_probs = None\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Check if all probability columns exist\\\\n\\\",\\n\",\n",
    "    \"    \\\"if all(c in all_stocks_enhanced.columns for c in prob_cols):\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Extract probabilities aligned with X_train index\\\\n\\\",\\n\",\n",
    "    \"    \\\"    train_probs = all_stocks_enhanced.loc[X_train.index, prob_cols].values\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"✓ Found classification probability columns for meta-features\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Fallback: try to find any cols starting with event_prob_\\\\n\\\",\\n\",\n",
    "    \"    \\\"    alt_prob_cols = [c for c in all_stocks_enhanced.columns if c.startswith('event_prob_')]\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if len(alt_prob_cols) == 5:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        prob_cols = sorted(alt_prob_cols)  # Sort to ensure deterministic order\\\\n\\\",\\n\",\n",
    "    \"    \\\"        train_probs = all_stocks_enhanced.loc[X_train.index, prob_cols].values\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"✓ Found alternative classification probability columns: {prob_cols}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"ℹ️ Classification probabilities not found. Training without meta-features.\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Code Guidelines Section 1.1: train_* functions return dict {model, metrics, y_pred, y_proba, artifacts}\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Use robust Huber loss for GradientBoosting base model inside stacking (Priority 2)\\\\n\\\",\\n\",\n",
    "    \"    \\\"# CHANGE: Removed ensure_nonnegative=True to allow model natural predictions\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Non-negativity will be enforced once at the end after calibration\\\\n\\\",\\n\",\n",
    "    \"    \\\"stacking_result = regression_train_stacking(\\\\n\\\",\\n\",\n",
    "    \"    \\\"        X_train, y_train,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        cv=CV_FOLDS,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        ensure_nonnegative=False,  # Changed from True - apply constraint after calibration\\\\n\\\",\\n\",\n",
    "    \"    \\\"        loss=\\\\\\\"huber\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"        use_meta_features=(train_probs is not None),\\\\n\\\",\\n\",\n",
    "    \"    \\\"        classification_probabilities=train_probs,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        enable_interactions=False,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        interaction_valuation_cols=valuation_cols_method_aware,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        cv_policy=\\\\\\\"time_series\\\\\\\" if \\\\\\\"snapshot_date\\\\\\\" in all_stocks_enhanced.columns else \\\\\\\"kfold\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"        date_col=\\\\\\\"snapshot_date\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"        dates=all_stocks_enhanced.loc[\\\\n\\\",\\n\",\n",
    "    \"    \\\"            X_train.index, \\\\\\\"snapshot_date\\\\\\\"] if \\\\\\\"snapshot_date\\\\\\\" in all_stocks_enhanced.columns else None\\\\n\\\",\\n\",\n",
    "    \"    \\\"        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"stacking_model = stacking_result['model']\\\\n\\\",\\n\",\n",
    "    \"    \\\"stacking_results = stacking_result.get('artifacts', {})\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"\\\\\\\\n✓ Stacking Ensemble Trained:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"  Base models: {', '.join(stacking_results.get('base_models', []))}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"  Meta-learner: {stacking_results.get('meta_model', 'Unknown')}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"  Train R²: {stacking_result['metrics'].get('r2', 0):.4f}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"  CV R² (mean ± std): {stacking_results.get('cv_score', 0):.4f} ± {stacking_results.get('cv_std', 0):.4f}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Test set predictions - NO intermediate clipping\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Let predictions flow naturally to calibration step\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# CRITICAL FIX: Enhance X_test with classification features (Phase 9.5)\\\\n\\\",\\n\",\n",
    "    \"    \\\"# The train_stacking_regressor function internally adds classification features to X_train\\\\n\\\",\\n\",\n",
    "    \"    \\\"# when use_meta_features=True. We must apply the same transformation to X_test.\\\\n\\\",\\n\",\n",
    "    \"    \\\"test_probs = None\\\\n\\\",\\n\",\n",
    "    \"    \\\"X_test_for_prediction = X_test.copy()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"if train_probs is not None:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Extract test set probabilities aligned with X_test index\\\\n\\\",\\n\",\n",
    "    \"    \\\"    test_probs = all_stocks_enhanced.loc[X_test.index, prob_cols].values\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"🔧 Enhancing X_test with classification meta-features...\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Import feature integration functions\\\\n\\\",\\n\",\n",
    "    \"    \\\"    from finance_ml.ml_workflow.regression.dataset import (\\\\n\\\",\\n\",\n",
    "    \"    \\\"        integrate_classification_features,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        create_classification_interactions\\\\n\\\",\\n\",\n",
    "    \"    \\\"        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Add probability columns and event_confidence to X_test\\\\n\\\",\\n\",\n",
    "    \"    \\\"    X_test_for_prediction = integrate_classification_features(X_test_for_prediction, test_probs)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  ✓ Added classification probability features\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Ensure configuration variable is defined to prevent NameError (Code Guidelines Section 8.1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if 'enable_interactions' not in locals():\\\\n\\\",\\n\",\n",
    "    \"    \\\"        enable_interactions = False  # Set to True if you specifically want interaction features\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Add interaction features if they were enabled during training\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if enable_interactions and interaction_valuation_cols:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        class_cols = [\\\\n\\\",\\n\",\n",
    "    \"    \\\"            c for c in X_test_for_prediction.columns\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if c.startswith(\\\\\\\"event_prob_\\\\\\\") or c == \\\\\\\"event_confidence\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            ]\\\\n\\\",\\n\",\n",
    "    \"    \\\"        X_test_for_prediction = create_classification_interactions(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                X_test_for_prediction, class_cols, valuation_cols_method_aware\\\\n\\\",\\n\",\n",
    "    \"    \\\"                )\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                f\\\\\\\"  ✓ Added interaction features: {len(class_cols)} prob cols × {len(valuation_cols_method_aware)} valuation cols\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  ✓ X_test shape: {X_test.shape} → {X_test_for_prediction.shape}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# === FIX START: Align X_test features with Model features ===\\\\n\\\",\\n\",\n",
    "    \"    \\\"# 1. Identify if interactions are missing\\\\n\\\",\\n\",\n",
    "    \"    \\\"model_features = getattr(stacking_model, \\\\\\\"feature_names_in_\\\\\\\", None)\\\\n\\\",\\n\",\n",
    "    \"    \\\"if model_features is None and hasattr(stacking_model, \\\\\\\"estimators_\\\\\\\"):\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Try getting features from the first base estimator if wrapper hides them\\\\n\\\",\\n\",\n",
    "    \"    \\\"    model_features = getattr(stacking_model.estimators_[0], \\\\\\\"feature_names_in_\\\\\\\", None)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"if model_features is not None:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    missing_cols = set(model_features) - set(X_test_for_prediction.columns)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if missing_cols:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"⚠ Detected {len(missing_cols)} missing interaction features. Regenerating...\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Import helpers if not available\\\\n\\\",\\n\",\n",
    "    \"    \\\"        from finance_ml.ml_workflow.regression.dataset import create_classification_interactions\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Define columns for interaction creation (same as Section 6.1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Identify classification probability columns currently in X_test\\\\n\\\",\\n\",\n",
    "    \"    \\\"        cls_cols = [c for c in X_test_for_prediction.columns if c.startswith('event_prob_') or c == 'event_confidence']\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Identify valuation columns (fallback to default if method-aware list not found)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        val_cols = globals().get('valuation_cols_method_aware', [\\\\n\\\",\\n\",\n",
    "    \"    \\\"            'market_cap', 'enterprise_value', 'ebitda', 'p_e', 'p_b',\\\\n\\\",\\n\",\n",
