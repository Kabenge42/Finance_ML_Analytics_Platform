    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"**Primary Goal**: Predict Stock Price Targets for all stocks in the portfolio to support \\\\n\\\",\\n\",\n",
    "    \"    \\\"investment decisions and portfolio optimization.\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"**Target Variable**: \\\\\\\"Predicted Price Target\\\\\\\" for regression modeling\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
