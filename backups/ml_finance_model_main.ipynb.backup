    "if 'price_target' in all_stocks_features.columns:\n",
    "    X = all_stocks_features[feature_cols].select_dtypes(include=[np.number])\n",
    "    y = all_stocks_features['price_target']\n",
    "\n",
    "    # Use Phase 9.3 function: features_importance_rf\n",
    "\n",
