    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"## Phase 9.6: Model Evaluation and Comprehensive Error Analysis and Error Analysis\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Business Goal\\\\n\\\",\\n\",\n",
    "    \"    \\\"Thoroughly evaluate regression model performance with comprehensive metrics, residual analysis, and segment-wise breakdowns.\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Key Objectives\\\\n\\\",\\n\",\n",
    "    \"    \\\"1. Calculate comprehensive regression metrics (MAE, RMSE, R², MAPE)\\\\n\\\",\\n\",\n",
    "    \"    \\\"2. Perform segment analysis (by sector, region, market cap)\\\\n\\\",\\n\",\n",
    "    \"    \\\"3. Generate residual plots and error distributions\\\\n\\\",\\n\",\n",
    "    \"    \\\"4. Identify systematic biases\\\\n\\\",\\n\",\n",
    "    \"    \\\"5. Analyze prediction errors by magnitude\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Inputs\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `reg_result`: Regression results from Phase 9.5\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `all_stocks_features`: Full dataset with predictions\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Outputs\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `outputs/evaluation/`: Comprehensive metrics, residual plots\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `outputs/evaluation/tscv_metrics.csv`: Time-series CV results\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Sector-wise performance analysis\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Key Metrics\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Overall: MAE, RMSE, R², MAPE, Median AE\\\\n\\\",\\n\",\n",
    "    \"    \\\"- By sector: Per-sector performance comparison\\\\n\\\",\\n\",\n",
    "    \"    \\\"- By region: Geographic performance patterns\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Error distribution: Histogram, percentiles\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Validation Checkpoint\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Comprehensive metrics calculated\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Residuals analyzed\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Sector biases identified\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Error patterns documented\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"Comprehensive evaluation including:\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Regression metrics (MAE, RMSE, MAPE, R²)\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Residual analysis\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Sector and region performance breakdown\\\\n\\\",\\n\",\n",
    "    \"    \\\"- SHAP analysis for explainability\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Learning curves and bias-variance diagnosis\\\\n\\\"\\n\",\n",
