    "print(f\"  Profitability: {len(profit_present)}/{len(EXPECTED_PROFITABILITY_METRICS)} available\")\n",
    "if profit_missing:\n",
    "    print(f\"    Missing: {profit_missing}\")\n",
    "\n",
    "# Growth metrics\n",
    "growth_present = [c for c in EXPECTED_GROWTH_METRICS if c in available_cols]\n",
