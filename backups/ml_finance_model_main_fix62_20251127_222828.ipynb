    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Apply enhanced imputation (6-step consolidated to helper)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        all_stocks_imputed = apply_enhanced_imputation_strategy_6step(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                df=all_stocks_normalized,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                sector_column=\\\\\\\"sector\\\\\\\" if \\\\\\\"sector\\\\\\\" in all_stocks_normalized.columns else None,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                n_neighbors=5,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
