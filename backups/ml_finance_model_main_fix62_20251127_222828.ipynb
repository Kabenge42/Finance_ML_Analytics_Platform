    "    \"   \\\"cell_type\\\": \\\"markdown\\\",\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"## Phase 9.5: Sector-Optimized Regression Models with Quantile Predictions Models with Classification Features\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Business Goal\\\\n\\\",\\n\",\n",
    "    \"    \\\"Predict stock price targets using regression models enhanced with classification meta-features, with uncertainty quantification via quantile regression.\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Key Objectives\\\\n\\\",\\n\",\n",
    "    \"    \\\"1. Integrate classification probabilities as meta-features\\\\n\\\",\\n\",\n",
    "    \"    \\\"2. Train multiple regression models (XGBoost, LightGBM, CatBoost, etc.)\\\\n\\\",\\n\",\n",
    "    \"    \\\"3. Build stacking ensemble for robust predictions\\\\n\\\",\\n\",\n",
    "    \"    \\\"4. Train quantile models for prediction intervals (p10, p50, p90)\\\\n\\\",\\n\",\n",
    "    \"    \\\"5. Apply non-negative constraints (prices must be ≥ 0)\\\\n\\\",\\n\",\n",
    "    \"    \\\"6. Perform time-series cross-validation\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Inputs\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `all_stocks_features`: From Phase 9.3\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `clf_result['y_proba']`: Classification probabilities from Phase 9.4\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Outputs\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `reg_result`: Regression result dict\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `outputs/regression/`: Model artifacts, quantile predictions\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `outputs/regression/regression_predictions_detailed.csv`: Standardized predictions\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `outputs/models/regression_metrics_by_sector.csv`: Per-sector metrics\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### v1.2 Standards Applied\\\\n\\\",\\n\",\n",
    "    \"    \\\"- ✅ Quantile regression (p10, p50, p90) with conformal calibration\\\\n\\\",\\n\",\n",
    "    \"    \\\"- ✅ Monotonicity enforcement (p10 ≤ p50 ≤ p90)\\\\n\\\",\\n\",\n",
    "    \"    \\\"- ✅ Non-negativity constraints\\\\n\\\",\\n\",\n",
    "    \"    \\\"- ✅ Data split policy (TimeSeriesSplit → GroupKFold → Stratified)\\\\n\\\",\\n\",\n",
    "    \"    \\\"- ✅ Standardized predictions schema\\\\n\\\",\\n\",\n",
    "    \"    \\\"- ✅ Outlier safety rails (Huber loss, post-prediction clipping)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Standardized Predictions Schema\\\\n\\\",\\n\",\n",
    "    \"    \\\"Required columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"- ticker, isin, sector, region, last_price, snapshot_date\\\\n\\\",\\n\",\n",
    "    \"    \\\"- y_true, y_pred, y_pred_calibrated\\\\n\\\",\\n\",\n",
    "    \"    \\\"- pred_p10, pred_p50, pred_p90, interval_width\\\\n\\\",\\n\",\n",
    "    \"    \\\"- abs_error, pct_error\\\\n\\\",\\n\",\n",
    "    \"    \\\"- model_version\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Validation Checkpoint\\\\n\\\",\\n\",\n",
    "    \"    \\\"- MAE < 50% on validation set\\\\n\\\",\\n\",\n",
    "    \"    \\\"- R² > 0.3\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Zero predictions < 1% (non-negativity enforced)\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Quantile monotonicity verified\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Prediction intervals coverage: 80% ± 5%\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"Advanced regression modeling using functions from `finance_ml.regression`:\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"**Workflow Steps:**\\\\n\\\",\\n\",\n",
    "    \"    \\\"1. Create interaction features between classification probabilities and valuation metrics\\\\n\\\",\\n\",\n",
    "    \"    \\\"2. Prepare regression data with classification meta-features\\\\n\\\",\\n\",\n",
    "    \"    \\\"3. Train and compare multiple regression models (Ridge, Lasso, RF, ET, GB, HistGB)\\\\n\\\",\\n\",\n",
    "    \"    \\\"4. Build stacking ensemble for best performance\\\\n\\\",\\n\",\n",
    "    \"    \\\"5. Train quantile regression for prediction intervals\\\\n\\\",\\n\",\n",
    "    \"    \\\"6. Train sector-specific models (optional)\\\\n\\\",\\n\",\n",
    "    \"    \\\"7. Save models with metadata\\\\n\\\",\\n\",\n",
    "    \"    \\\"8. Store predictions for downstream analysis\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"**Key Functions:**\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `create_classification_interactions` — Create feature interactions\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `prepare_regression_data` — Split and preprocess data\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `compare_regressors` — Compare 6 regression models\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `train_stacking_regressor` — Build ensemble\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `train_quantile_regressor` — Prediction intervals\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `train_sector_specific_models` — Per-sector optimization\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `save_model` — Model persistence\\\\n\\\"\\n\",\n",
    "    \"   ],\\n\",\n",
