    "    \"   \\\"cell_type\\\": \\\"code\\\",\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"print(\\\\\\\"=\\\\\\\" * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"6.5 — Quantile Regression for Uncertainty Estimation\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"=\\\\\\\" * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Code Guidelines Section 1.1: train_* functions return dict {model, metrics, y_pred, y_proba, artifacts}\\\\n\\\",\\n\",\n",
    "    \"    \\\"quantile_result = regression_train_quantile(\\\\n\\\",\\n\",\n",
    "    \"    \\\"        X_train, y_train,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        quantiles=QUANTILES\\\\n\\\",\\n\",\n",
    "    \"    \\\"        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"quantile_models = quantile_result.get('artifacts', {}).get('models', [])\\\\n\\\",\\n\",\n",
    "    \"    \\\"if not quantile_models:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Fallback: models might be in the top-level artifacts\\\\n\\\",\\n\",\n",
    "    \"    \\\"    quantile_models = quantile_result.get('model', [])\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if not isinstance(quantile_models, list):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        quantile_models = [quantile_models]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"\\\\\\\\n✓ Quantile Models Trained:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"  Quantiles: {QUANTILES}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(f\\\\\\\"  Models: {len(quantile_models)}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Generate predictions for each quantile\\\\n\\\",\\n\",\n",
    "    \"    \\\"predictions_quantile = {}\\\\n\\\",\\n\",\n",
    "    \"    \\\"for q, model in zip(QUANTILES, quantile_models):\\\\n\\\",\\n\",\n",
    "    \"    \\\"    predictions_quantile[q] = model.predict(X_test)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    try:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        score = model.score(X_train, y_train)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"  Q{q}: {score:.4f} (train R²)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    except AttributeError:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Some quantile models may not have a score method\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"  Q{q}: Model trained successfully\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Priority 4.2: Export quantile predictions with monotonicity enforcement and conformal calibration\\\\n\\\",\\n\",\n",
    "    \"    \\\"try:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"\\\\\\\\n📊 Generating Quantile Predictions (Phase 9.5 Safety Rails)...\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    from finance_ml.ml_workflow.regression.quantile import predict_quantile_regression\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Use Phase 9.5 helper for robust predictions (monotonic + non-negative)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    q_preds_df = predict_quantile_regression(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            quantile_models,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            QUANTILES,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            X_test,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            enforce_nonnegative=True\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Convert to dictionary for compatibility with existing reporting code below\\\\n\\\",\\n\",\n",
    "    \"    \\\"    predictions_quantile_monotonic = {\\\\n\\\",\\n\",\n",
    "    \"    \\\"        q: q_preds_df[f\\\\\\\"pred_q{q}\\\\\\\"].values\\\\n\\\",\\n\",\n",
    "    \"    \\\"        for q in QUANTILES\\\\n\\\",\\n\",\n",
    "    \"    \\\"        }\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Build quantile predictions dataframe with standardized schema\\\\n\\\",\\n\",\n",
    "    \"    \\\"    test_tickers = None\\\\n\\\",\\n\",\n",
    "    \"    \\\"    test_sectors = None\\\\n\\\",\\n\",\n",
    "    \"    \\\"    test_regions = None\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if 'ticker' in all_stocks_enhanced.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        test_tickers = all_stocks_enhanced.loc[y_test.index, 'ticker'].values\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if 'sector' in all_stocks_enhanced.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        test_sectors = all_stocks_enhanced.loc[y_test.index, 'sector'].values\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if 'region' in all_stocks_enhanced.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        test_regions = all_stocks_enhanced.loc[y_test.index, 'region'].values\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    q_df = pd.DataFrame({\\\\n\\\",\\n\",\n",
    "    \"    \\\"        'ticker': test_tickers if test_tickers is not None else y_test.index.astype(str),\\\\n\\\",\\n\",\n",
    "    \"    \\\"        'y_true': y_test.values,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        'pred_p10': predictions_quantile_monotonic.get(0.1),\\\\n\\\",\\n\",\n",
    "    \"    \\\"        'pred_p50': predictions_quantile_monotonic.get(0.5),\\\\n\\\",\\n\",\n",
    "    \"    \\\"        'pred_p90': predictions_quantile_monotonic.get(0.9),\\\\n\\\",\\n\",\n",
    "    \"    \\\"        })\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Add sector and region if available\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if test_sectors is not None:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        q_df['sector'] = test_sectors\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if test_regions is not None:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        q_df['region'] = test_regions\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Compute interval width and coverage metrics\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if 'pred_p10' in q_df.columns and 'pred_p90' in q_df.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        q_df['interval_width'] = q_df['pred_p90'] - q_df['pred_p10']\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Compute empirical coverage (should be ~80%)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        coverage = ((q_df['y_true'] >= q_df['pred_p10']) & (q_df['y_true'] <= q_df['pred_p90'])).mean()\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"  Empirical coverage (10%-90%): {coverage:.1%} (target: 80%)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Add metadata columns for standardized schema\\\\n\\\",\\n\",\n",
    "    \"    \\\"    q_df['model_version'] = os.environ.get('MODEL_VERSION', 'v9_9')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    q_df['snapshot_date'] = pd.Timestamp.now().strftime('%Y-%m-%d')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    out_q_path = out_models_dir / 'quantile_predictions.csv'\\\\n\\\",\\n\",\n",
    "    \"    \\\"    q_df.to_csv(out_q_path, index=False)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"✓ Saved quantile predictions to {out_q_path}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  Schema: {list(q_df.columns)}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Merge quantile predictions into detailed predictions dataframe (Priority 1: Standardized Schema)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    try:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if 'results_df_base' in globals() and results_df_base is not None:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Add quantile columns to detailed predictions\\\\n\\\",\\n\",\n",
    "    \"    \\\"            results_df_detailed = results_df_base.copy()\\\\n\\\",\\n\",\n",
    "    \"    \\\"            results_df_detailed['pred_p10'] = predictions_quantile_monotonic.get(0.1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            results_df_detailed['pred_p50'] = predictions_quantile_monotonic.get(0.5)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            results_df_detailed['pred_p90'] = predictions_quantile_monotonic.get(0.9)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            results_df_detailed['interval_width'] = results_df_detailed['pred_p90'] - results_df_detailed['pred_p10']\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Export unified predictions with standardized schema\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Required columns: ticker, isin, sector, region, last_price, y_true, y_pred,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            #                   y_pred_calibrated, pred_p10, pred_p50, pred_p90, interval_width,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            #                   abs_error, pct_error, model_version, snapshot_date\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Phase 9.5: Validate schema invariants (non-negativity, monotonicity, required columns)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            from finance_ml.ml_workflow.regression.io import validate_predictions_schema\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            try:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                validate_predictions_schema(results_df_detailed)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(\\\\\\\"✓ Predictions schema validated successfully\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            except ValueError as e:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(f\\\\\\\"⚠ Schema validation warning: {e}\\\\\\\")\\\\n\\\",\\n\",\n",
