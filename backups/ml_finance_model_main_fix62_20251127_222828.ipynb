    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Extract classification and valuation columns\\\\n\\\",\\n\",\n",
    "    \"    \\\"classification_cols = [c for c in all_stocks_with_classification.columns if c.startswith('event_prob_')]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
