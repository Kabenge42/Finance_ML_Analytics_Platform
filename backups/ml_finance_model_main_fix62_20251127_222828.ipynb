    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"## Phase 9.1: Loading and Preprocessing with 6-Step Imputation Strategy Financial Data\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Business Goal\\\\n\\\",\\n\",\n",
    "    \"    \\\"Load multi-region equity data and apply comprehensive preprocessing to ensure high-quality inputs for downstream modeling.\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Key Objectives\\\\n\\\",\\n\",\n",
    "    \"    \\\"1. Load data from PostgreSQL/SQLite or CSV fallback\\\\n\\\",\\n\",\n",
    "    \"    \\\"2. Apply 6-step imputation strategy (zero-fill, KNN, price-based, median)\\\\n\\\",\\n\",\n",
    "    \"    \\\"3. Detect and handle outliers (IQR, z-score, isolation forest)\\\\n\\\",\\n\",\n",
    "    \"    \\\"4. Apply sector-wise winsorization\\\\n\\\",\\n\",\n",
    "    \"    \\\"5. Validate data quality and completeness\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Inputs\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Raw data: CSV files or database tables (US, EU, APAC, ROTW regions)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Outputs\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `all_stocks_preprocessed`: Fully preprocessed DataFrame\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `outputs/preprocessing/`: Data quality reports, imputation stats\\\\n\\\",\\n\",\n",
    "    \"    \\\"- `outputs/catalog/`: Data catalog metadata\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### v1.2 Standards Applied\\\\n\\\",\\n\",\n",
    "    \"    \\\"- ✅ 6-step imputation strategy\\\\n\\\",\\n\",\n",
    "    \"    \\\"- ✅ Outlier safety rails (winsorization at [1st, 99th] percentiles)\\\\n\\\",\\n\",\n",
    "    \"    \\\"- ✅ Data quality validation\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### v1.3 Standards Applied (NEW)\\\\n\\\",\\n\",\n",
    "    \"    \\\"- ✅ Schema-aware datatype detection and casting (`COLUMN_SCHEMA`)\\\\n\\\",\\n\",\n",
    "    \"    \\\"- ✅ Phase 9.3 feature input categorization (`PHASE93_FEATURE_INPUTS`)\\\\n\\\",\\n\",\n",
    "    \"    \\\"- ✅ Comprehensive dtype diagnostics (coercion tracking, unknown columns)\\\\n\\\",\\n\",\n",
    "    \"    \\\"- ✅ Metadata catalog with dtypes and missing counts\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Validation Checkpoint\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Zero missing values after imputation\\\\n\\\",\\n\",\n",
    "    \"    \\\"- Outliers capped within acceptable ranges\\\\n\\\",\\n\",\n",
    "    \"    \\\"- All required columns present\\\\n\\\",\\n\",\n",
    "    \"    \\\"- All columns cast to schema-compliant dtypes\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"Sophisticated preprocessing pipeline with:\\\\n\\\",\\n\",\n",
    "    \"    \\\"1. **Data Loading**: Multi-region data from PostgreSQL or CSV\\\\n\\\",\\n\",\n",
    "    \"    \\\"2. **Schema-Aware Dtype Detection** (v1.3 NEW): Cast columns to canonical dtypes with diagnostics\\\\n\\\",\\n\",\n",
    "    \"    \\\"3. **Outlier Detection**: IQR, Z-score, and Isolation Forest methods\\\\n\\\",\\n\",\n",
    "    \"    \\\"4. **Sector-Specific Winsorization**: Limit extreme values by sector\\\\n\\\",\\n\",\n",
    "    \"    \\\"5. **Data Quality Scoring**: Comprehensive quality metrics\\\\n\\\",\\n\",\n",
    "    \"    \\\"6. **6-Step Imputation Strategy** (Phase 9.1 Enhanced):\\\\n\\\",\\n\",\n",
    "    \"    \\\"   - **Step 1**: Zero imputation for exceptional event columns (48 cols)\\\\n\\\",\\n\",\n",
    "    \"    \\\"   - **Step 2**: KNN imputation (sector-aware) for financial metrics (148 cols)\\\\n\\\",\\n\",\n",
    "    \"    \\\"   - **Step 3**: Price-based imputation for price target columns (5 cols)\\\\n\\\",\\n\",\n",
    "    \"    \\\"   - **Step 4**: Median imputation for remaining numeric columns\\\\n\\\",\\n\",\n",
    "    \"    \\\"   - **Step 5**: Categorical imputation for string/object columns\\\\n\\\",\\n\",\n",
    "    \"    \\\"   - **Step 6**: Datetime imputation and formatting for temporal features\\\\n\\\",\\n\",\n",
    "    \"    \\\"7. **Imputation Validation**: Comprehensive validation ensuring zero missing values\\\\n\\\",\\n\",\n",
    "    \"    \\\"8. **Feature Scaling**: Robust scaling by sector\\\\n\\\"\\n\",\n",
