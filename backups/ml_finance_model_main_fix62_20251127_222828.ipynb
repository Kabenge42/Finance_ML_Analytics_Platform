    "    \"    \\\"                cap_unit = ''  # No unit for normalized data\\\\n\\\",\\n\",\n",
    "    \"    \\\"                display_scale = 1.0\\\\n\\\",\\n\",\n",
    "    \"    \\\"                display_unit = '(normalized/scaled)'\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(f'    ⚠️  Market cap is NORMALIZED/SCALED (NOT raw values)')\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(f'    Range: {mc_min:.3f} to {mc_max:.3f}')\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(f'    Median: {mc_p50:.3f}, Mean: {mc.mean():.3f}')\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(f'    25th-75th percentile: [{mc_p25:.3f}, {mc.quantile(0.75):.3f}]')\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(f'    📌 Recommendation: Use raw market_cap values from original data')\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(f'       (scaled data loses business interpretability per Section 8.5)')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            elif mc_p50 < 1e6:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                # Millions scale (most common for mid/small cap stocks)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                is_normalized = False\\\\n\\\",\\n\",\n",
    "    \"    \\\"                min_mc_threshold = 500.0  # $500M minimum\\\\n\\\",\\n\",\n",
    "    \"    \\\"                cap_unit = 'M'\\\\n\\\",\\n\",\n",
    "    \"    \\\"                display_scale = 1.0  # Already in millions\\\\n\\\",\\n\",\n",
    "    \"    \\\"                display_unit = 'M'\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
