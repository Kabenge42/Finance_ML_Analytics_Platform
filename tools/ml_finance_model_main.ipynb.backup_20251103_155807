    "    \"\"\"Determine best available metric for sorting sector results.\"\"\"\n",
    "    for metric in ['r2', 'train_score', 'mae']:\n",
    "        if metric in df.columns:\n",
    "            return metric\n",
    "    print(f\"\\n⚠ Warning: None of the expected metric columns found.\")\n",
    "    print(f\"   Available columns: {df.columns.tolist()}\")\n",
    "    return 'none'\n",
    "\n",
    "\n",
    "def format_sector_summary(results: dict) -> pd.DataFrame:\n",
    "    \"\"\"Format sector model results as dataframe.\"\"\"\n",
    "    sector_metrics = results.get('sector_metrics', results)\n",
    "    return pd.DataFrame(sector_metrics).T\n",
    "\n",
    "\n",
    "def print_sector_summary(sector_summary: pd.DataFrame, sort_metric: str) -> None:\n",
    "    \"\"\"Print formatted sector model summary.\"\"\"\n",
    "    display_cols = [c for c in ['train_score', 'r2', 'mae', 'rmse', 'cv_mean', 'model_type']\n",
    "                    if c in sector_summary.columns]\n",
    "\n",
    "    if not sector_summary.empty and display_cols:\n",
    "        print(sector_summary[display_cols].head(10).to_string())\n",
    "    elif not sector_summary.empty:\n",
    "        print(sector_summary.head(10).to_string())\n",
    "    else:\n",
    "        print(\"   No sector models trained (insufficient samples per sector)\")\n",
    "\n",
    "\n",
    "def train_sector_models(df: pd.DataFrame, X_train, target_col: str, min_samples: int) -> None:\n",
    "    \"\"\"Train sector-specific models if sector column exists.\"\"\"\n",
    "    print_section_header(\"9.5.6 — Sector-Specific Model Training\")\n",
    "\n",
    "    if 'sector' not in df.columns:\n",
    "        print(\"\\n⚠ Sector column not found - skipping sector-specific models\")\n",
    "        return\n",
    "\n",
    "    feature_cols = list(X_train.columns)\n",
    "    models, results = train_sector_specific_models(\n",
    "            df,\n",
    "            feature_cols=feature_cols,\n",
    "            target_col=target_col,\n",
    "            sector_col='sector',\n",
    "            model_type='random_forest',\n",
    "            min_samples=min_samples\n",
    "            )\n",
    "\n",
    "    print(f\"\\n✓ Sector-Specific Models Trained:\")\n",
    "    print(f\"  Total sectors: {len(models)}\")\n",
    "\n",
    "    sector_summary = format_sector_summary(results)\n",
    "    sort_metric = determine_sort_metric(sector_summary)\n",
    "\n",
    "    if sort_metric != 'none':\n",
    "        ascending = (sort_metric == 'mae')\n",
    "        sector_summary = sector_summary.sort_values(sort_metric, ascending=ascending)\n",
    "\n",
    "    print(f\"\\n📊 Sector Model Performance (sorted by {sort_metric}):\")\n",
    "    print_sector_summary(sector_summary, sort_metric)\n",
    "\n",
    "\n",
    "def create_model_metadata(model_type: str, features: list, target_col: str,\n",
    "                          phase: str = '9.5', **kwargs) -> dict:\n",
    "    \"\"\"Create metadata dictionary for model persistence.\"\"\"\n",
    "    from datetime import datetime\n",
    "\n",
    "    metadata = {\n",
    "        'model_type': model_type,\n",
    "        'features': features,\n",
    "        'target': target_col,\n",
    "        'date_trained': datetime.now().strftime('%Y-%m-%d'),\n",
    "        'phase': phase\n",
    "        }\n",
    "    metadata.update(kwargs)\n",
    "    return metadata\n",
    "\n",
    "\n",
    "def save_stacking_model(model, models_dir, X_train, target_col: str,\n",
    "                        stacking_results: dict, test_r2: float) -> None:\n",
    "    \"\"\"Save stacking ensemble model with metadata.\"\"\"\n",
    "    metadata = create_model_metadata(\n",
    "            model_type='stacking_ensemble',\n",
    "            features=list(X_train.columns),\n",
    "            target_col=target_col,\n",
    "            train_score=stacking_results['train_score'],\n",
    "            cv_score=stacking_results['cv_score'],\n",
    "            test_score=test_r2\n",
    "            )\n",
    "\n",
    "    stacking_path = models_dir / 'stacking_ensemble_phase95.joblib'\n",
    "    save_model(model, str(stacking_path), metadata=metadata)\n",
    "    print(f\"\\n✓ Stacking model saved: {stacking_path}\")\n",
    "\n",
    "\n",
    "def save_quantile_models_batch(quantile_models: list, quantiles: list, models_dir,\n",
    "                               X_train, target_col: str) -> None:\n",
    "    \"\"\"Save all quantile models with metadata.\"\"\"\n",
    "    for q, model in zip(quantiles, quantile_models):\n",
    "        metadata = create_model_metadata(\n",
    "                model_type=f'quantile_regressor_q{q}',\n",
    "                features=list(X_train.columns),\n",
    "                target_col=target_col,\n",
    "                quantile=q\n",
    "                )\n",
    "\n",
    "        quantile_path = models_dir / f'quantile_q{int(q * 100)}_phase95.joblib'\n",
    "        save_model(model, str(quantile_path), metadata=metadata)\n",
    "\n",
    "    print(f\"✓ Quantile models saved: {len(quantiles)} models\")\n",
    "\n",
    "\n",
    "def save_models_to_disk(stacking_model, quantile_models, quantiles: list, X_train,\n",
    "                        target_col: str, test_r2: float, stacking_results: dict) -> None:\n",
    "    \"\"\"Save trained models with metadata.\"\"\"\n",
    "    print_section_header(\"9.5.7 — Model Persistence\")\n",
    "\n",
    "    from pathlib import Path\n",
    "    models_dir = Path(config.output_dir) / 'models'\n",
    "    models_dir.mkdir(exist_ok=True, parents=True)\n",
    "\n",
    "    save_stacking_model(stacking_model, models_dir, X_train, target_col, stacking_results, test_r2)\n",
    "    save_quantile_models_batch(quantile_models, quantiles, models_dir, X_train, target_col)\n",
    "\n",
    "\n",
    "def format_best_model_description(best_model_name: str, results_df: pd.DataFrame) -> str:\n",
    "    \"\"\"Format description of best model.\"\"\"\n",
    "    if best_model_name not in [\"None\", \"N/A\"] and not results_df.empty:\n",
    "        return f\"{best_model_name} (R²={results_df.loc[best_model_name, 'r2']:.4f})\"\n",
    "    return \"Not available (comparison failed)\"\n",
    "\n",
    "\n",
    "def print_phase_summary(best_model_name: str, results_df: pd.DataFrame, test_r2: float,\n",
    "                        test_mae: float, classification_cols: list, quantiles: list,\n",
    "                        models_dir) -> None:\n",
    "    \"\"\"Print comprehensive phase summary.\"\"\"\n",
    "    print_section_header(\"PHASE 9.5 IMPLEMENTATION SUMMARY\")\n",
    "\n",
    "    best_model_summary = format_best_model_description(best_model_name, results_df)\n",
    "\n",
    "    summary = {\n",
    "        \"✓ Classification Features Integrated\": f\"{len(classification_cols)} probability features + interactions\",\n",
    "        \"✓ Models Compared\": \"6 models: Ridge, Lasso, RF, ET, GB, HistGB\",\n",
    "        \"✓ Best Single Model\": best_model_summary,\n",
    "        \"✓ Stacking Ensemble\": f\"R²={test_r2:.4f}, MAE={test_mae:.2f}\",\n",
    "        \"✓ Quantile Regression\": f\"{len(quantiles)} quantiles for prediction intervals\",\n",
    "        \"✓ Models Saved\": f\"{models_dir} (stacking + quantile models)\"\n",
    "        }\n",
    "\n",
    "    for key, value in summary.items():\n",
    "        print(f\"\\n{key}\")\n",
    "        print(f\"  {value}\")\n",
    "\n",
    "    print(f\"\\n{SEPARATOR_LINE}\")\n",
    "    print(\"✓ Phase 9.5 Complete - Advanced Regression System Operational\")\n",
    "    print(SEPARATOR_LINE)\n",
    "\n",
    "\n",
    "def add_predictions_to_dataset(df: pd.DataFrame, indices, y_pred, predictions_quantile: dict) -> None:\n",
    "    \"\"\"Add predictions to dataset at specified indices.\"\"\"\n",
    "    df.loc[indices, 'predicted_price_target'] = y_pred\n",
    "    df.loc[indices, 'prediction_lower_10'] = predictions_quantile[0.1]\n",
    "    df.loc[indices, 'prediction_upper_90'] = predictions_quantile[0.9]\n",
    "\n",
    "\n",
    "def store_predictions(all_stocks_featured, regression_df_enhanced, X_test, y_pred,\n",
    "                      predictions_quantile: dict) -> pd.DataFrame:\n",
    "    \"\"\"Store predictions in dataset for downstream use.\"\"\"\n",
    "    if len(X_test) == 0:\n",
    "        print(f\"\\n⚠ No test samples available for prediction storage\")\n",
    "        return regression_df_enhanced.copy()\n",
    "\n",
    "    test_indices = X_test.index\n",
    "    add_predictions_to_dataset(all_stocks_featured, test_indices, y_pred, predictions_quantile)\n",
    "\n",
    "    print(f\"\\n✓ Predictions added to dataset (stored in 'all_stocks_featured')\")\n",
    "    print(f\"  Predictions added for {len(test_indices)} samples\")\n",
    "\n",
    "    all_stocks_phase95 = regression_df_enhanced.copy()\n",
    "    add_predictions_to_dataset(all_stocks_phase95, test_indices, y_pred, predictions_quantile)\n",
    "\n",
    "    return all_stocks_phase95\n",
    "\n",
    "\n",
    "# Main execution\n",
    "print_phase_header(PHASE_NAME)\n",
    "try:\n",
    "    regression_df = initialize_regression_dataset(all_stocks_phase94)\n",
    "    regression_df_clean, target_col = prepare_target_variable(\n",
    "            regression_df, TARGET_COL_DEFAULT, TARGET_COL_FALLBACK\n",
    "            )\n",
    "\n",
    "    #%% md\n",
    "    ### 9.5.1 Create Classification Interaction Features\n",
    "    #%%\n",
    "    regression_df_enhanced = create_interaction_features(regression_df_clean)\n",
    "    regression_df_enhanced = handle_missing_values(regression_df_enhanced, target_col)\n",
    "    classification_cols = extract_classification_columns(regression_df_clean)\n",
    "\n",
    "    #%% md\n",
    "    ### 9.5.2 Prepare Regression Data\n",
    "    #%%\n",
    "    X_train_reg, X_test_reg, y_train_reg, y_test_reg, feature_info = prepare_train_test_data(\n",
    "            regression_df_enhanced, target_col, TEST_SIZE_RATIO, RANDOM_STATE\n",
    "            )\n",
    "\n",
    "    #%% md\n",
    "    ### 9.5.3 Compare Multiple Regression Models\n",
    "    #%%\n",
    "    results_df = compare_regression_models(X_train_reg, y_train_reg, CV_FOLDS, RANDOM_STATE)\n",
    "    best_model_name = visualize_model_comparison(results_df)\n",
    "\n",
    "    #%% md\n",
    "    ### 9.5.4 Train Stacking Ensemble for Best Performance\n",
    "    #%%\n",
    "    stacking_model, y_pred_stacking, test_metrics = train_stacking_ensemble_model(\n",
    "            X_train_reg, y_train_reg, X_test_reg, y_test_reg, CV_FOLDS\n",
    "            )\n",
    "\n",
    "    #%% md\n",
    "    ### 9.5.5 Quantile Regression for Prediction Intervals\n",
    "    #%%\n",
    "    quantile_models, predictions_quantile = train_quantile_models(\n",
    "            X_train_reg, y_train_reg, X_test_reg, QUANTILES\n",
    "            )\n",
    "    predictions_with_intervals = visualize_prediction_intervals(\n",
    "            y_test_reg, predictions_quantile, y_pred_stacking, SAMPLE_SIZE_VISUALIZATION\n",
    "            )\n",
    "\n",
    "    #%% md\n",
    "    ### 9.5.6 Sector-Specific Models (Optional)\n",
    "    #%%\n",
    "    train_sector_models(regression_df_enhanced, X_train_reg, target_col, MIN_SECTOR_SAMPLES)\n",
    "\n",
    "    #%% md\n",
    "    ### 9.5.7 Model Persistence\n",
    "    #%%\n",
    "    # Create stacking_results dictionary with train, cv, and test scores\n",
    "    from sklearn.metrics import r2_score\n",
    "    from sklearn.model_selection import cross_val_score\n",
    "    \n",
    "    # Compute training score\n",
    "    y_train_pred_stacking = stacking_model.predict(X_train_reg)\n",
    "    train_r2 = r2_score(y_train_reg, y_train_pred_stacking)\n",
    "    \n",
    "    # Compute cross-validation score\n",
    "    cv_scores = cross_val_score(stacking_model, X_train_reg, y_train_reg, cv=CV_FOLDS, scoring='r2')\n",
    "    cv_r2 = cv_scores.mean()\n",
    "    \n",
    "    stacking_results = {\n",
    "        'train_score': train_r2,\n",
    "        'cv_score': cv_r2,\n",
    "        'test_score': test_metrics['r2'],\n",
    "        'model': stacking_model\n",
    "    }\n",
    "    \n",
    "    save_models_to_disk(\n",
    "            stacking_model, quantile_models, QUANTILES, X_train_reg,\n",
    "            target_col, test_metrics['r2'], stacking_results\n",
    "            )\n",
    "\n",
    "    #%% md\n",
    "    ### 9.5.8 Summary of Phase 9.5 Implementation\n",
    "    #%%\n",
    "    models_dir = Path(config.output_dir) / 'models'\n",
    "    print_phase_summary(\n",
    "            best_model_name, results_df, test_metrics['r2'], test_metrics['mae'],\n",
    "            classification_cols, QUANTILES, models_dir\n",
    "            )\n",
    "    all_stocks_phase95 = store_predictions(\n",
