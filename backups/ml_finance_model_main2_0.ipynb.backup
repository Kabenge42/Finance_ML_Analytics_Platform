   "cell_type": "code",
   "source": [
    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "# ========== CONFIGURATION CONSTANTS ==========\n",
    "# Section 8.1: Single Source of Truth - All constants defined once\n",
    "\n",
    "# Target and fallback (Section 2.2)\n",
    "TARGET_COL = 'price_target'  # Canonical target (code_guidelines.md Section 2.2)\n",
    "TARGET_COL_FALLBACK = 'last_price'  # Canonical fallback target\n",
    "\n",
    "# Data splits\n",
    "TEST_SIZE = 0.2\n",
    "TRAIN_SIZE = 1 - TEST_SIZE\n",
    "CV_FOLDS = 5\n",
    "\n",
    "# Quantile regression (code_guidelines.md Section 14.1: 80% prediction interval)\n",
    "QUANTILES = [0.1, 0.5, 0.9]\n",
    "LOWER_QUANTILE = QUANTILES[0]\n",
    "MEDIAN_QUANTILE = QUANTILES[1]\n",
    "UPPER_QUANTILE = QUANTILES[2]\n",
    "\n",
    "# Sector constraints\n",
    "MIN_SECTOR_SAMPLES = 20\n",
    "\n",
    "# Portfolio constraints\n",
    "MAX_SECTOR_WEIGHT = 0.25\n",
    "MAX_SINGLE_POSITION = 0.10\n",
    "\n",
    "# Outlier thresholds\n",
    "IQR_MULTIPLIER = 2.5\n",
    "ZSCORE_THRESHOLD = 3.0\n",
    "WINSORIZE_LOWER = 0.01\n",
    "WINSORIZE_UPPER = 0.99\n",
    "\n",
    "# Confidence scoring\n",
    "CONFIDENCE_LOW_THRESHOLD = 0.50\n",
    "CONFIDENCE_MEDIUM_THRESHOLD = 0.75\n",
    "\n",
    "# Random seed\n",
    "RANDOM_SEED = int(os.getenv('RANDOM_SEED', '42'))\n",
    "np.random.seed(RANDOM_SEED)\n",
    "MODEL_VERSION = os.getenv('MODEL_VERSION', 'v9_9')\n",
    "\n",
    "# Directory configuration (code_guidelines.md Section 8.1)\n",
    "OUTPUT_DIR = Path(\"outputs\")\n",
    "DATA_DIR = Path(\"data\")\n",
    "MODEL_DIR = OUTPUT_DIR / \"regression\"\n",
    "CACHE_DIR = Path(\".cache\")\n",
    "\n",
    "# Create directories if they don't exist\n",
    "for _dir in [OUTPUT_DIR, DATA_DIR, MODEL_DIR, CACHE_DIR]:\n",
    "    _dir.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Database configuration (optional)\n",
    "DB_URL = os.getenv(\"DB_URL\", \"postgresql+psycopg2://postgres:@localhost:5432/postgres\")\n",
    "\n",
    "\n",
    "def validate_configuration():\n",
    "    \"\"\"\n",
    "    Validate notebook configuration constants.\n",
    "    \n",
    "    Ensures all configuration values are properly defined and within valid ranges.\n",
    "    This provides a single source of truth validation for all configuration.\n",
    "    \n",
    "    Returns:\n",
    "        bool: True if all validations pass\n",
    "    \n",
    "    Raises:\n",
    "        ValueError: If any configuration value is invalid\n",
    "    \"\"\"\n",
    "    # Validate target columns\n",
    "    if not TARGET_COL or not isinstance(TARGET_COL, str):\n",
    "        raise ValueError(f\"TARGET_COL must be a non-empty string, got: {TARGET_COL}\")\n",
    "    if not TARGET_COL_FALLBACK or not isinstance(TARGET_COL_FALLBACK, str):\n",
    "        raise ValueError(f\"TARGET_COL_FALLBACK must be a non-empty string, got: {TARGET_COL_FALLBACK}\")\n",
    "\n",
    "    # Validate test size\n",
    "    if not (0 < TEST_SIZE < 1):\n",
    "        raise ValueError(f\"TEST_SIZE must be between 0 and 1, got: {TEST_SIZE}\")\n",
    "    if not (0 < TRAIN_SIZE < 1):\n",
    "        raise ValueError(f\"TRAIN_SIZE must be between 0 and 1, got: {TRAIN_SIZE}\")\n",
    "\n",
    "    # Validate CV folds\n",
    "    if not isinstance(CV_FOLDS, int) or CV_FOLDS < 2:\n",
    "        raise ValueError(f\"CV_FOLDS must be an integer >= 2, got: {CV_FOLDS}\")\n",
    "\n",
    "    # Validate quantiles\n",
    "    if not QUANTILES or not isinstance(QUANTILES, list):\n",
    "        raise ValueError(f\"QUANTILES must be a non-empty list, got: {QUANTILES}\")\n",
    "    for q in QUANTILES:\n",
    "        if not (0 < q < 1):\n",
    "            raise ValueError(f\"All quantiles must be between 0 and 1, got: {q}\")\n",
    "    if len(QUANTILES) != len(set(QUANTILES)):\n",
    "        raise ValueError(f\"QUANTILES must contain unique values, got: {QUANTILES}\")\n",
    "\n",
    "    # Validate minimum sector samples\n",
    "    if not isinstance(MIN_SECTOR_SAMPLES, int) or MIN_SECTOR_SAMPLES < 1:\n",
    "        raise ValueError(f\"MIN_SECTOR_SAMPLES must be an integer >= 1, got: {MIN_SECTOR_SAMPLES}\")\n",
    "\n",
    "    # Validate portfolio constraints\n",
    "    if not (0 < MAX_SECTOR_WEIGHT <= 1):\n",
    "        raise ValueError(f\"MAX_SECTOR_WEIGHT must be between 0 and 1, got: {MAX_SECTOR_WEIGHT}\")\n",
    "    if not (0 < MAX_SINGLE_POSITION <= 1):\n",
    "        raise ValueError(f\"MAX_SINGLE_POSITION must be between 0 and 1, got: {MAX_SINGLE_POSITION}\")\n",
    "\n",
    "    # Validate outlier thresholds\n",
    "    if IQR_MULTIPLIER <= 0:\n",
    "        raise ValueError(f\"IQR_MULTIPLIER must be positive, got: {IQR_MULTIPLIER}\")\n",
    "    if ZSCORE_THRESHOLD <= 0:\n",
    "        raise ValueError(f\"ZSCORE_THRESHOLD must be positive, got: {ZSCORE_THRESHOLD}\")\n",
    "    if not (0 <= WINSORIZE_LOWER < WINSORIZE_UPPER <= 1):\n",
    "        raise ValueError(f\"Invalid winsorization bounds: [{WINSORIZE_LOWER}, {WINSORIZE_UPPER}]\")\n",
    "\n",
    "    # Validate directory configuration\n",
    "    if not isinstance(OUTPUT_DIR, Path):\n",
    "        raise ValueError(f\"OUTPUT_DIR must be a Path object, got: {type(OUTPUT_DIR)}\")\n",
    "    if not isinstance(DATA_DIR, Path):\n",
    "        raise ValueError(f\"DATA_DIR must be a Path object, got: {type(DATA_DIR)}\")\n",
    "    if not isinstance(MODEL_DIR, Path):\n",
    "        raise ValueError(f\"MODEL_DIR must be a Path object, got: {type(MODEL_DIR)}\")\n",
    "    if not isinstance(CACHE_DIR, Path):\n",
    "        raise ValueError(f\"CACHE_DIR must be a Path object, got: {type(CACHE_DIR)}\")\n",
    "\n",
    "    # Verify directories exist (they should have been created above)\n",
    "    for dir_name, dir_path in [(\"OUTPUT_DIR\", OUTPUT_DIR), (\"DATA_DIR\", DATA_DIR),\n",
    "                               (\"MODEL_DIR\", MODEL_DIR), (\"CACHE_DIR\", CACHE_DIR)]:\n",
    "        if not dir_path.exists():\n",
    "            raise ValueError(f\"{dir_name} directory does not exist: {dir_path}\")\n",
    "\n",
    "    return True\n",
    "\n",
    "\n",
    "def validate_price_preservation(df_before, df_after, price_cols=None, stage_name=\"\"):\n",
    "    \"\"\"\n",
    "    Validate that price columns were not modified during preprocessing.\n",
    "    \n",
    "    Per code_guidelines.md Section 8.5.2: Price columns must NEVER be winsorized,\n",
    "    scaled, or transformed. The core business metric (Predicted_Target - Last_Price) / Last_Price\n",
    "    requires original price scale.\n",
    "    \n",
    "    Args:\n",
    "        df_before: DataFrame before transformation\n",
    "        df_after: DataFrame after transformation\n",
    "        price_cols: List of price columns to check (defaults to PRICE_COLUMNS from column_semantics)\n",
    "        stage_name: Name of the preprocessing stage for error messages\n",
    "        \n",
    "    Returns:\n",
    "        bool: True if all price columns preserved\n",
    "        \n",
    "    Raises:\n",
    "        ValueError: If any price column was modified\n",
    "    \"\"\"\n",
    "    from finance_ml.ml_workflow.preprocessing.column_semantics import PRICE_COLUMNS\n",
    "\n",
    "    if price_cols is None:\n",
    "        price_cols = PRICE_COLUMNS\n",
    "\n",
    "    violations = []\n",
    "    cols_checked = 0\n",
    "\n",
    "    for col in price_cols:\n",
    "        if col in df_before.columns and col in df_after.columns:\n",
    "            cols_checked += 1\n",
    "            # Handle index alignment (some rows may be dropped)\n",
    "            common_idx = df_after.index.intersection(df_before.index)\n",
    "            if len(common_idx) > 0:\n",
    "                before_vals = df_before.loc[common_idx, col]\n",
    "                after_vals = df_after.loc[common_idx, col]\n",
    "\n",
    "                # Check for exact equality (NaN-aware)\n",
    "                if not before_vals.equals(after_vals):\n",
    "                    before_mean = before_vals.mean()\n",
    "                    after_mean = after_vals.mean()\n",
    "                    violations.append(\n",
    "                            f\"{col}: mean changed from {before_mean:.2f} to {after_mean:.2f}\"\n",
    "                            )\n",
    "\n",
    "    if violations:\n",
    "        stage_info = f\" in {stage_name}\" if stage_name else \"\"\n",
    "        raise ValueError(\n",
    "                f\"CRITICAL: Price columns were modified{stage_info}, violating business metric integrity!\\n\"\n",
    "                f\"Violations:\\n\" + \"\\n\".join(f\"  - {v}\" for v in violations) +\n",
    "                f\"\\n\\nFix: Ensure scale_features() and winsorize_by_sector() use exclude_price_columns=True.\"\n",
    "                )\n",
    "\n",
    "    return True\n",
    "\n",
    "\n",
    "# Validate configuration on load\n",
    "try:\n",
    "    validate_configuration()\n",
    "    print(\"✓ Configuration validation passed\")\n",
    "    print(f\"  Random seed: {RANDOM_SEED}\")\n",
    "    print(f\"  MODEL_VERSION: {MODEL_VERSION}\")\n",
    "    print(f\"  Train/Test split: {TRAIN_SIZE:.1%}/{TEST_SIZE:.1%}\")\n",
    "    print(f\"  Quantiles: {QUANTILES}\")\n",
    "    print(f\"  OUTPUT_DIR: {OUTPUT_DIR.absolute()}\")\n",
    "    print(f\"  DATA_DIR: {DATA_DIR.absolute()}\")\n",
    "    print(f\"  MODEL_DIR: {MODEL_DIR.absolute()}\")\n",
    "    print(f\"  CACHE_DIR: {CACHE_DIR.absolute()}\")\n",
    "except ValueError as e:\n",
    "    print(f\"✗ Configuration validation failed: {e}\")\n",
    "    raise\n",
    "\n",
    "# ============================================================================\n",
    "# CODE GUIDELINES COMPLIANCE (code_guidelines.md v1.9+)\n",
    "# ============================================================================\n",
    "# This notebook implements best practices from code_guidelines.md:\n",
    "#\n",
    "# Section 2: Column Naming Schema\n",
    "#   - Canonical names: price_target, last_price, sector, region, ticker\n",
    "#   - normalize_columns() applied immediately after ETL\n",
    "#\n",
    "# Section 6.1: Jupyter Notebook Review Checklist\n",
    "#   ✓ Configuration constants defined at top (validate_configuration())\n",
    "#   ✓ ETL pipeline: etl_with_financial_metrics() (Section 8.6)\n",
    "#   ✓ Post-ETL validation: Section 19.1 assertions (lines 672-700)\n",
    "#   ✓ 6-step imputation strategy via ETL\n",
    "#   ✓ Data split strategy documented (Section 9, lines 3405-3425)\n",
    "#   ✓ Standardized predictions schema (Section 10)\n",
    "#\n",
    "# Section 8: Notebook Best Practices\n",
    "#   ✓ Centralized configuration constants (lines 1-206)\n",
    "#   ✓ DataFrame stage naming documented (Section 8.2, lines 728-758)\n",
    "#   ✓ No magic numbers (all thresholds are named constants)\n",
    "#   ✓ ETL pipeline using recommended etl_with_financial_metrics()\n",
    "#\n",
    "# Section 9: Data Split and Leakage Policy\n",
    "#   ✓ Stratified split via prepare_classification_data()\n",
    "#   ✓ Split strategy hierarchy documented (time-series → grouped → stratified)\n",
    "#\n",
    "# Section 19.1: Post-ETL Validation Checkpoints\n",
    "#   ✓ DataFrame non-empty assertion\n",
    "#   ✓ Critical columns presence check (ticker, sector, last_price)\n",
    "#   ✓ Zero missing values after imputation\n",
    "#\n",
    "# Section 10: Standardized Predictions Schema\n",
    "#   ✓ Outputs regression_predictions_detailed.csv with required columns\n",
    "#\n",
    "# Training function contracts:\n",
    "#   - Return standardized dict: {model, metrics, y_pred, y_proba?, artifacts?}\n",
    "#   - Dataset prep returns 5-tuple: (X_train, X_test, y_train, y_test, meta)\n",
    "# ============================================================================\n",
    "print(\"✓ Configuration constants defined and validated\")"
   ],
