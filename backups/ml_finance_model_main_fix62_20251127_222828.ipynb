    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"# Visualization 5: Category-Sector Bubble Chart (Value vs Quality Trade-offs)\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"\\\\\\\\n📊 Category-Sector Bubble Chart:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Create scatter plot comparing two key categories with sector coloring\\\\n\\\",\\n\",\n",
    "    \"    \\\"if 'category_score_matrix' in locals() and not category_score_matrix.empty:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Select two categories for comparison (e.g., Valuation vs Quality)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    categories_list = list(category_score_matrix.columns)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Default to Valuation Ratios (cat 2) vs Quality & Risk (cat 4) if available\\\\n\\\",\\n\",\n",
    "    \"    \\\"    x_category = 'Valuation Ratios' if 'Valuation Ratios' in categories_list else categories_list[0]\\\\n\\\",\\n\",\n",
    "    \"    \\\"    y_category = 'Quality & Risk' if 'Quality & Risk' in categories_list else (\\\\n\\\",\\n\",\n",
    "    \"    \\\"        categories_list[1] if len(categories_list) > 1 else categories_list[0]\\\\n\\\",\\n\",\n",
    "    \"    \\\"    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Prepare data for bubble chart\\\\n\\\",\\n\",\n",
    "    \"    \\\"    bubble_data = pd.DataFrame({\\\\n\\\",\\n\",\n",
    "    \"    \\\"        x_category: category_score_matrix[x_category],\\\\n\\\",\\n\",\n",
    "    \"    \\\"        y_category: category_score_matrix[y_category],\\\\n\\\",\\n\",\n",
    "    \"    \\\"        'sector': all_stocks_scaled['sector'].values,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        'ticker': all_stocks_scaled.get('ticker', range(len(category_score_matrix))),\\\\n\\\",\\n\",\n",
    "    \"    \\\"        'market_cap': all_stocks_imputed.get('market_cap', 100)  # Use raw (unscaled) data for bubble size\\\\n\\\",\\n\",\n",
    "    \"    \\\"        }).dropna()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Create bubble chart\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_bubble = px.scatter(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            bubble_data,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            x=x_category,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            y=y_category,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            color='sector',\\\\n\\\",\\n\",\n",
    "    \"    \\\"            size='market_cap',\\\\n\\\",\\n\",\n",
    "    \"    \\\"            hover_data=['ticker'],\\\\n\\\",\\n\",\n",
    "    \"    \\\"            title=f\\\\\\\"Strategic Positioning: {x_category} vs {y_category} (Phase 9.3)\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"            labels={\\\\n\\\",\\n\",\n",
    "    \"    \\\"                x_category: f\\\\\\\"{x_category} Score (Z)\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"                y_category: f\\\\\\\"{y_category} Score (Z)\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                },\\\\n\\\",\\n\",\n",
    "    \"    \\\"            size_max=30,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            opacity=0.6\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Add quadrant lines\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_bubble.add_hline(y=0, line_dash=\\\\\\\"dash\\\\\\\", line_color=\\\\\\\"gray\\\\\\\", opacity=0.5)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_bubble.add_vline(x=0, line_dash=\\\\\\\"dash\\\\\\\", line_color=\\\\\\\"gray\\\\\\\", opacity=0.5)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Add quadrant labels\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_bubble.add_annotation(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            text=\\\\\\\"High Quality,<br>High Valuation\\\\\\\", x=1.5, y=1.5,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            showarrow=False, font=dict(size=10, color=\\\\\\\"gray\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_bubble.add_annotation(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            text=\\\\\\\"High Quality,<br>Low Valuation\\\\\\\", x=-1.5, y=1.5,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            showarrow=False, font=dict(size=10, color=\\\\\\\"gray\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_bubble.update_layout(height=700)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_bubble.show()\\\\n\\\",\\n\",\n",
    "    \"    \\\"    output_path = eda_output_dir / \\\\\\\"phase93_category_sector_bubble_chart.html\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_bubble.write_html(output_path)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"\\\\\\\\n✓ Category-sector bubble chart complete\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  X-axis: {x_category}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  Y-axis: {y_category}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  Data points: {len(bubble_data)}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  Output: {output_path}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Identify quadrants\\\\n\\\",\\n\",\n",
    "    \"    \\\"    q1 = bubble_data[(bubble_data[x_category] > 0) & (bubble_data[y_category] > 0)]\\\\n\\\",\\n\",\n",
    "    \"    \\\"    q2 = bubble_data[(bubble_data[x_category] < 0) & (bubble_data[y_category] > 0)]\\\\n\\\",\\n\",\n",
    "    \"    \\\"    q3 = bubble_data[(bubble_data[x_category] < 0) & (bubble_data[y_category] < 0)]\\\\n\\\",\\n\",\n",
    "    \"    \\\"    q4 = bubble_data[(bubble_data[x_category] > 0) & (bubble_data[y_category] < 0)]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"\\\\\\\\n  📍 Quadrant Distribution:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"    Q1 (High Val, High Qual): {len(q1)} stocks ({len(q1) / len(bubble_data) * 100:.1f}%)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            f\\\\\\\"    Q2 (Low Val, High Qual): {len(q2)} stocks ({len(q2) / len(bubble_data) * 100:.1f}%) - Value opportunities\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"    Q3 (Low Val, Low Qual): {len(q3)} stocks ({len(q3) / len(bubble_data) * 100:.1f}%)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"    Q4 (High Val, Low Qual): {len(q4)} stocks ({len(q4) / len(bubble_data) * 100:.1f}%) - Risk flags\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(\\\\\\\"  ⚠️ No category score data available for bubble chart\\\\\\\")\\\\n\\\"\\n\",\n",
    "    \"   ],\\n\",\n",
