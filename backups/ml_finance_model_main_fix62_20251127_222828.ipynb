    "    \"    \\\"    # Train base model without constraint\\\\n\\\",\\n\",\n",
    "    \"    \\\"    from sklearn.linear_model import Ridge as SklearnRidge\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    base_model = SklearnRidge(alpha=1.0, random_state=RANDOM_SEED)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    base_model.fit(X_train, y_train)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    base_pred = base_model.predict(X_test)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Train wrapped model with non-negative constraint\\\\n\\\",\\n\",\n",
    "    \"    \\\"    wrapped_model = NonNegativeRegressionWrapper(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            SklearnRidge(alpha=1.0, random_state=RANDOM_SEED)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"    wrapped_model.fit(X_train, y_train)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    wrapped_pred = wrapped_model.predict(X_test)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Compare predictions\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"\\\\\\\\n📊 Prediction Comparison:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  Base Model (unconstrained):\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"    Min: {base_pred.min():.2f}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"    Max: {base_pred.max():.2f}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"    Negative predictions: {(base_pred < 0).sum()} ({(base_pred < 0).sum() / len(base_pred) * 100:.1f}%)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"\\\\\\\\n  Wrapped Model (non-negative):\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"    Min: {wrapped_pred.min():.2f}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"    Max: {wrapped_pred.max():.2f}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            f\\\\\\\"    Negative predictions: {(wrapped_pred < 0).sum()} ({(wrapped_pred < 0).sum() / len(wrapped_pred) * 100:.1f}%)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Validate non-negativity constraint\\\\n\\\",\\n\",\n",
    "    \"    \\\"    assert wrapped_pred.min() >= 0, \\\\\\\"❌ NonNegativeWrapper failed: negative predictions found!\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(\\\\\\\"\\\\\\\\n✅ NonNegativeRegressionWrapper Validation PASSED\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(\\\\\\\"   All predictions are non-negative as expected\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Performance comparison\\\\n\\\",\\n\",\n",
    "    \"    \\\"    base_mae = mean_absolute_error(y_test, base_pred)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    wrapped_mae = mean_absolute_error(y_test, wrapped_pred)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    base_r2 = r2_score(y_test, base_pred)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    wrapped_r2 = r2_score(y_test, wrapped_pred)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"\\\\\\\\n📈 Performance Impact of Non-Negative Constraint:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  Base Model    - MAE: {base_mae:.2f}, R²: {base_r2:.4f}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  Wrapped Model - MAE: {wrapped_mae:.2f}, R²: {wrapped_r2:.4f}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  MAE Difference: {wrapped_mae - base_mae:.2f} ({(wrapped_mae - base_mae) / base_mae * 100:+.1f}%)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"except Exception as e:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"⚠️ NonNegativeWrapper validation failed: {e}\\\\\\\")\\\\n\\\"\\n\",\n",
    "    \"   ],\\n\",\n",
