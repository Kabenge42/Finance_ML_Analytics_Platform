    "    \" \\\"cells\\\": [\\n\",\n",
    "    \"  {\\n\",\n",
    "    \"   \\\"metadata\\\": {\\n\",\n",
    "    \"    \\\"ExecuteTime\\\": {\\n\",\n",
    "    \"     \\\"end_time\\\": \\\"2025-11-27T20:11:24.616528Z\\\",\\n\",\n",
    "    \"     \\\"start_time\\\": \\\"2025-11-27T20:11:24.607870Z\\\"\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"   },\\n\",\n",
    "    \"   \\\"cell_type\\\": \\\"code\\\",\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"import os\\\\n\\\",\\n\",\n",
    "    \"    \\\"import numpy as np\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# ========== CONFIGURATION CONSTANTS ==========\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Section 8.1: Single Source of Truth - All constants defined once\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Target and fallback (Section 2.2)\\\\n\\\",\\n\",\n",
    "    \"    \\\"TARGET_COL = 'price_target'  # Canonical target (code_guidelines.md Section 2.2)\\\\n\\\",\\n\",\n",
    "    \"    \\\"TARGET_COL_FALLBACK = 'last_price'  # Canonical fallback target\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Data splits\\\\n\\\",\\n\",\n",
    "    \"    \\\"TEST_SIZE = 0.2\\\\n\\\",\\n\",\n",
    "    \"    \\\"TRAIN_SIZE = 1 - TEST_SIZE\\\\n\\\",\\n\",\n",
    "    \"    \\\"CV_FOLDS = 5\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Quantile regression (code_guidelines.md Section 14.1: 80% prediction interval)\\\\n\\\",\\n\",\n",
    "    \"    \\\"QUANTILES = [0.1, 0.5, 0.9]\\\\n\\\",\\n\",\n",
    "    \"    \\\"LOWER_QUANTILE = QUANTILES[0]\\\\n\\\",\\n\",\n",
    "    \"    \\\"MEDIAN_QUANTILE = QUANTILES[1]\\\\n\\\",\\n\",\n",
    "    \"    \\\"UPPER_QUANTILE = QUANTILES[2]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Sector constraints\\\\n\\\",\\n\",\n",
    "    \"    \\\"MIN_SECTOR_SAMPLES = 20\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Portfolio constraints\\\\n\\\",\\n\",\n",
    "    \"    \\\"MAX_SECTOR_WEIGHT = 0.25\\\\n\\\",\\n\",\n",
    "    \"    \\\"MAX_SINGLE_POSITION = 0.10\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Outlier thresholds\\\\n\\\",\\n\",\n",
    "    \"    \\\"IQR_MULTIPLIER = 2.5\\\\n\\\",\\n\",\n",
    "    \"    \\\"ZSCORE_THRESHOLD = 3.0\\\\n\\\",\\n\",\n",
    "    \"    \\\"WINSORIZE_LOWER = 0.10\\\\n\\\",\\n\",\n",
    "    \"    \\\"WINSORIZE_UPPER = 0.90\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Confidence scoring\\\\n\\\",\\n\",\n",
    "    \"    \\\"CONFIDENCE_LOW_THRESHOLD = 0.50\\\\n\\\",\\n\",\n",
    "    \"    \\\"CONFIDENCE_MEDIUM_THRESHOLD = 0.75\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Random seed\\\\n\\\",\\n\",\n",
    "    \"    \\\"RANDOM_SEED = int(os.getenv('RANDOM_SEED', '42'))\\\\n\\\",\\n\",\n",
    "    \"    \\\"np.random.seed(RANDOM_SEED)\\\\n\\\",\\n\",\n",
    "    \"    \\\"MODEL_VERSION = os.getenv('MODEL_VERSION', 'v9_9')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"def validate_configuration():\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    Validate notebook configuration constants.\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    Ensures all configuration values are properly defined and within valid ranges.\\\\n\\\",\\n\",\n",
    "    \"    \\\"    This provides a single source of truth validation for all configuration.\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    Returns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        bool: True if all validations pass\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    Raises:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        ValueError: If any configuration value is invalid\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Validate target columns\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if not TARGET_COL or not isinstance(TARGET_COL, str):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        raise ValueError(f\\\\\\\"TARGET_COL must be a non-empty string, got: {TARGET_COL}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if not TARGET_COL_FALLBACK or not isinstance(TARGET_COL_FALLBACK, str):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        raise ValueError(f\\\\\\\"TARGET_COL_FALLBACK must be a non-empty string, got: {TARGET_COL_FALLBACK}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Validate test size\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if not (0 < TEST_SIZE < 1):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        raise ValueError(f\\\\\\\"TEST_SIZE must be between 0 and 1, got: {TEST_SIZE}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if not (0 < TRAIN_SIZE < 1):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        raise ValueError(f\\\\\\\"TRAIN_SIZE must be between 0 and 1, got: {TRAIN_SIZE}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Validate CV folds\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if not isinstance(CV_FOLDS, int) or CV_FOLDS < 2:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        raise ValueError(f\\\\\\\"CV_FOLDS must be an integer >= 2, got: {CV_FOLDS}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Validate quantiles\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if not QUANTILES or not isinstance(QUANTILES, list):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        raise ValueError(f\\\\\\\"QUANTILES must be a non-empty list, got: {QUANTILES}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for q in QUANTILES:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if not (0 < q < 1):\\\\n\\\",\\n\",\n",
    "    \"    \\\"            raise ValueError(f\\\\\\\"All quantiles must be between 0 and 1, got: {q}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if len(QUANTILES) != len(set(QUANTILES)):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        raise ValueError(f\\\\\\\"QUANTILES must contain unique values, got: {QUANTILES}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Validate minimum sector samples\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if not isinstance(MIN_SECTOR_SAMPLES, int) or MIN_SECTOR_SAMPLES < 1:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        raise ValueError(f\\\\\\\"MIN_SECTOR_SAMPLES must be an integer >= 1, got: {MIN_SECTOR_SAMPLES}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Validate portfolio constraints\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if not (0 < MAX_SECTOR_WEIGHT <= 1):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        raise ValueError(f\\\\\\\"MAX_SECTOR_WEIGHT must be between 0 and 1, got: {MAX_SECTOR_WEIGHT}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if not (0 < MAX_SINGLE_POSITION <= 1):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        raise ValueError(f\\\\\\\"MAX_SINGLE_POSITION must be between 0 and 1, got: {MAX_SINGLE_POSITION}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Validate outlier thresholds\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if IQR_MULTIPLIER <= 0:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        raise ValueError(f\\\\\\\"IQR_MULTIPLIER must be positive, got: {IQR_MULTIPLIER}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if ZSCORE_THRESHOLD <= 0:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        raise ValueError(f\\\\\\\"ZSCORE_THRESHOLD must be positive, got: {ZSCORE_THRESHOLD}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if not (0 <= WINSORIZE_LOWER < WINSORIZE_UPPER <= 1):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        raise ValueError(f\\\\\\\"Invalid winsorization bounds: [{WINSORIZE_LOWER}, {WINSORIZE_UPPER}]\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    return True\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"def validate_price_preservation(df_before, df_after, price_cols=None, stage_name=\\\\\\\"\\\\\\\"):\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    Validate that price columns were not modified during preprocessing.\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    Per code_guidelines.md Section 8.5.2: Price columns must NEVER be winsorized,\\\\n\\\",\\n\",\n",
    "    \"    \\\"    scaled, or transformed. The core business metric (Predicted_Target - Last_Price) / Last_Price\\\\n\\\",\\n\",\n",
    "    \"    \\\"    requires original price scale.\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    Args:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        df_before: DataFrame before transformation\\\\n\\\",\\n\",\n",
    "    \"    \\\"        df_after: DataFrame after transformation\\\\n\\\",\\n\",\n",
    "    \"    \\\"        price_cols: List of price columns to check (defaults to PRICE_COLUMNS from column_semantics)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        stage_name: Name of the preprocessing stage for error messages\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"    Returns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        bool: True if all price columns preserved\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"    Raises:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        ValueError: If any price column was modified\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    from finance_ml.ml_workflow.preprocessing.column_semantics import PRICE_COLUMNS\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if price_cols is None:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        price_cols = PRICE_COLUMNS\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    violations = []\\\\n\\\",\\n\",\n",
    "    \"    \\\"    cols_checked = 0\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for col in price_cols:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if col in df_before.columns and col in df_after.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            cols_checked += 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Handle index alignment (some rows may be dropped)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            common_idx = df_after.index.intersection(df_before.index)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if len(common_idx) > 0:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                before_vals = df_before.loc[common_idx, col]\\\\n\\\",\\n\",\n",
    "    \"    \\\"                after_vals = df_after.loc[common_idx, col]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                # Check for exact equality (NaN-aware)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                if not before_vals.equals(after_vals):\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    before_mean = before_vals.mean()\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    after_mean = after_vals.mean()\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    violations.append(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                            f\\\\\\\"{col}: mean changed from {before_mean:.2f} to {after_mean:.2f}\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if violations:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        stage_info = f\\\\\\\" in {stage_name}\\\\\\\" if stage_name else \\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        raise ValueError(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                f\\\\\\\"CRITICAL: Price columns were modified{stage_info}, violating business metric integrity!\\\\\\\\n\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                f\\\\\\\"Violations:\\\\\\\\n\\\\\\\" + \\\\\\\"\\\\\\\\n\\\\\\\".join(f\\\\\\\"  - {v}\\\\\\\" for v in violations) +\\\\n\\\",\\n\",\n",
    "    \"    \\\"                f\\\\\\\"\\\\\\\\n\\\\\\\\nFix: Ensure scale_features() and winsorize_by_sector() use exclude_price_columns=True.\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    return True\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Validate configuration on load\\\\n\\\",\\n\",\n",
    "    \"    \\\"try:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    validate_configuration()\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(\\\\\\\"✓ Configuration validation passed\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  Random seed: {RANDOM_SEED}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  MODEL_VERSION: {MODEL_VERSION}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  Train/Test split: {TRAIN_SIZE:.1%}/{TEST_SIZE:.1%}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"  Quantiles: {QUANTILES}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"except ValueError as e:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"✗ Configuration validation failed: {e}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    raise\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Code Guidelines Compliance: This notebook follows @code_guidelines.md\\\\n\\\",\\n\",\n",
    "    \"    \\\"# - Canonical column names (Section 2): price_target, last_price, sector, region, ticker\\\\n\\\",\\n\",\n",
    "    \"    \\\"# - Normalized schemas via normalize_columns() immediately after loading\\\\n\\\",\\n\",\n",
    "    \"    \\\"# - Schema validation via validate_schema() before processing\\\\n\\\",\\n\",\n",
    "    \"    \\\"# - Training functions return standardized dict: {model, metrics, y_pred, y_proba?, artifacts?}\\\\n\\\",\\n\",\n",
    "    \"    \\\"# - Dataset prep returns 5-tuple: (X_train, X_test, y_train, y_test, meta)\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"✓ Regression configuration constants defined\\\\\\\")\\\"\\n\",\n",
    "    \"   ],\\n\",\n",
    "    \"   \\\"id\\\": \\\"4d7049902757646a\\\",\\n\",\n",
    "    \"   \\\"outputs\\\": [\\n\",\n",
    "    \"    {\\n\",\n",
    "    \"     \\\"name\\\": \\\"stdout\\\",\\n\",\n",
    "    \"     \\\"output_type\\\": \\\"stream\\\",\\n\",\n",
    "    \"     \\\"text\\\": [\\n\",\n",
    "    \"      \\\"✓ Configuration validation passed\\\\n\\\",\\n\",\n",
    "    \"      \\\"  Random seed: 42\\\\n\\\",\\n\",\n",
    "    \"      \\\"  MODEL_VERSION: v9_9\\\\n\\\",\\n\",\n",
    "    \"      \\\"  Train/Test split: 80.0%/20.0%\\\\n\\\",\\n\",\n",
    "    \"      \\\"  Quantiles: [0.1, 0.5, 0.9]\\\\n\\\",\\n\",\n",
    "    \"      \\\"✓ Regression configuration constants defined\\\\n\\\"\\n\",\n",
    "    \"     ]\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"   ],\\n\",\n",
