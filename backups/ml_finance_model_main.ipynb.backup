    "            y=residuals,\n",
    "            mode='markers',\n",
    "            marker=dict(size=6, opacity=0.6, color='purple'),\n",
    "            name='Residuals'\n",
    "            ))\n",
    "\n",
    "    # Zero line\n",
    "    fig.add_hline(y=0, line_dash='dash', line_color='red', annotation_text='Zero Error')\n",
    "\n",
    "    fig.update_layout(\n",
    "            title='Residual Plot - Model Error Analysis',\n",
    "            xaxis_title='Predicted Price Target',\n",
