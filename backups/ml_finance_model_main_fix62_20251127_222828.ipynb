    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"# Visualization 1: Category Heatmaps (Sector × Category)\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"\\\\\\\\n📊 Category Performance Heatmaps:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Compute category scores by averaging z-scores of metrics within each category\\\\n\\\",\\n\",\n",
    "    \"    \\\"from scipy.stats import zscore\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"category_sector_scores = {}\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"for category_name, category_metrics in category_mapping.items():\\\\n\\\",\\n\",\n",
    "    \"    \\\"    available_in_category = [m for m in category_metrics if m in all_stocks_scaled.columns]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if len(available_in_category) == 0:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"  ⚠️ Skipping {category_name}: No available metrics\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        continue\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Compute z-scores for available metrics and average by sector\\\\n\\\",\\n\",\n",
    "    \"    \\\"    category_data = all_stocks_scaled[available_in_category + ['sector']].copy()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Convert to numeric and compute z-scores\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for col in available_in_category:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        category_data[col] = pd.to_numeric(category_data[col], errors='coerce')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Compute z-scores (handle NaNs)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    z_scored_data = category_data[available_in_category].apply(lambda x: zscore(x, nan_policy='omit'))\\\\n\\\",\\n\",\n",
    "    \"    \\\"    category_data['category_score'] = z_scored_data.mean(axis=1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Aggregate by sector\\\\n\\\",\\n\",\n",
    "    \"    \\\"    sector_scores = category_data.groupby('sector')['category_score'].mean().sort_values(ascending=False)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    category_sector_scores[category_name] = sector_scores\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Create heatmap matrix\\\\n\\\",\\n\",\n",
    "    \"    \\\"if category_sector_scores:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    heatmap_df = pd.DataFrame(category_sector_scores).T\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Create interactive heatmap with value annotations\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Following code_guidelines.md Section 17.1: Heatmaps and Conditional Formatting\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_category_heatmap = px.imshow(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            heatmap_df,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            labels=dict(x=\\\\\\\"Sector\\\\\\\", y=\\\\\\\"Category\\\\\\\", color=\\\\\\\"Avg Z-Score\\\\\\\"),\\\\n\\\",\\n\",\n",
    "    \"    \\\"            title=\\\\\\\"Sector Performance Across 11 Feature Categories (Phase 9.3)\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"            color_continuous_scale=\\\\\\\"RdYlGn\\\\\\\",  # Diverging scale for z-scores centered at zero\\\\n\\\",\\n\",\n",
    "    \"    \\\"            aspect=\\\\\\\"auto\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"            text_auto=\\\\\\\".3f\\\\\\\"  # ✅ Display values formatted to 3 decimals (Section 17.1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Enhanced styling per Section 17.1 style guidelines\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_category_heatmap.update_traces(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            textfont=dict(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    size=11,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    color='white',  # High contrast on diverging color scale\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    family='Arial'  # Standard sans-serif font (Section 17.4)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_category_heatmap.update_layout(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            height=600,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            xaxis_tickangle=-45,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            font=dict(size=10, family=\\\\\\\"Arial\\\\\\\"),\\\\n\\\",\\n\",\n",
    "    \"    \\\"            template=\\\\\\\"plotly_dark\\\\\\\"  # ✅ Dark mode compatible theme (Section 17.1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_category_heatmap.show()\\\\n\\\",\\n\",\n",
    "    \"    \\\"    output_path = eda_output_dir / \\\\\\\"phase93_category_sector_heatmap.html\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    fig_category_heatmap.write_html(output_path)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
