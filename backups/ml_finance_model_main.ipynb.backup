    "        \"revenue\", \"revenue_fy\", \"revenue_previous_year\",\n",
    "        \"total_revenues_cagr_5y_fy\",\n",
    "        # Phase 9.3 Revenue Forecasting features (9 features)\n",
    "        \"avg_vs_median_bias\", \"estimate_confidence_flag\", \"growth_surprise_potential\",\n",
