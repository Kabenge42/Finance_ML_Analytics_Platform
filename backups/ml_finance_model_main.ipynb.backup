tate__x__gross_margin', 'sector_Real Estate__x__market_cap', 'sector_Real Estate__x__beta_5y', 'sector_Utilities__x__p_e_ratio', 'sector_Utilities__x__ev_ebitda_ratio', 'sector_Utilities__x__gross_margin', 'sector_Utilities__x__market_cap', 'sector_Utilities__x__beta_5y'] not in index\"\n"
