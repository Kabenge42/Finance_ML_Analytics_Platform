    "            height=600\n",
    "            )\n",
    "    fig.show()\n",
    "\n",
    "    # Residual plot\n",
    "    print('\\n📉 Residual Analysis...')\n",
    "    residuals = y_pred_stacking - y_test\n",
    "\n",
    "    fig = go.Figure()\n",
    "    fig.add_trace(go.Scatter(\n",
