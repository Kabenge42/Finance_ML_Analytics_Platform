    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"### Analysis Coverage\\\\n\\\",\\n\",\n",
    "    \"    \\\"This phase provides comprehensive statistical analysis including:\\\\n\\\",\\n\",\n",
    "    \"    \\\"- **Distribution Analysis**: Histograms, box plots, outlier detection\\\\n\\\",\\n\",\n",
