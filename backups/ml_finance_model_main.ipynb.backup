   "source": "### 6.5 Quantile Regression for Prediction Intervals\n",
   "id": "c8e343452418d4fe"
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-12-07T04:54:13.009175Z",
