    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"# Calculate mispricing scores using Phase 9.7 function\\\\n\\\",\\n\",\n",
    "    \"    \\\"# First, add predicted prices for all stocks\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"\\\\\\\\n\\\\\\\" + \\\\\\\"=\\\\\\\" * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"GENERATING PREDICTIONS FOR ALL STOCKS (Phase 9.7)\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"=\\\\\\\" * 80)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Step 1: Get raw predictions from model\\\\n\\\",\\n\",\n",
    "    \"    \\\"# === FIX START: Align all_stocks_phase95 features with Model features ===\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Same pattern as Section 6.4: ensure features match what the model expects\\\\n\\\",\\n\",\n",
    "    \"    \\\"X_all_stocks_for_prediction = all_stocks_phase95[X_train.columns].copy()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Get model's expected feature names\\\\n\\\",\\n\",\n",
    "    \"    \\\"model_features_all = getattr(stacking_model, \\\\\\\"feature_names_in_\\\\\\\", None)\\\\n\\\",\\n\",\n",
    "    \"    \\\"if model_features_all is None and hasattr(stacking_model, \\\\\\\"estimators_\\\\\\\"):\\\\n\\\",\\n\",\n",
