    "    \"    \\\"eval_output_path = OUTPUT_DIR / \\\\\\\"classification\\\\\\\" / \\\\\\\"evaluation_metrics.json\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"eval_output_path.parent.mkdir(parents=True, exist_ok=True)\\\\n\\\",\\n\",\n",
    "    \"    \\\"import json\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Helper function to convert numpy arrays to lists recursively\\\\n\\\",\\n\",\n",
    "    \"    \\\"def convert_numpy_to_list(obj):\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\"\\\\\\\"Recursively convert numpy arrays to lists for JSON serialization\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    if isinstance(obj, np.ndarray):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        return obj.tolist()\\\\n\\\",\\n\",\n",
    "    \"    \\\"    elif isinstance(obj, dict):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        return {key: convert_numpy_to_list(value) for key, value in obj.items()}\\\\n\\\",\\n\",\n",
    "    \"    \\\"    elif isinstance(obj, (list, tuple)):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        return [convert_numpy_to_list(item) for item in obj]\\\\n\\\",\\n\",\n",
    "    \"    \\\"    elif isinstance(obj, (np.integer, np.floating)):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        return obj.item()\\\\n\\\",\\n\",\n",
    "    \"    \\\"    else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        return obj\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Filter out classification_report and convert numpy arrays\\\\n\\\",\\n\",\n",
    "    \"    \\\"eval_metrics_json = {k: convert_numpy_to_list(v)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                     for k, v in eval_metrics.items()\\\\n\\\",\\n\",\n",
    "    \"    \\\"                     if k != 'classification_report'}\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"with open(eval_output_path, 'w') as f:\\\\n\\\",\\n\",\n",
